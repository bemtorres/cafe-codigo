    <!-- PASO 3: CREAR LA VISTA DEL SALUDO -->
    <article class="rounded-2xl border-2 border-slate-200 overflow-hidden my-6 bg-white shadow-sm">
      <div class="p-5 sm:p-6 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-3">
          <span class="inline-block bg-[#0c4a3f] text-white rounded-lg px-3 py-1 font-black text-xs">
