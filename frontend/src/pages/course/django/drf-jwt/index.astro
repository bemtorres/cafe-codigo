            title="rest_api/urls.py"
            code={`from django.urls import path
from .views import lista_libros, vista_libro

urlpatterns = [
    path('libros/', lista_libros, name='lista_libros'),
    path('libro/<id>', vista_libro, name='vista_libro'),
]`}
