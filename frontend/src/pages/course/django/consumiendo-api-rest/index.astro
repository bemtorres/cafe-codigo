          <CodeBlock
            lang="python"
            title="api/views.py — Endpoint de Rick and Morty"
            code={`import requests
from rest_framework.decorators import api_view
from rest_framework.response import Response

@api_view(["GET"])
def consultar_personaje_rick(request):
    personaje_id = request.query_params.get("id", "1")
    url = f"https://rickandmortyapi.com/api/character/{personaje_id}"

    try:
        res = requests.get(url, timeout=5)
        if res.status_code == 404:
            return Response(
                {"error": f"No existe un personaje con el ID {personaje_id}"},
                status=404
            )
        res.raise_for_status()
        datos = res.json()

        return Response({
            "id": datos.get("id"),
            "nombre": datos.get("name"),
            "estado": datos.get("status"),
            "especie": datos.get("species"),
            "origen": datos.get("origin", {}).get("name"),
            "imagen": datos.get("image"),
        })
    except requests.RequestException:
        return Response(
            {"error": "Error al conectar con Rick and Morty API"},
            status=503
        )`}
