                lang="python"
                title="Compañero B — api/views.py"
                code={`import math
import requests
from rest_framework.decorators import api_view
from rest_framework.response import Response
from .utiles import leer_numero

URL_TRANSFORMACION = "http://192.168.1.30:8000/api/transformar/"


@api_view(["POST"])
def procesar_lote(request):
    try:
        kg = leer_numero(request.data, "kg_uva")
        if not 0 < kg <= 10000:
            raise ValueError("kg_uva debe ser mayor que 0 y hasta 10000")
    except ValueError as error:
        return Response({"error": str(error)}, status=400)

    kg_jugo = kg * 0.70
    kg_residuo = kg * 0.30
    litros_jugo = kg_jugo / 1.0

    try:
        respuesta = requests.post(
            URL_TRANSFORMACION,
            json={"litros_jugo": litros_jugo},
            timeout=5
        )
        respuesta.raise_for_status()
        datos = respuesta.json()
        vino = leer_numero(datos, "litros_vino")
        vinagre = leer_numero(datos, "litros_vinagre")
        merma = leer_numero(datos, "litros_merma_proceso")
        if min(vino, vinagre, merma) < 0:
            raise ValueError("Cantidades negativas")
        if not math.isclose(vino + vinagre + merma, litros_jugo):
            raise ValueError("El volumen recibido no coincide")
    except (requests.RequestException, ValueError):
        return Response(
            {"error": "C no respondió con un resultado válido"},
            status=502
        )

    # Se redondea solo para corregir ruido de coma flotante.
    copas = math.floor(round(vino / 0.150, 9))
    sobrante = max(0.0, vino - copas * 0.150)

    return Response({
        "kg_uva": kg,
        "kg_jugo_extraido": round(kg_jugo, 3),
        "kg_residuo_extraccion": round(kg_residuo, 3),
        "litros_jugo": round(litros_jugo, 3),
        "litros_vino": round(vino, 3),
        "litros_vinagre": round(vinagre, 3),
        "litros_merma_proceso": round(merma, 3),
        "ml_por_copa": 150,
        "copas_completas": copas,
        "litros_vino_sobrante": round(sobrante, 3)
    })`}
              />
