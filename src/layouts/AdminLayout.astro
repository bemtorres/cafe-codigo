---
import "../styles/global.css";
import logoCafeycodigo from "../assets/images/cafeycodigo.png";

interface Props {
  title: string;
  description?: string;
  activeSection?: "courses" | "express" | "dashboard" | "users" | "badges";
}

const {
  title,
  description = "Panel de Administración y Generación de Embeds · Café y Código",
  activeSection = "courses",
} = Astro.props;

const navItems = [
  {
    href: "/admin/embed/",
    key: "courses",
    label: "Embed Cursos & Quizzes",
    icon: "📚",
    badge: "LMS",
  },
  {
    href: "/admin/embed-challenges-express/",
    key: "express",
    label: "Embed Desafíos Express",
    icon: "⚡",
    badge: "Interactivos",
  },
  {
    href: "/admin/dashboard/",
    key: "dashboard",
    label: "Dashboard",
    icon: "📊",
  },
  {
    href: "/admin/users/",
    key: "users",
    label: "Usuarios",
    icon: "👥",
  },
  {
    href: "/admin/badges/",
    key: "badges",
    label: "Insignias",
    icon: "🎖️",
  },
];
---

<!doctype html>
<html lang="es" class="h-full bg-slate-900 text-slate-100">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={logoCafeycodigo.src} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Admin Café y Código</title>

    <style is:global>
      body {
        font-family: "Nunito", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }
      code, pre {
        font-family: "JetBrains Mono", monospace;
      }
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      ::-webkit-scrollbar-track {
        background: #0f172a;
      }
      ::-webkit-scrollbar-thumb {
        background: #334155;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #475569;
      }
    </style>
  </head>
  <body class="h-full bg-[#0B0F19] text-slate-100 flex flex-col min-h-screen">
    <!-- TOP ADMINISTRATIVE HEADER -->
    <header class="bg-[#0F172A] border-b border-slate-800 sticky top-0 z-50 px-4 py-2.5 shadow-md">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
        <!-- BRAND -->
        <div class="flex items-center gap-3">
          <a href="/admin/embed/" class="flex items-center gap-2.5 no-underline group">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-sky-600 to-indigo-600 flex items-center justify-center text-white font-black text-sm shadow-sm group-hover:scale-105 transition-transform">
              ⚙️
            </div>
            <div>
              <span class="font-extrabold text-sm text-white tracking-wide block leading-none">
                Café y Código <span class="text-sky-400 font-bold text-xs">Admin</span>
              </span>
              <span class="text-[10px] text-slate-400 font-bold">Portal de Gestión & Embeds</span>
            </div>
          </a>
        </div>

        <!-- NAVIGATION LINKS -->
        <nav class="hidden md:flex items-center gap-1 bg-slate-950/60 p-1 rounded-xl border border-slate-800">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold transition-all no-underline",
                  activeSection === item.key
                    ? "bg-sky-600 text-white shadow-sm"
                    : "text-slate-400 hover:text-slate-200 hover:bg-slate-800/60",
                ]}
              >
                <span>{item.icon}</span>
                <span>{item.label}</span>
                {item.badge && (
                  <span
                    class:list={[
                      "text-[9px] font-black px-1.5 py-0.2 rounded-md uppercase tracking-wider",
                      activeSection === item.key
                        ? "bg-sky-950 text-sky-200"
                        : "bg-slate-800 text-slate-400",
                    ]}
                  >
                    {item.badge}
                  </span>
                )}
              </a>
            ))
          }
        </nav>

        <!-- EXTERNAL ACTIONS -->
        <div class="flex items-center gap-2">
          <a
            href="/challenges-express/"
            target="_blank"
            class="text-xs font-bold text-amber-400 hover:text-amber-300 bg-amber-950/50 border border-amber-800/60 px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1 no-underline"
            title="Ver vista pública de Desafíos Express"
          >
            <span>⚡ Express Público</span>
            <span>↗</span>
          </a>
          <a
            href="/"
            target="_blank"
            class="text-xs font-bold text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-1 no-underline"
          >
            <span>Sitio Web</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </header>

    <!-- MOBILE NAVIGATION BAR -->
    <div class="md:hidden bg-slate-900 border-b border-slate-800 px-4 py-2 flex items-center gap-1 overflow-x-auto">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold whitespace-nowrap no-underline",
              activeSection === item.key
                ? "bg-sky-600 text-white"
                : "text-slate-400 hover:text-slate-200 bg-slate-800/40",
            ]}
          >
            <span>{item.icon}</span>
            <span>{item.label}</span>
          </a>
        ))
      }
    </div>

    <!-- MAIN ADMIN CONTAINER -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 text-slate-900">
      <div class="bg-white rounded-3xl border border-slate-200 shadow-xl p-5 sm:p-8">
        <slot />
      </div>
    </main>

    <!-- ADMIN FOOTER -->
    <footer class="bg-[#090D16] border-t border-slate-800/80 py-4 px-4 text-center text-xs text-slate-500 font-medium">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
        <span>© Café y Código · Herramientas de Administración Interna</span>
        <div class="flex items-center gap-3 font-bold">
          <a href="/admin/embed/" class="text-slate-400 hover:text-sky-400 no-underline">Embed Cursos</a>
          <span class="text-slate-700">•</span>
          <a href="/admin/embed-challenges-express/" class="text-slate-400 hover:text-sky-400 no-underline">Embed Express</a>
          <span class="text-slate-700">•</span>
          <a href="/admin/dashboard/" class="text-slate-400 hover:text-sky-400 no-underline">Dashboard</a>
        </div>
      </div>
    </footer>
  </body>
</html>
