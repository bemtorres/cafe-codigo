---
import "../styles/global.css";
import "../styles/code-themes.css";
import "@xyflow/react/dist/style.css";
import logoCafeycodigo from "../assets/images/cafeycodigo.png";
import ogLogo from "../assets/images/logo-cafecodigo.png";

interface Props {
  title: string;
  description?: string;
}

const {
  title = "Motor de Diseño Relacional de Bases de Datos (.CYC)",
  description = "Diseñador visual de bases de datos relacionales en pantalla completa con React Flow, exportación .cyc, JSON, SQL DDL e imágenes PNG.",
} = Astro.props;

const CANONICAL_SITE = 'https://cafeycodigo.org';
const rawPath = Astro.url.pathname;
const normalizedCanonicalPath = rawPath === '' || rawPath === '/'
  ? '/'
  : (rawPath.endsWith('/') || rawPath.includes('.') ? rawPath : `${rawPath}/`);
const computedCanonicalUrl = `${CANONICAL_SITE}${normalizedCanonicalPath}`;
---

<!doctype html>
<html lang="es" class="h-full w-full overflow-hidden bg-slate-900 text-slate-100">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={logoCafeycodigo.src} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content={description} />
    <link rel="canonical" href={computedCanonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Merriweather:ital,wght@0,400;0,700;1,400&family=Nunito:wght@400;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | Café y Código Engine`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={computedCanonicalUrl} />
    <meta property="og:image" content={ogLogo.src} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={`${title} | Café y Código Engine`} />
    <meta property="twitter:description" content={description} />

    <title>{title} · Café y Código</title>

    <style is:global>
      html, body {
        height: 100%;
        width: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
        font-family: "Nunito", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background-color: #0f172a;
        color: #0f172a;
      }
      code, pre, textarea.font-mono {
        font-family: "JetBrains Mono", monospace;
      }
      /* Custom thin scrollbar */
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      ::-webkit-scrollbar-track {
        background: #f1f5f9;
      }
      ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
      }
    </style>
  </head>

  <body class="h-full w-full flex flex-col bg-slate-950 overflow-hidden select-none">
    <!-- BARRA SUPERIOR SLIM DEL ENGINE LAYOUT -->
    <header class="h-11 bg-[#121927] border-b border-slate-800 px-3 flex items-center justify-between shrink-0 z-30 select-none">
      <div class="flex items-center gap-2.5">
        <!-- Volver a retos -->
        <a
          href="/challenges/database/"
          class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-200 text-xs font-bold no-underline transition-colors border border-slate-700/60"
          title="Regresar al catálogo de 40 desafíos de bases de datos"
        >
          <span class="text-sky-400">←</span>
          <span>Desafíos SQL</span>
        </a>

        <span class="text-slate-600 text-xs">•</span>

        <!-- Brand / Engine Logo -->
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-lg bg-gradient-to-tr from-sky-600 to-indigo-500 flex items-center justify-center text-xs text-white shadow-sm font-black">
            CYC
          </span>
          <span class="font-extrabold text-xs text-white tracking-wide">
            Relational DB Engine
          </span>
        </div>
      </div>

      <!-- Atajos y Acciones Rápidas -->
      <div class="flex items-center gap-2">
        <span class="text-[0.7rem] text-slate-400 hidden md:inline-flex items-center gap-1">
          <kbd class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 font-mono text-[0.65rem] border border-slate-700">Espacio + Arrastrar</kbd> Desplazar lienzo
        </span>

        <!-- Botón Pantalla Completa nativa -->
        <button
          id="btn-toggle-fullscreen"
          type="button"
          class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold transition-colors border border-slate-700/60 cursor-pointer"
          title="Activar / Salir de pantalla completa (F11)"
        >
          <span id="fullscreen-icon">⛶</span>
          <span id="fullscreen-label" class="hidden sm:inline">Pantalla Completa</span>
        </button>
      </div>
    </header>

    <!-- CONTENEDOR PRINCIPAL FULLSCREEN -->
    <main class="flex-1 w-full h-[calc(100vh-44px)] overflow-hidden relative flex flex-col bg-slate-100">
      <slot />
    </main>

    <script is:inline>
      const fsBtn = document.getElementById('btn-toggle-fullscreen');
      const fsIcon = document.getElementById('fullscreen-icon');
      const fsLabel = document.getElementById('fullscreen-label');

      function updateFullscreenUI() {
        if (document.fullscreenElement) {
          if (fsIcon) fsIcon.textContent = '✕';
          if (fsLabel) fsLabel.textContent = 'Salir Fullscreen';
        } else {
          if (fsIcon) fsIcon.textContent = '⛶';
          if (fsLabel) fsLabel.textContent = 'Pantalla Completa';
        }
      }

      if (fsBtn) {
        fsBtn.addEventListener('click', () => {
          if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(() => {});
          } else {
            document.exitFullscreen().catch(() => {});
          }
        });
      }

      document.addEventListener('fullscreenchange', updateFullscreenUI);
    </script>
  </body>
</html>
