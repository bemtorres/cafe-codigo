---
import Layout from '../../layouts/Layout.astro';
import { databaseChallenges } from '../../data/databaseChallenges';
import { highlightLine } from '../../lib/codeHighlight';
import DatabaseSchemaFlow from '../../components/challenges/DatabaseSchemaFlow';

const totalChallenges = databaseChallenges.length;
const block1Count = databaseChallenges.filter(c => c.block === 1).length;
const block2Count = databaseChallenges.filter(c => c.block === 2).length;
const block3Count = databaseChallenges.filter(c => c.block === 3).length;
const block4Count = databaseChallenges.filter(c => c.block === 4).length;

function getSqlLines(sqlText: string): string[] {
  return String(sqlText || '').replace(/\r\n/g, '\n').split('\n');
}
---

<Layout
  title="Bases de Datos y SQL — 40 Desafíos Relacionales"
  description="Ruta práctica de 40 desafíos de bases de datos relacionales: desde tablas simples, 2 tablas, esquemas multi-tabla (1:1, 1:N, N:M) hasta macro-sistemas empresariales de 10 tablas completas con DDL, DML y consultas analíticas."
>
  <article class="content-section max-w-6xl mx-auto px-4 py-6">

    <!-- HEADER DE LA PÁGINA -->
    <div class="mb-6 pb-4 border-b-2 border-dashed border-[#1E1210]/15">
      <div class="flex items-center gap-2 mb-1 flex-wrap">
        <a href="/challenges/" class="text-xs font-nunito font-extrabold text-[#0284c7] no-underline hover:underline">← Volver al Catálogo</a>
        <span class="text-slate-300">•</span>
        <span class="text-xs font-nunito font-extrabold uppercase tracking-widest text-[#0284c7]">Módulo Especial · Bases de Datos & SQL</span>
        <span class="text-slate-300">•</span>
        <span class="text-xs font-nunito font-black bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full border border-emerald-300">40 Desafíos</span>
      </div>
      <h1 class="m-0 text-2xl sm:text-4xl font-nunito font-black text-[#1E1210]">
        Desafíos de Bases de Datos & SQL
      </h1>
      <p class="mt-2 text-sm sm:text-base text-slate-600 font-medium leading-relaxed">
        Aprende modelamiento relacional y SQL estándar (PostgreSQL, MySQL, SQLite, SQL Server) en <strong>4 bloques graduales de 10 desafíos</strong>: desde la creación de tablas atómicas hasta <strong>macro-sistemas empresariales de 10 tablas completas</strong>.
      </p>

      <!-- STATS PILLS -->
      <div class="flex items-center gap-3 mt-4 flex-wrap">
        <div class="flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 border border-blue-200 rounded-xl text-xs font-nunito font-extrabold text-blue-900">
          <span>📦</span> <strong>10</strong> Tablas Simples
        </div>
        <div class="flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 border border-emerald-200 rounded-xl text-xs font-nunito font-extrabold text-emerald-900">
          <span>🔗</span> <strong>10</strong> Dos Tablas (1:N)
        </div>
        <div class="flex items-center gap-1.5 px-3 py-1.5 bg-purple-50 border border-purple-200 rounded-xl text-xs font-nunito font-extrabold text-purple-900">
          <span>🔀</span> <strong>10</strong> Multi-Tabla (1:1, N:M)
        </div>
        <div class="flex items-center gap-1.5 px-3 py-1.5 bg-rose-50 border border-rose-200 rounded-xl text-xs font-nunito font-extrabold text-rose-900">
          <span>🏛️</span> <strong>10</strong> Sistemas de 10 Tablas
        </div>
      </div>
    </div>

    <!-- CONTROLES Y FILTROS -->
    <div class="mb-6 flex flex-col md:flex-row items-center justify-between gap-4 bg-slate-50 p-4 rounded-2xl border-2 border-[#1E1210] shadow-[3px_3px_0px_#1E1210]">
      <div class="w-full md:w-auto flex flex-col sm:flex-row items-stretch sm:items-center gap-3 flex-1">
        <div class="w-full sm:w-72">
          <label for="searchBox" class="text-xs font-nunito font-black text-slate-700 uppercase tracking-wider block mb-1">🔍 Buscar Desafío o SQL</label>
          <input
            type="text"
            id="searchBox"
            placeholder="Buscar por tabla, concepto (JOIN, CHECK, 10 tablas)..."
            class="w-full px-3 py-2 rounded-xl border-2 border-[#1E1210] font-nunito font-bold text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div class="flex items-center gap-1 overflow-x-auto pb-1 sm:pb-0">
          <button type="button" class="filter-btn is-active px-3 py-1.5 rounded-xl border-2 border-[#1E1210] text-xs font-nunito font-black cursor-pointer bg-[#1E1210] text-white" data-block="all">Todos ({totalChallenges})</button>
          <button type="button" class="filter-btn px-2.5 py-1.5 rounded-xl border-2 border-[#1E1210] text-xs font-nunito font-black cursor-pointer bg-white text-[#1E1210] hover:bg-blue-50" data-block="1">B1: 1 Tabla ({block1Count})</button>
          <button type="button" class="filter-btn px-2.5 py-1.5 rounded-xl border-2 border-[#1E1210] text-xs font-nunito font-black cursor-pointer bg-white text-[#1E1210] hover:bg-emerald-50" data-block="2">B2: 2 Tablas ({block2Count})</button>
          <button type="button" class="filter-btn px-2.5 py-1.5 rounded-xl border-2 border-[#1E1210] text-xs font-nunito font-black cursor-pointer bg-white text-[#1E1210] hover:bg-purple-50" data-block="3">B3: Multi-Tabla ({block3Count})</button>
          <button type="button" class="filter-btn px-2.5 py-1.5 rounded-xl border-2 border-[#1E1210] text-xs font-nunito font-black cursor-pointer bg-white text-[#1E1210] hover:bg-rose-50" data-block="4">B4: 10 Tablas ({block4Count})</button>
        </div>
      </div>

      <div class="flex items-center gap-2 w-full md:w-auto justify-end shrink-0">
        <button type="button" id="expandAll" class="px-3.5 py-2 rounded-xl border-2 border-[#1E1210] bg-[#1E1210] text-white font-nunito font-black text-xs cursor-pointer shadow-[2px_2px_0px_#1E1210] hover:-translate-y-0.5 transition-transform">Expandir todo</button>
        <button type="button" id="collapseAll" class="px-3.5 py-2 rounded-xl border-2 border-[#1E1210] bg-white text-[#1E1210] font-nunito font-black text-xs cursor-pointer shadow-[2px_2px_0px_#1E1210] hover:-translate-y-0.5 transition-transform">Colapsar</button>
      </div>
    </div>

    <!-- BOTÓN FLOTANTE SUGERENCIAS GUIADAS -->
    <aside class="fixed bottom-6 right-6 z-50 flex items-center">
      <label for="toggleSuggestions" class="flex items-center gap-3 bg-white hover:bg-emerald-50 text-[#1E1210] px-4 py-3 rounded-2xl border-[3px] border-[#1E1210] shadow-[5px_5px_0px_#1E1210] hover:shadow-[7px_7px_0px_#10b981] hover:-translate-y-1 transition-all cursor-pointer select-none">
        <input type="checkbox" id="toggleSuggestions" class="w-5 h-5 accent-emerald-600 rounded cursor-pointer" />
        <span class="font-nunito font-extrabold text-xs sm:text-sm flex items-center gap-1.5">
          <span>💡</span>
          <span>Ver pistas y soluciones guiadas</span>
        </span>
      </label>
    </aside>

    <!-- LISTADO RÁPIDO DE 40 EJERCICIOS -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-3 border-b-2 border-[#1E1210] pb-2">
        <h2 class="text-base font-nunito font-black text-[#1E1210] m-0 flex items-center gap-2">
          <span>📋</span> Índice Rápido de Desafíos (1 al 40)
        </h2>
        <span class="text-xs font-nunito font-extrabold text-slate-600 bg-slate-100 px-3 py-1 rounded-full border border-slate-300" id="globalProgressText">0 / 40 completados</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2" id="quickList">
        {databaseChallenges.map((ex) => (
          <div class="quick-item search-target border border-slate-200 hover:border-[#1E1210] p-2 rounded-xl bg-white flex items-center gap-2 transition-all" data-block={ex.block} data-keywords={`${ex.title.toLowerCase()} ${ex.tables.map(t => t.name).join(' ')}`} data-quick-id={ex.slug}>
            <label class="flex items-center cursor-pointer shrink-0" title="Marcar como completado">
              <input type="checkbox" data-complete-id={ex.slug} class="w-4 h-4 accent-blue-600 rounded cursor-pointer" />
            </label>
            <a href={`#${ex.slug}`} class="quick-link flex items-center justify-between gap-1 flex-1 min-w-0 no-underline text-inherit hover:text-blue-700">
              <div class="flex items-center gap-1.5 min-w-0">
                <span class="text-[0.65rem] font-mono font-bold bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded shrink-0">{String(ex.id).padStart(2, '0')}</span>
                <span class="text-xs font-nunito font-extrabold truncate">{ex.title}</span>
              </div>
              <span class="quick-arrow text-xs text-slate-400">↓</span>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- LISTA PRINCIPAL DE DESAFÍOS EXPANDIBLES -->
    <section class="mb-12">
      <div class="flex items-center justify-between mb-4 border-b-2 border-[#1E1210] pb-2">
        <h2 class="text-base sm:text-lg font-nunito font-black text-[#1E1210] m-0 flex items-center gap-2">
          <span>🎯</span> Especificación Técnica, Esquemas Relacionales y Código SQL
        </h2>
      </div>

      <div id="challengeContainer" class="flex flex-col gap-6">
        {databaseChallenges.map((ch) => (
          <details
            class="challenge-card border-2 border-[#1E1210] bg-white rounded-2xl p-4 sm:p-5 shadow-[4px_4px_0px_#1E1210] search-target transition-all"
            id={ch.slug}
            data-block={ch.block}
            data-slug={ch.slug}
            data-keywords={`${ch.title.toLowerCase()} ${ch.context.toLowerCase()} ${ch.tables.map(t => t.name).join(' ')} ${ch.blockTitle.toLowerCase()}`}
          >
            <summary class="challenge-summary flex items-center justify-between cursor-pointer font-nunito select-none gap-3">
              <div class="flex items-center gap-3 min-w-0">
                <span class="w-9 h-9 rounded-xl flex items-center justify-center text-xs font-black text-white shrink-0 shadow-[2px_2px_0px_#1E1210]" style={`background-color: ${ch.badgeColor};`}>
                  {String(ch.id).padStart(2, '0')}
                </span>
                <div class="min-w-0">
                  <div class="flex items-center gap-2 flex-wrap mb-0.5">
                    <span class="text-[0.65rem] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md border" style={`background-color: ${ch.badgeColor}15; color: ${ch.badgeColor}; border-color: ${ch.badgeColor}40;`}>
                      {ch.blockTitle}
                    </span>
                    <span class="text-[0.65rem] font-bold px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-300">
                      {ch.tables.length} {ch.tables.length === 1 ? 'Tabla' : 'Tablas'}
                    </span>
                  </div>
                  <h3 class="m-0 text-sm sm:text-base font-black text-[#1E1210] truncate">
                    {ch.title}
                  </h3>
                </div>
              </div>

              <div class="flex items-center gap-3 shrink-0">
                <label class="hidden sm:flex items-center gap-1.5 text-xs font-extrabold bg-blue-50 hover:bg-blue-100 text-blue-900 px-3 py-1 rounded-xl border border-blue-200 cursor-pointer" onclick="event.stopPropagation()">
                  <input type="checkbox" data-complete-id={ch.slug} class="w-4 h-4 accent-blue-600 rounded cursor-pointer" />
                  <span>Completado</span>
                </label>
                <span class="text-xs font-mono font-bold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-lg border border-slate-200" data-progress-for={ch.slug}>
                  0 / {ch.checkList.length}
                </span>
                <span class="text-sm font-bold text-slate-400">▼</span>
              </div>
            </summary>

            <div class="challenge-body mt-4 pt-4 border-t-2 border-dashed border-slate-200 flex flex-col gap-5">
              
              <!-- CONTEXTO Y ENUNCIADO -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div class="bg-amber-50/80 p-4 rounded-xl border-2 border-amber-200 shadow-sm">
                  <h4 class="text-xs font-nunito font-black text-amber-950 uppercase tracking-wider mb-1 flex items-center gap-1.5">
                    <span>🏢</span> Contexto Real de Negocio
                  </h4>
                  <p class="text-xs font-medium text-slate-700 leading-relaxed m-0">
                    {ch.context}
                  </p>
                </div>
                <div class="bg-blue-50/80 p-4 rounded-xl border-2 border-blue-200 shadow-sm">
                  <h4 class="text-xs font-nunito font-black text-blue-950 uppercase tracking-wider mb-1 flex items-center gap-1.5">
                    <span>🎯</span> Requerimiento Técnico
                  </h4>
                  <p class="text-xs font-medium text-slate-700 leading-relaxed m-0">
                    {ch.statement}
                  </p>
                </div>
              </div>

              <!-- DIAGRAMA RELACIONAL INTERACTIVO REACT FLOW (DATABASE SCHEMA NODE) -->
              <div class="my-2">
                <DatabaseSchemaFlow client:visible tables={ch.tables} challengeId={ch.id} title={ch.title} />
              </div>

              <!-- PESTAÑAS Y VISOR DE CÓDIGO SQL -->
              <div class="sql-viewer border-[3px] border-[#1E1210] rounded-2xl overflow-hidden shadow-[4px_4px_0px_#1E1210] bg-[#0d1117]">
                
                <!-- BARRA SUPERIOR DEL EDITOR ESTILO IDE -->
                <div class="tab-header bg-[#161b22] px-4 py-2.5 flex items-center justify-between border-b-2 border-[#1E1210] flex-wrap gap-2">
                  <div class="flex items-center gap-3">
                    <!-- Dots macOS -->
                    <div class="hidden sm:flex items-center gap-1.5">
                      <span class="w-3 h-3 rounded-full bg-[#ff5f56] inline-block border border-black/20"></span>
                      <span class="w-3 h-3 rounded-full bg-[#ffbd2e] inline-block border border-black/20"></span>
                      <span class="w-3 h-3 rounded-full bg-[#27c93f] inline-block border border-black/20"></span>
                    </div>

                    <!-- Botones de Pestañas -->
                    <div class="flex items-center gap-1">
                      <button type="button" class="tab-btn is-active px-3 py-1.5 rounded-lg text-xs font-nunito font-extrabold bg-[#2563eb] text-white cursor-pointer transition-colors shadow-sm" data-tab={`ddl-${ch.id}`}>
                        <span>📐</span> 1. DDL Creación
                      </button>
                      <button type="button" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-nunito font-extrabold bg-[#21262d] hover:bg-[#30363d] text-slate-300 cursor-pointer transition-colors" data-tab={`dml-${ch.id}`}>
                        <span>📥</span> 2. Datos DML
                      </button>
                      <button type="button" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-nunito font-extrabold bg-[#21262d] hover:bg-[#30363d] text-emerald-300 cursor-pointer transition-colors flex items-center gap-1" data-tab={`sol-${ch.id}`}>
                        <span>✨</span> 3. Consultas & Soluciones
                      </button>
                    </div>
                  </div>

                  <!-- Botón Copiar Todo el Tab Activo -->
                  <button
                    type="button"
                    class="copy-active-tab-btn px-3 py-1.5 bg-[#21262d] hover:bg-[#30363d] text-slate-200 border border-slate-700 rounded-xl text-xs font-nunito font-bold flex items-center gap-1.5 cursor-pointer transition-all hover:scale-105"
                  >
                    <span>📋</span>
                    <span class="copy-tab-label">Copiar SQL del Panel</span>
                  </button>
                </div>

                <!-- CONTENEDORES DE CÓDIGO POR PESTAÑA -->
                <div class="tab-panels p-4 overflow-x-auto text-xs font-mono bg-[#0d1117]">
                  
                  <!-- TAB 1: DDL -->
                  <div class="tab-panel" id={`ddl-${ch.id}`}>
                    <div class="code-viewport py-2">
                      {getSqlLines(ch.ddlSql).map((line, idx) => (
                        <div class="code-line flex px-2 leading-[1.65] text-[0.88rem] hover:bg-white/5 min-w-max font-mono">
                          <span class="line-num text-right select-none min-w-[2rem] pr-3 mr-3 text-slate-600 font-mono text-xs border-r border-slate-800 shrink-0">
                            {idx + 1}
                          </span>
                          <span class="whitespace-pre text-slate-200" set:html={highlightLine(line === '' ? ' ' : line, 'sql')} />
                        </div>
                      ))}
                    </div>
                  </div>

                  <!-- TAB 2: DML -->
                  <div class="tab-panel hidden" id={`dml-${ch.id}`}>
                    <div class="code-viewport py-2">
                      {getSqlLines(ch.seedSql).map((line, idx) => (
                        <div class="code-line flex px-2 leading-[1.65] text-[0.88rem] hover:bg-white/5 min-w-max font-mono">
                          <span class="line-num text-right select-none min-w-[2rem] pr-3 mr-3 text-slate-600 font-mono text-xs border-r border-slate-800 shrink-0">
                            {idx + 1}
                          </span>
                          <span class="whitespace-pre text-slate-200" set:html={highlightLine(line === '' ? ' ' : line, 'sql')} />
                        </div>
                      ))}
                    </div>
                  </div>

                  <!-- TAB 3: CONSULTAS & SOLUCIONES DESTACADAS -->
                  <div class="tab-panel hidden" id={`sol-${ch.id}`}>
                    <div class="flex flex-col gap-5 py-2">
                      {ch.queriesToSolve.map((q, qIdx) => (
                        <div class="challenge-query-box bg-[#161b22] border-2 border-slate-700/80 rounded-2xl p-4 sm:p-5 flex flex-col gap-3 shadow-md">
                          
                          <!-- ENUNCIADO DEL RETO -->
                          <div class="flex items-start gap-2.5 flex-wrap">
                            <span class="text-[0.7rem] font-nunito font-black uppercase tracking-wider bg-amber-400 text-[#1E1210] px-2.5 py-0.5 rounded-md border border-[#1E1210] shadow-[1px_1px_0px_#1E1210] shrink-0">
                              🎯 Reto {qIdx + 1}
                            </span>
                            <h5 class="m-0 text-xs sm:text-sm font-nunito font-extrabold text-white leading-snug flex-1">
                              {q.question}
                            </h5>
                          </div>

                          <!-- PISTA -->
                          <div class="bg-amber-950/40 border border-amber-500/30 rounded-xl px-3.5 py-2 text-xs font-nunito text-amber-200 flex items-start gap-2">
                            <span class="shrink-0 text-sm">💡</span>
                            <span><strong>Pista:</strong> {q.hint}</span>
                          </div>

                          <!-- CONTENEDOR DE LA SOLUCIÓN CON BORDE ESMERALDA DESTACADO -->
                          <div class="solution-container border-[3px] border-emerald-500 rounded-2xl overflow-hidden bg-[#070d19] shadow-[4px_4px_0px_#10b981] mt-2">
                            <div class="solution-header bg-[#064e3b]/90 border-b-2 border-emerald-500/80 px-4 py-2.5 flex items-center justify-between flex-wrap gap-2">
                              <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span class="text-xs font-nunito font-black text-emerald-200 uppercase tracking-wider flex items-center gap-1.5">
                                  <span>✨</span> Solución SQL Verificada
                                </span>
                              </div>
                              <button
                                type="button"
                                class="copy-single-btn px-3 py-1 bg-emerald-800 hover:bg-emerald-700 text-emerald-100 border border-emerald-400/60 rounded-xl text-xs font-nunito font-black flex items-center gap-1.5 cursor-pointer transition-all hover:scale-105 shadow-sm"
                                data-copy-code={encodeURIComponent(q.solutionSql)}
                              >
                                <span>📋</span>
                                <span class="btn-text">Copiar Solución</span>
                              </button>
                            </div>

                            <div class="code-viewport py-3 px-1 overflow-x-auto font-mono text-xs">
                              {getSqlLines(q.solutionSql).map((line, lIdx) => (
                                <div class="code-line flex px-3 leading-[1.65] text-[0.88rem] hover:bg-emerald-500/10 min-w-max font-mono">
                                  <span class="line-num text-right select-none min-w-[2rem] pr-3 mr-3 text-emerald-600/70 font-mono text-xs border-r border-emerald-800/40 shrink-0">
                                    {lIdx + 1}
                                  </span>
                                  <span class="whitespace-pre text-emerald-100 font-semibold" set:html={highlightLine(line === '' ? ' ' : line, 'sql')} />
                                </div>
                              ))}
                            </div>
                          </div>

                        </div>
                      ))}
                    </div>
                  </div>

                </div>
              </div>

              <!-- CHECKLIST DE APRENDIZAJE -->
              <div class="checklist-section bg-blue-50/50 p-4 rounded-xl border border-blue-200">
                <h4 class="text-xs font-nunito font-black text-blue-950 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                  <span>✅</span> Checklist de Dominio Técnico
                </h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-nunito font-bold text-slate-700">
                  {ch.checkList.map((chkItem, chkIdx) => (
                    <label class="flex items-center gap-2 cursor-pointer hover:bg-white p-1.5 rounded-lg transition-colors">
                      <input type="checkbox" data-check-for={ch.slug} data-check-index={chkIdx} class="w-4 h-4 accent-blue-600 rounded cursor-pointer" />
                      <span>{chkItem}</span>
                    </label>
                  ))}
                </div>
              </div>

            </div>
          </details>
        ))}
      </div>
    </section>

  </article>
</Layout>

<style>
  .challenge-card[open] {
    box-shadow: 6px 6px 0px #1E1210;
  }
  .quick-item:hover {
    transform: translateY(-1px);
  }
  .filter-btn.is-active {
    background-color: #1E1210 !important;
    color: white !important;
    box-shadow: 2px 2px 0px #1E1210;
  }
  .tab-btn.is-active {
    background-color: #2563eb !important;
    color: white !important;
  }
  .hidden-by-filter {
    display: none !important;
  }

  /* Tokens de Syntax Highlighting */
  :global(.hl-kw) {
    color: #38bdf8 !important;
    font-weight: 800 !important;
  }
  :global(.hl-str) {
    color: #a7f3d0 !important;
  }
  :global(.hl-func), :global(.hl-func-call) {
    color: #facc15 !important;
    font-weight: 700 !important;
  }
  :global(.hl-type) {
    color: #c084fc !important;
    font-weight: 700 !important;
  }
  :global(.hl-num) {
    color: #fb923c !important;
  }
  :global(.hl-comment) {
    color: #94a3b8 !important;
    font-style: italic !important;
  }
  :global(.hl-op) {
    color: #e2e8f0 !important;
  }
</style>

<script>
  // Almacenamiento local para progreso y estado de checkboxes
  const STORAGE_KEY = 'aprende_db_challenges_v1';

  function getStoredData() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : { completedSlugs: [], checkedItems: {} };
    } catch {
      return { completedSlugs: [], checkedItems: {} };
    }
  }

  function saveStoredData(data) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch (e) {
      console.error(e);
    }
  }

  function updateUiProgress() {
    const data = getStoredData();
    const completedSet = new Set(data.completedSlugs || []);

    // Actualizar checkboxes de completado
    document.querySelectorAll('input[data-complete-id]').forEach((input) => {
      const slug = input.getAttribute('data-complete-id');
      if (slug) {
        input.checked = completedSet.has(slug);
      }
    });

    // Actualizar checklist interno
    document.querySelectorAll('input[data-check-for]').forEach((input) => {
      const slug = input.getAttribute('data-check-for');
      const idx = input.getAttribute('data-check-index');
      if (slug && idx !== null) {
        const itemKey = `${slug}__${idx}`;
        input.checked = !!(data.checkedItems && data.checkedItems[itemKey]);
      }
    });

    // Actualizar contadores de cada tarjeta
    document.querySelectorAll('.challenge-card').forEach((card) => {
      const slug = card.getAttribute('data-slug');
      if (!slug) return;
      const chkInputs = card.querySelectorAll('input[data-check-for]');
      const checkedCount = Array.from(chkInputs).filter((i) => i.checked).length;
      const progEl = card.querySelector(`[data-progress-for="${slug}"]`);
      if (progEl) {
        progEl.textContent = `${checkedCount} / ${chkInputs.length}`;
      }
    });

    // Actualizar contador global
    const globalProgEl = document.getElementById('globalProgressText');
    if (globalProgEl) {
      globalProgEl.textContent = `${completedSet.size} / 40 completados`;
    }
  }

  // Inicialización en DOMContentLoaded
  document.addEventListener('DOMContentLoaded', () => {
    updateUiProgress();

    // Eventos para checkboxes de completado
    document.addEventListener('change', (e) => {
      const target = e.target;
      if (!target) return;

      // Click en checkbox de completado
      if (target.matches('input[data-complete-id]')) {
        const slug = target.getAttribute('data-complete-id');
        if (!slug) return;
        const data = getStoredData();
        const set = new Set(data.completedSlugs || []);
        if (target.checked) {
          set.add(slug);
        } else {
          set.delete(slug);
        }
        data.completedSlugs = Array.from(set);
        saveStoredData(data);
        updateUiProgress();
      }

      // Click en checklist individual
      if (target.matches('input[data-check-for]')) {
        const slug = target.getAttribute('data-check-for');
        const idx = target.getAttribute('data-check-index');
        if (!slug || idx === null) return;
        const data = getStoredData();
        data.checkedItems = data.checkedItems || {};
        const key = `${slug}__${idx}`;
        if (target.checked) {
          data.checkedItems[key] = true;
        } else {
          delete data.checkedItems[key];
        }

        // Si todos los checks del card están listos, marcar el desafío como completado automáticamente
        const card = document.getElementById(slug);
        if (card) {
          const chks = card.querySelectorAll('input[data-check-for]');
          const allChecked = Array.from(chks).every((c) => c.checked);
          const set = new Set(data.completedSlugs || []);
          if (allChecked) {
            set.add(slug);
          }
          data.completedSlugs = Array.from(set);
        }

        saveStoredData(data);
        updateUiProgress();
      }
    });

    // Filtro por bloque
    const filterBtns = document.querySelectorAll('.filter-btn');
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        const block = btn.getAttribute('data-block');
        const cards = document.querySelectorAll('.challenge-card');
        const quickItems = document.querySelectorAll('.quick-item');

        cards.forEach((card) => {
          const cardBlock = card.getAttribute('data-block');
          if (block === 'all' || cardBlock === block) {
            card.classList.remove('hidden-by-filter');
          } else {
            card.classList.add('hidden-by-filter');
          }
        });

        quickItems.forEach((qi) => {
          const qiBlock = qi.getAttribute('data-block');
          if (block === 'all' || qiBlock === block) {
            qi.classList.remove('hidden-by-filter');
          } else {
            qi.classList.add('hidden-by-filter');
          }
        });
      });
    });

    // Buscador en tiempo real
    const searchBox = document.getElementById('searchBox');
    if (searchBox) {
      searchBox.addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase().trim();
        const targets = document.querySelectorAll('.search-target');

        targets.forEach((el) => {
          const keywords = el.getAttribute('data-keywords') || '';
          if (!q || keywords.includes(q)) {
            el.classList.remove('hidden-by-filter');
          } else {
            el.classList.add('hidden-by-filter');
          }
        });
      });
    }

    // Expandir / Colapsar todos
    const expandAllBtn = document.getElementById('expandAll');
    const collapseAllBtn = document.getElementById('collapseAll');

    if (expandAllBtn) {
      expandAllBtn.addEventListener('click', () => {
        document.querySelectorAll('details.challenge-card').forEach((d) => (d.open = true));
      });
    }

    if (collapseAllBtn) {
      collapseAllBtn.addEventListener('click', () => {
        document.querySelectorAll('details.challenge-card').forEach((d) => (d.open = false));
      });
    }

    // Pestañas SQL dentro de cada tarjeta
    document.addEventListener('click', (e) => {
      const tabBtn = e.target.closest('.tab-btn');
      if (tabBtn) {
        const viewer = tabBtn.closest('.sql-viewer');
        if (!viewer) return;
        const targetTabId = tabBtn.getAttribute('data-tab');
        
        viewer.querySelectorAll('.tab-btn').forEach((b) => b.classList.remove('is-active'));
        tabBtn.classList.add('is-active');

        viewer.querySelectorAll('.tab-panel').forEach((p) => {
          if (p.id === targetTabId) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      }

      // Botón copiar SQL del panel activo
      const copyActiveBtn = e.target.closest('.copy-active-tab-btn');
      if (copyActiveBtn) {
        const viewer = copyActiveBtn.closest('.sql-viewer');
        if (!viewer) return;
        const activePanel = viewer.querySelector('.tab-panel:not(.hidden)');
        if (activePanel) {
          const text = activePanel.innerText;
          navigator.clipboard.writeText(text).then(() => {
            const label = copyActiveBtn.querySelector('.copy-tab-label');
            const originalText = label ? label.textContent : 'Copiar SQL del Panel';
            if (label) label.textContent = '✓ ¡Copiado!';
            copyActiveBtn.classList.add('bg-emerald-600', 'text-white');
            setTimeout(() => {
              if (label) label.textContent = originalText;
              copyActiveBtn.classList.remove('bg-emerald-600', 'text-white');
            }, 1800);
          });
        }
      }

      // Botón copiar solución individual
      const copySingleBtn = e.target.closest('.copy-single-btn');
      if (copySingleBtn) {
        const encoded = copySingleBtn.getAttribute('data-copy-code') || '';
        const decoded = decodeURIComponent(encoded);
        navigator.clipboard.writeText(decoded).then(() => {
          const btnText = copySingleBtn.querySelector('.btn-text');
          const originalText = btnText ? btnText.textContent : 'Copiar Solución';
          if (btnText) btnText.textContent = '✓ ¡Copiado!';
          copySingleBtn.classList.add('bg-emerald-600', 'text-white');
          setTimeout(() => {
            if (btnText) btnText.textContent = originalText;
            copySingleBtn.classList.remove('bg-emerald-600', 'text-white');
          }, 1800);
        });
      }
    });

    // Toggle para sugerencias guiadas
    const toggleSugg = document.getElementById('toggleSuggestions');
    if (toggleSugg) {
      toggleSugg.addEventListener('change', () => {
        const show = toggleSugg.checked;
        document.querySelectorAll('.solution-container').forEach((sol) => {
          if (show) {
            sol.classList.remove('opacity-25', 'blur-sm');
          } else {
            sol.classList.add('opacity-25', 'blur-sm');
          }
        });
      });
    }
  });
</script>
