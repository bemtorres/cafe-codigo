---
import Layout from '../../../layouts/Layout.astro';
import MermaidDiagram from '../../../components/challenges/MermaidDiagram.astro';
import { pooBasicChallenges, pooCourseLessons, toMermaid } from '../../../data/pooChallenges';

const lessonMeta: Record<string, { color: string; emoji: string }> = {
  Python: { color: '#3776ab', emoji: '🐍' },
  'C++': { color: '#00599C', emoji: '⚙️' },
  'C#': { color: '#6d28d9', emoji: '🎮' },
  Java: { color: '#E76F00', emoji: '☕' },
  'Java Unit': { color: '#0891b2', emoji: '🧪' },
  Kotlin: { color: '#A97BFF', emoji: '🤖' },
  PHP: { color: '#777BB4', emoji: '🐘' },
};

// Solo lecciones de POO básico (no herencia)
const basicLessons = pooCourseLessons.filter(l => /poo|clases|\b4\.\b/i.test(l.title) || /poo-basico|clases-y-objetos|poo\//i.test(l.href));
const totalBasicLessons = basicLessons.length;
const totalBasicLangs = new Set(basicLessons.map((l) => l.course)).size;
---

<Layout
  title="Desafíos de POO — Básico (10 clases)"
  description="10 ejercicios de POO básico: una sola clase con atributos y métodos, sin herencia. Diagramas de clase incluidos."
>
  <article class="content-section">
    <p class="kicker">POO Básico</p>
    <h1>Desafíos de POO — Básico</h1>
    <p>
      10 clases únicas <strong>sin herencia</strong> para dominar <strong>atributos, métodos y creación de objetos</strong>.
      Cada ejercicio trae su <strong>diagrama de clase interactivo</strong> (una sola caja). Ideal como primer paso antes de herencia e interfaces.
    </p>
    <p class="muted">
      Ruta canónica: <code>/challenges/poo</code> · También disponible: <a href="/challenges/inheritance/">/challenges/inheritance</a> (herencia) y <a href="/challenges/interface/">/challenges/interface</a> (interfaces).
    </p>

    <div class="poo-lessons-trigger-wrap">
      <button type="button" id="openPooLessonsModal" class="poo-lessons-trigger" aria-haspopup="dialog" aria-controls="pooLessonsModal">
        <span class="poo-trigger-icon" aria-hidden="true">🧱</span>
        <span class="poo-trigger-text">
          <span class="poo-trigger-kicker">Desde tu curso → a la práctica</span>
          <span class="poo-trigger-title">Lecciones de POO Básico enlazadas</span>
          <span class="poo-trigger-sub">Estudia clases en tu lenguaje y vuelve aquí a modelar.</span>
        </span>
        <span class="poo-trigger-badge" aria-label={`${totalBasicLessons} lecciones`}>{totalBasicLessons} lecciones · {totalBasicLangs} lenguajes</span>
        <span class="poo-trigger-cta" aria-hidden="true">Ver lecciones <span class="poo-trigger-arrow">→</span></span>
      </button>
      <p class="poo-trigger-hint">Modal con tarjetas — misma presentación que los ejercicios.</p>
    </div>

    <div id="pooLessonsModal" class="poo-modal" aria-hidden="true">
      <div class="poo-modal-backdrop" data-close-poo-modal aria-hidden="true" />
      <div class="poo-modal-panel" role="dialog" aria-modal="true" aria-labelledby="poo-lessons-title">
        <div class="poo-modal-header">
          <div>
            <p class="poo-modal-kicker">POO Básico</p>
            <h2 id="poo-lessons-title">Lecciones de POO Básico enlazadas</h2>
            <p class="poo-modal-sub">Elige tu lenguaje y vuelve a modelar la clase única.</p>
          </div>
          <button type="button" class="poo-modal-close" data-close-poo-modal aria-label="Cerrar modal">✕</button>
        </div>
        <div class="poo-lessons-grid">
          {basicLessons.map((l) => {
            const m = lessonMeta[l.course] ?? { color: '#1E1210', emoji: '📚' };
            return (
              <a href={l.href} class="lesson-card" style={`--lc:${m.color}`}>
                <span class="lesson-card-top">
                  <span class="lesson-dot" style={`background:${m.color}`} aria-hidden="true" />
                  <span class="lesson-pill" style={`color:${m.color}; border-color:${m.color}33; background:${m.color}14`}>
                    <span aria-hidden="true">{m.emoji}</span> {l.course}
                  </span>
                  <span class="lesson-arrow" aria-hidden="true">→</span>
                </span>
                <span class="lesson-card-title">{l.title}</span>
                <span class="lesson-card-cta">Ir a la lección</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <div class="exercise-toolbar">
      <p class="exercise-toolbar-hint">10 clases · clic para expandir diagrama y checklist</p>
      <div class="exercise-toolbar-actions">
        <div class="global-uml-switch" role="group" aria-label="Notación UML global">
          <button type="button" class="global-format-btn" data-global-format="classic" title="Formato Clásico (nombre: Tipo)">🏛️ Clásico</button>
          <button type="button" class="global-format-btn" data-global-format="alt" title="Formato Alternativo (Tipo nombre)">⚡ Alternativo</button>
        </div>
        <button type="button" id="expandAll" class="toolbar-btn">Expandir todo</button>
        <button type="button" id="collapseAll" class="toolbar-btn toolbar-btn--ghost">Colapsar todo</button>
      </div>
    </div>

    <div id="exerciseList" class="exercise-list">
      {pooBasicChallenges.map((ch) => (
        <details class="ex-card" id={ch.slug} data-ex-id={`poo-basico-${ch.id}`}>
          <summary class="ex-summary">
            <span class="ex-num" aria-hidden="true">{String(ch.id).padStart(2, '0')}</span>
            <div class="ex-summary-main">
              <h3>{ch.id}. {ch.title}</h3>
              <span class="ex-summary-meta">
                {ch.base.name} · {ch.base.attrs.length} attrs · {ch.base.methods.length} métodos
              </span>
            </div>
            <span class="ex-progress" data-progress-for={`poo-basico-${ch.id}`}></span>
            <span class="ex-chevron" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
            </span>
          </summary>
          <div class="ex-body">
            <p class="ex-statement">{ch.context}</p>
            <p class="ex-task"><strong>Qué hacer:</strong> {ch.task}</p>
            <MermaidDiagram title={`Clase ${ch.base.name}`} code={toMermaid(ch)} />
            <div class="ex-checks">
              <label class="chk"><input type="checkbox" data-check-id="diagrama" /> Leí el diagrama de clase</label>
              <label class="chk"><input type="checkbox" data-check-id="clase" /> Implementé la clase {ch.base.name}</label>
              <label class="chk"><input type="checkbox" data-check-id="metodos" /> Probé todos los métodos ({ch.base.methods.join(', ')})</label>
              <label class="chk"><input type="checkbox" data-check-id="instancia" /> Creé instancia y validé estados</label>
            </div>
          </div>
        </details>
      ))}
    </div>

    <div class="next-modules" style="margin-top:1.5rem; display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:0.85rem;">
      <a href="/challenges/inheritance/" class="unit-card" style="text-decoration:none; background:#fff; border:3px solid #1e1210; border-radius:16px; padding:1rem; box-shadow:4px 4px 0 #1e1210;">
        <h3 style="margin:0 0 0.3rem; color:#7c2d12">→ Herencia (Avanzado)</h3>
        <p style="margin:0; color:var(--text-secondary); font-weight:650">20 jerarquías base + 3 hijas. Siguiente nivel después de dominar clases únicas.</p>
      </a>
      <a href="/challenges/interface/" class="unit-card" style="text-decoration:none; background:#fff; border:3px solid #1e1210; border-radius:16px; padding:1rem; box-shadow:4px 4px 0 #1e1210;">
        <h3 style="margin:0 0 0.3rem; color:#6d28d9">→ Interfaces (Contratos)</h3>
        <p style="margin:0; color:var(--text-secondary); font-weight:650">15 contratos con 3 implementaciones. Polimorfismo por interfaz.</p>
      </a>
    </div>
  </article>

  <script is:inline>
    (function () {
      const KEY = 'aprende_poo_basico_v1';
      const readStore = () => {
        try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; }
      };
      const writeStore = (s) => localStorage.setItem(KEY, JSON.stringify(s));
      const updateProgressFor = (exId) => {
        const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
        if (!card) return;
        const boxes = card.querySelectorAll('input[type="checkbox"][data-check-id]');
        const done = Array.from(boxes).filter((b) => b.checked).length;
        const total = boxes.length;
        const els = card.querySelectorAll('[data-progress-for="' + exId + '"]');
        els.forEach((el) => {
          el.textContent = done + ' / ' + total;
          el.classList.toggle('is-done', done === total && total > 0);
        });
      };
      document.querySelectorAll('.ex-card[data-ex-id]').forEach((card) => {
        const exId = card.getAttribute('data-ex-id');
        const perEx = (readStore()[exId]) || {};
        card.querySelectorAll('input[type="checkbox"][data-check-id]').forEach((input) => {
          const checkId = input.getAttribute('data-check-id');
          input.checked = Boolean(perEx[checkId]);
          input.addEventListener('click', (e) => e.stopPropagation());
          input.addEventListener('change', () => {
            const s = readStore();
            if (!s[exId]) s[exId] = {};
            s[exId][checkId] = input.checked;
            writeStore(s);
            updateProgressFor(exId);
          });
        });
        updateProgressFor(exId);
      });
      const modal = document.getElementById('pooLessonsModal');
      const openBtn = document.getElementById('openPooLessonsModal');
      let lastFocus = null;
      const openModal = () => {
        if (!modal) return;
        lastFocus = document.activeElement;
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.documentElement.style.overflow = 'hidden';
        const closeBtn = modal.querySelector('.poo-modal-close');
        if (closeBtn) closeBtn.focus();
      };
      const closeModal = () => {
        if (!modal) return;
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.documentElement.style.overflow = '';
        if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
      };
      openBtn?.addEventListener('click', openModal);
      modal?.querySelectorAll('[data-close-poo-modal]').forEach((el) => el.addEventListener('click', closeModal));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal?.classList.contains('is-open')) closeModal(); });
      document.getElementById('expandAll')?.addEventListener('click', () => {
        document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = true));
      });
      document.getElementById('collapseAll')?.addEventListener('click', () => {
        document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = false));
      });
      const openFromHash = () => {
        const hash = location.hash.replace(/^#/, '');
        if (!hash) return;
        const target = document.getElementById(hash);
        if (target && target.classList.contains('ex-card') && 'open' in target) {
          target.open = true;
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };
      window.addEventListener('hashchange', openFromHash);
      if (location.hash) setTimeout(openFromHash, 80);
    })();
  </script>

  <style>
    .kicker{margin:0; font-size:0.7rem; font-weight:900; letter-spacing:0.16em; text-transform:uppercase; color:#7c2d12}
    .muted{color:var(--text-muted); font-weight:650; line-height:1.6}
    .poo-lessons-trigger-wrap{margin:1.25rem 0 1.1rem}
    .poo-lessons-trigger{width:100%; display:flex; align-items:center; gap:0.9rem; text-align:left; cursor:pointer; border:3px solid var(--border); border-radius:18px; background:rgba(255,255,255,0.92); padding:1rem 1rem 1rem 0.95rem; box-shadow:0 16px 34px rgba(30,18,16,0.08); transition:transform 0.14s, box-shadow 0.14s, background 0.14s; font:inherit; color:inherit}
    .poo-lessons-trigger:hover{transform:translateY(-2px); box-shadow:0 20px 40px rgba(30,18,16,0.12); background:#fff}
    .poo-trigger-icon{flex-shrink:0; width:44px; height:44px; display:grid; place-items:center; background:#1E1210; color:#fff8ee; border:2px solid #1e1210; border-radius:14px; font-size:1.2rem; box-shadow:3px 3px 0 rgba(30,18,16,0.14)}
    .poo-trigger-text{flex:1; min-width:0; display:flex; flex-direction:column; gap:0.12rem}
    .poo-trigger-kicker{font-size:0.66rem; font-weight:900; letter-spacing:0.14em; text-transform:uppercase; color:#7c2d12; font-family:'Nunito',sans-serif}
    .poo-trigger-title{font-family:'Nunito',sans-serif; font-weight:900; font-size:1.18rem; line-height:1.2; color:#7c2d12}
    .poo-trigger-sub{font-size:0.86rem; font-weight:650; color:var(--text-secondary); line-height:1.45; display:-webkit-box; -webkit-line-clamp:2; line-clamp:2; -webkit-box-orient:vertical; overflow:hidden}
    .poo-trigger-badge{flex-shrink:0; background:#1e1210; color:#fff8ee; border:2px solid #1e1210; border-radius:999px; padding:0.32rem 0.65rem; font-family:'Nunito',sans-serif; font-weight:900; font-size:0.72rem; white-space:nowrap; box-shadow:2px 2px 0 rgba(30,18,16,0.12)}
    .poo-trigger-cta{flex-shrink:0; display:inline-flex; align-items:center; gap:0.3rem; background:#06d6a0; color:#1e1210; border:2px solid #1e1210; border-radius:999px; padding:0.42rem 0.78rem; font-family:'Nunito',sans-serif; font-weight:900; font-size:0.8rem; box-shadow:3px 3px 0 #1e1210}
    .poo-modal{position:fixed; inset:0; z-index:1000; display:none; align-items:center; justify-content:center; padding:1rem}
    .poo-modal.is-open{display:flex}
    .poo-modal-backdrop{position:absolute; inset:0; background:rgba(30,18,16,0.5); backdrop-filter:blur(6px)}
    .poo-modal-panel{position:relative; width:min(100%,860px); max-height:min(86vh,820px); overflow:auto; background:#fffdf7; border:3px solid #1e1210; border-radius:20px; box-shadow:8px 8px 0 #1e1210; padding:1.15rem}
    .poo-modal-header{display:flex; gap:1rem; align-items:flex-start; justify-content:space-between; margin-bottom:1rem; padding-bottom:0.9rem; border-bottom:2px dashed rgba(30,18,16,0.14); position:sticky; top:0; background:#fffdf7; z-index:1}
    .poo-modal-kicker{margin:0; font-size:0.66rem; font-weight:900; letter-spacing:0.14em; text-transform:uppercase; color:#7c2d12; font-family:'Nunito',sans-serif}
    .poo-modal-header h2{margin:0.15rem 0 0.25rem; color:#7c2d12; font-size:1.35rem; line-height:1.2}
    .poo-modal-sub{margin:0; font-size:0.88rem; font-weight:650; color:var(--text-secondary); line-height:1.5}
    .poo-modal-close{flex-shrink:0; width:36px; height:36px; border-radius:999px; border:2px solid #1e1210; background:#fff; color:#1e1210; font-weight:900; cursor:pointer; box-shadow:2px 2px 0 #1e1210}
    .poo-lessons-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:0.85rem}
    .lesson-card{display:flex; flex-direction:column; gap:0.45rem; text-decoration:none; background:#fff; border:3px solid var(--border); border-left-width:5px; border-left-color:var(--lc,var(--border)); border-radius:16px; padding:0.9rem 0.95rem 0.85rem; box-shadow:4px 4px 0 rgba(30,18,16,0.1); transition:transform 0.15s, box-shadow 0.15s, background 0.15s; min-height:112px}
    .lesson-card:hover{transform:translateY(-2px); box-shadow:6px 8px 0 rgba(30,18,16,0.12); background:#fffdf7}
    .lesson-dot{width:10px; height:10px; border-radius:999px; flex-shrink:0}
    .lesson-pill{display:inline-flex; align-items:center; gap:0.32rem; font-family:'Nunito',sans-serif; font-weight:900; font-size:0.72rem; letter-spacing:0.02em; border:2px solid; border-radius:999px; padding:0.18rem 0.55rem; line-height:1}
    .lesson-arrow{margin-left:auto; width:28px; height:28px; display:grid; place-items:center; border-radius:999px; background:var(--lc,#1e1210); color:#fff; font-weight:900; font-size:0.95rem; flex-shrink:0; border:2px solid #1e1210; box-shadow:2px 2px 0 rgba(30,18,16,0.12)}
    .lesson-card-title{font-family:'Nunito',sans-serif; font-weight:900; font-size:0.97rem; line-height:1.35; color:var(--text-primary)}
    .lesson-card-cta{margin-top:auto; display:inline-flex; align-items:center; gap:0.3rem; font-family:'Nunito',sans-serif; font-weight:900; font-size:0.78rem; color:var(--lc,var(--text-primary))}
    .lesson-card-top{display:flex; align-items:center; gap:0.5rem}
    .exercise-toolbar{display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:0.75rem; margin:0.9rem 0 0.75rem}
    .exercise-toolbar-hint{margin:0; font-family:'Nunito',sans-serif; font-weight:800; font-size:0.85rem; color:var(--text-muted)}
    .exercise-toolbar-actions{display:flex; gap:0.5rem; flex-wrap:wrap}
    .toolbar-btn{appearance:none; border:2px solid #1e1210; background:#06d6a0; color:#fff; font-family:'Nunito',sans-serif; font-weight:900; font-size:0.82rem; padding:0.42rem 0.85rem; border-radius:999px; cursor:pointer; box-shadow:3px 3px 0 #1e1210}
    .toolbar-btn--ghost{background:#fff; color:#1e1210}
    .exercise-list{display:flex; flex-direction:column; gap:0.85rem; margin-top:0.25rem}
    .ex-card{border:3px solid var(--border); border-radius:18px; background:rgba(255,255,255,0.82); box-shadow:0 16px 34px rgba(30,18,16,0.08); scroll-margin-top:1.25rem; overflow:hidden}
    .ex-card[open]{background:#fff}
    .ex-summary{display:flex; align-items:center; gap:0.75rem; padding:0.85rem 0.9rem; cursor:pointer; list-style:none; user-select:none}
    .ex-summary::-webkit-details-marker{display:none}
    .ex-num{flex-shrink:0; width:38px; height:38px; display:grid; place-items:center; background:#1e1210; color:#fff8ee; border:2px solid #1e1210; border-radius:12px; font-family:'Nunito',sans-serif; font-weight:900; font-size:0.82rem; box-shadow:2px 2px 0 rgba(30,18,16,0.14)}
    .ex-card[open] .ex-num{background:#7c2d12}
    .ex-summary-main{flex:1; min-width:0}
    .ex-summary-main h3{margin:0; color:#7c2d12; font-size:1.02rem; line-height:1.25; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
    .ex-summary-meta{display:block; margin-top:0.1rem; font-family:'JetBrains Mono',monospace; font-size:0.7rem; font-weight:700; color:var(--text-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
    .ex-progress{flex-shrink:0; font-family:'Nunito',sans-serif; font-weight:900; font-size:0.78rem; color:#1e1210; background:#fff9c4; border:2px solid #1e1210; border-radius:999px; padding:0.2rem 0.55rem; min-width:74px; text-align:center; box-shadow:2px 2px 0 rgba(30,18,16,0.1)}
    .ex-progress.is-done{background:#06d6a0; color:#fff}
    .ex-chevron{flex-shrink:0; width:32px; height:32px; display:grid; place-items:center; background:#fff; border:2px solid #1e1210; border-radius:999px; box-shadow:2px 2px 0 rgba(30,18,16,0.1); transition:transform 0.2s, background 0.2s; color:#1e1210}
    .ex-card[open] .ex-chevron{transform:rotate(180deg); background:#ffd166}
    .ex-body{padding:0.9rem 1.1rem 1rem; border-top:2px dashed rgba(30,18,16,0.12); background:rgba(255,255,255,0.35)}
    .ex-statement,.ex-task{margin:0 0 0.55rem; color:var(--text-secondary); font-weight:650; line-height:1.55}
    .ex-checks{display:grid; gap:0.35rem; margin-top:0.9rem}
    .chk{display:flex; align-items:center; gap:0.6rem; color:var(--text-secondary); font-weight:650}
    .chk input{width:18px; height:18px; accent-color:var(--success)}
    @media(max-width:640px){.ex-summary{gap:0.6rem; padding:0.75rem} .ex-num{width:34px; height:34px}}
  </style>
</Layout>
