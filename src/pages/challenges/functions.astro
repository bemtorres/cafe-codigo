---
import Layout from '../../layouts/Layout.astro';

const exercises = [
  // SECCIÓN 1: SIN PARÁMETROS Y SIN RETORNO (10 EJERCICIOS)
  { id: 1, section: '1. Sin Parámetros y Sin Retorno', title: 'Mostrar un saludo simple', statement: 'Crear una función saludar() que imprima "¡Hola, bienvenido al curso de programación!" por pantalla sin recibir parámetros ni retornar valores.' },
  { id: 2, section: '1. Sin Parámetros y Sin Retorno', title: 'Mostrar datos de un curso', statement: 'Crear una función mostrarInfoCurso() que imprima el nombre del curso, duración y profesor responsable.' },
  { id: 3, section: '1. Sin Parámetros y Sin Retorno', title: 'Mostrar mensaje de bienvenida', statement: 'Crear una función mostrarBienvenida() que imprima un encabezado decorado con asterisco o guiones para el sistema.' },
  { id: 4, section: '1. Sin Parámetros y Sin Retorno', title: 'Mostrar tabla del 5', statement: 'Crear una función mostrarTablaDelCinco() que utilice un bucle for interno para imprimir la tabla de multiplicar del 5 (del 1 al 10).' },
  { id: 5, section: '1. Sin Parámetros y Sin Retorno', title: 'Mostrar números del 1 al 10', statement: 'Crear una función contarHastaDiez() que imprima secuencialmente los números enteros del 1 al 10.' },
  { id: 6, section: '1. Sin Parámetros y Sin Retorno', title: 'Mostrar números pares del 1 al 20', statement: 'Crear una función mostrarPares() que recorra los enteros del 1 al 20 e imprima únicamente aquellos que sean pares.' },
  { id: 7, section: '1. Sin Parámetros y Sin Retorno', title: 'Mostrar menú principal', statement: 'Crear una función mostrarMenuPrincipal() que imprima un menú con 4 opciones (1. Iniciar, 2. Cargar, 3. Opciones, 4. Salir).' },
  { id: 8, section: '1. Sin Parámetros y Sin Retorno', title: 'Mostrar menú de opciones', statement: 'Crear una función mostrarOpcionesConfiguracion() que presente opciones de ajuste (Idioma, Tema, Sonido, Volver).' },
  { id: 9, section: '1. Sin Parámetros y Sin Retorno', title: 'Mostrar información de un producto', statement: 'Crear una función mostrarProductoEjemplo() que imprima la ficha de un producto (Nombre, Código, Precio ficticio).' },
  { id: 10, section: '1. Sin Parámetros y Sin Retorno', title: 'Mostrar menú completo de sistema', statement: 'Crear una función mostrarMenuSistema() que imprima el encabezado del sistema, fecha ficticia y 5 opciones operativas.' },

  // SECCIÓN 2: CON PARÁMETROS Y SIN RETORNO (10 EJERCICIOS)
  { id: 11, section: '2. Con Parámetros y Sin Retorno', title: 'Saludar a una persona', statement: 'Crear una función saludarPersona(nombre) que reciba un nombre como parámetro e imprima "Hola [nombre], ¿cómo estás?".' },
  { id: 12, section: '2. Con Parámetros y Sin Retorno', title: 'Mostrar nombre completo', statement: 'Crear una función mostrarNombreCompleto(nombre, apellido) que reciba dos cadenas e imprima el nombre formateado.' },
  { id: 13, section: '2. Con Parámetros y Sin Retorno', title: 'Mostrar edad y estado', statement: 'Crear una función mostrarEdad(edad) que reciba la edad e imprima "Tienes X años" indicando si es mayor o menor de edad.' },
  { id: 14, section: '2. Con Parámetros y Sin Retorno', title: 'Mostrar ficha de producto', statement: 'Crear una función mostrarDetalleProducto(nombre, precio) que imprima el nombre del producto y su costo.' },
  { id: 15, section: '2. Con Parámetros y Sin Retorno', title: 'Mostrar precio con IVA incluido', statement: 'Crear una función mostrarPrecioConIVA(precioNeto) que calcule el 19% de IVA e imprima el desglose neto y total.' },
  { id: 16, section: '2. Con Parámetros y Sin Retorno', title: 'Tabla de multiplicar de N', statement: 'Crear una función mostrarTabla(numero) que reciba un entero N e imprima su tabla de multiplicar completa del 1 al 10.' },
  { id: 17, section: '2. Con Parámetros y Sin Retorno', title: 'Mostrar números hasta N', statement: 'Crear una función contarHastaN(limite) que imprima los números desde el 1 hasta el valor límite pasado por parámetro.' },
  { id: 18, section: '2. Con Parámetros y Sin Retorno', title: 'Mostrar números pares hasta N', statement: 'Crear una función mostrarParesHastaN(limite) que imprima los pares comprendidos entre 1 y N.' },
  { id: 19, section: '2. Con Parámetros y Sin Retorno', title: 'Mostrar ficha de alumno', statement: 'Crear una función mostrarAlumno(nombre, edad, carrera) que reciba tres parámetros e imprima su ficha académica.' },
  { id: 20, section: '2. Con Parámetros y Sin Retorno', title: 'Mostrar factura de compra', statement: 'Crear una función mostrarFactura(cliente, total, descuento) e imprimir el comprobante desglosado.' },

  // SECCIÓN 3: SIN PARÁMETROS Y CON RETORNO (10 EJERCICIOS)
  { id: 21, section: '3. Sin Parámetros y Con Retorno', title: 'Obtener un número fijo', statement: 'Crear una función obtenerNumeroMagico() que no reciba parámetros y retorne el valor entero 42.' },
  { id: 22, section: '3. Sin Parámetros y Con Retorno', title: 'Obtener nombre de la aplicación', statement: 'Crear una función obtenerNombreApp() que retorne la cadena "Café y Código v2.0".' },
  { id: 23, section: '3. Sin Parámetros y Con Retorno', title: 'Obtener valor de PI', statement: 'Crear una función obtenerPi() que retorne el valor flotante 3.14159265.' },
  { id: 24, section: '3. Sin Parámetros y Con Retorno', title: 'Obtener número aleatorio (1-100)', statement: 'Crear una función obtenerNumeroAleatorio() que genere y retorne un entero entre 1 y 100.' },
  { id: 25, section: '3. Sin Parámetros y Con Retorno', title: 'Obtener año actual', statement: 'Crear una función obtenerAnioActual() que retorne el año en curso como entero.' },
  { id: 26, section: '3. Sin Parámetros y Con Retorno', title: 'Obtener estado del servidor', statement: 'Crear una función obtenerEstadoServidor() que retorne el booleano true.' },
  { id: 27, section: '3. Sin Parámetros y Con Retorno', title: 'Obtener tasa de impuesto estándar', statement: 'Crear una función obtenerTasaIVA() que retorne el decimal 0.19.' },
  { id: 28, section: '3. Sin Parámetros y Con Retorno', title: 'Obtener mensaje del día', statement: 'Crear una función obtenerMensajeDelDia() que retorne una frase motivacional en cadena de texto.' },
  { id: 29, section: '3. Sin Parámetros y Con Retorno', title: 'Obtener código secreto por defecto', statement: 'Crear una función obtenerCodigoSecreto() que retorne la cadena "ADM-2026".' },
  { id: 30, section: '3. Sin Parámetros y Con Retorno', title: 'Obtener selección por defecto de menú', statement: 'Crear una función obtenerOpcionPorDefecto() que retorne el entero 1.' },

  // SECCIÓN 4: CON PARÁMETROS Y CON RETORNO (20 EJERCICIOS CENTRALES)
  { id: 31, section: '4. Con Parámetros y Con Retorno', title: 'Sumar dos números', statement: 'Crear una función sumar(a, b) que reciba dos números y retorne la suma de ambos.' },
  { id: 32, section: '4. Con Parámetros y Con Retorno', title: 'Restar dos números', statement: 'Crear una función restar(a, b) que reciba dos números y retorne la diferencia.' },
  { id: 33, section: '4. Con Parámetros y Con Retorno', title: 'Multiplicar dos números', statement: 'Crear una función multiplicar(a, b) que reciba dos valores y retorne su producto.' },
  { id: 34, section: '4. Con Parámetros y Con Retorno', title: 'Dividir dos números con validación', statement: 'Crear una función dividir(a, b) que retorne el cociente a/b, o 0 si b es cero.' },
  { id: 35, section: '4. Con Parámetros y Con Retorno', title: 'Calcular promedio de tres notas', statement: 'Crear una función calcularPromedio(n1, n2, n3) que retorne el promedio aritmético de las tres notas.' },
  { id: 36, section: '4. Con Parámetros y Con Retorno', title: 'Determinar el mayor de dos números', statement: 'Crear una función obtenerMayor(a, b) que retorne el número más alto entre a y b.' },
  { id: 37, section: '4. Con Parámetros y Con Retorno', title: 'Determinar el menor de dos números', statement: 'Crear una función obtenerMenor(a, b) que retorne el menor de dos valores.' },
  { id: 38, section: '4. Con Parámetros y Con Retorno', title: 'Es número par (Booleano)', statement: 'Crear una función esPar(numero) que retorne true si el número es par o false en caso contrario.' },
  { id: 39, section: '4. Con Parámetros y Con Retorno', title: 'Es número positivo (Booleano)', statement: 'Crear una función esPositivo(numero) que retorne true si numero > 0 o false en caso contrario.' },
  { id: 40, section: '4. Con Parámetros y Con Retorno', title: 'Convertir Celsius a Fahrenheit', statement: 'Crear una función convertirCelsiusAFahrenheit(celsius) que retorne (celsius * 9/5) + 32.' },
  { id: 41, section: '4. Con Parámetros y Con Retorno', title: 'Calcular descuento de compra', statement: 'Crear una función calcularDescuento(monto, porcentaje) que retorne el valor del descuento aplicado.' },
  { id: 42, section: '4. Con Parámetros y Con Retorno', title: 'Calcular valor final con IVA', statement: 'Crear una función calcularTotalConIVA(montoNeto) que retorne montoNeto * 1.19.' },
  { id: 43, section: '4. Con Parámetros y Con Retorno', title: 'Validar si es mayor de edad', statement: 'Crear una función esMayorDeEdad(edad) que retorne true si edad >= 18.' },
  { id: 44, section: '4. Con Parámetros y Con Retorno', title: 'Validar longitud de contraseña', statement: 'Crear una función esClaveSegura(clave) que retorne true si la longitud de la clave es mayor o igual a 8 caracteres.' },
  { id: 45, section: '4. Con Parámetros y Con Retorno', title: 'Buscar valor en arreglo', statement: 'Crear una función buscarEnArreglo(arreglo, valor) que retorne true si valor se encuentra en el arreglo.' },
  { id: 46, section: '4. Con Parámetros y Con Retorno', title: 'Contar pares en un arreglo', statement: 'Crear una función contarParesArreglo(arreglo) que recorra el arreglo y retorne la cantidad total de pares.' },
  { id: 47, section: '4. Con Parámetros y Con Retorno', title: 'Encontrar el mayor de un arreglo', statement: 'Crear una función obtenerMayorArreglo(arreglo) que retorne el valor numérico máximo del arreglo.' },
  { id: 48, section: '4. Con Parámetros y Con Retorno', title: 'Encontrar el menor de un arreglo', statement: 'Crear una función obtenerMenorArreglo(arreglo) que retorne el valor mínimo de un arreglo.' },
  { id: 49, section: '4. Con Parámetros y Con Retorno', title: 'Calcular promedio de un arreglo', statement: 'Crear una función calcularPromedioArreglo(arreglo) que sume sus elementos y retorne su promedio.' },
  { id: 50, section: '4. Con Parámetros y Con Retorno', title: 'Filtrar mayores a un umbral', statement: 'Crear una función filtrarMayores(arreglo, umbral) que retorne una nueva lista con los números mayores al umbral.' },
];
---

<Layout
  title="Funciones y Métodos — Parámetros y Retorno (50 Desafíos)"
  description="Domina el diseño de funciones y métodos: sin/con parámetros, sin/con retorno y lógica de modularización."
>
  <article class="content-section max-w-5xl mx-auto px-4 py-6">

    <!-- HEADER DE LA PÁGINA -->
    <div class="mb-6 pb-4 border-b-2 border-dashed border-[#1E1210]/15">
      <div class="flex items-center gap-2 mb-1">
        <a href="/challenges/" class="text-xs font-nunito font-extrabold text-[#0284c7] no-underline hover:underline">← Volver al Catálogo</a>
        <span class="text-slate-300">•</span>
        <span class="text-xs font-nunito font-extrabold uppercase tracking-widest text-[#0284c7]">Módulo 05 · Modularización</span>
      </div>
      <h1 class="m-0 text-2xl sm:text-3xl font-nunito font-black text-[#1E1210]">
        Funciones y Métodos (Parámetros y Retorno)
      </h1>
      <p class="mt-2 text-sm text-slate-600 font-medium leading-relaxed">
        50 desafíos progresivos ordenados en 4 niveles de modularización: sin/con parámetros y sin/con declaración de <code>return</code>. Válido en <strong>Python, Java, C#, C++, JS, PHP y PSeInt</strong>.
      </p>
    </div>

    <!-- CONTROLES -->
    <div class="mb-6 flex flex-col sm:flex-row items-center justify-between gap-4 bg-sky-50/60 p-4 rounded-2xl border-2 border-[#1E1210]">
      <div class="w-full sm:w-auto">
        <span class="text-xs font-nunito font-black text-sky-900 uppercase tracking-wider block">🔍 Filtro de búsqueda</span>
        <input
          type="text"
          id="searchBox"
          placeholder="Buscar función por nombre o tipo..."
          class="mt-1 w-full sm:w-80 px-3 py-2 rounded-xl border-2 border-[#1E1210] font-nunito font-bold text-xs bg-white focus:outline-none focus:ring-2 focus:ring-sky-500"
        />
      </div>
      <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
        <button type="button" id="expandAll" class="px-3.5 py-2 rounded-xl border-2 border-[#1E1210] bg-[#1E1210] text-white font-nunito font-black text-xs cursor-pointer shadow-[2px_2px_0px_#1E1210] hover:-translate-y-0.5">Expandir todos (50)</button>
        <button type="button" id="collapseAll" class="px-3.5 py-2 rounded-xl border-2 border-[#1E1210] bg-white text-[#1E1210] font-nunito font-black text-xs cursor-pointer shadow-[2px_2px_0px_#1E1210] hover:-translate-y-0.5">Colapsar todos</button>
      </div>
    </div>

    <!-- LISTADO RÁPIDO DE 50 EJERCICIOS -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-3 border-b-2 border-[#1E1210] pb-2">
        <h2 class="text-base font-nunito font-black text-[#1E1210] m-0 flex items-center gap-2">
          <span>📋</span> Listado Rápido de Funciones (1 al 50)
        </h2>
        <span class="text-xs font-nunito font-bold bg-sky-100 text-sky-800 px-2.5 py-0.5 rounded-full border border-sky-300">50 ítems</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-2" id="quickList">
        {exercises.map((ex) => (
          <div class="quick-item search-target" data-keywords={`${ex.title} ${ex.section}`.toLowerCase()} data-quick-id={`fn-${ex.id}`}>
            <label class="flex items-center cursor-pointer p-0.5 shrink-0" title="Marcar como completado">
              <input type="checkbox" data-complete-id={`fn-${ex.id}`} class="w-4 h-4 accent-sky-600 rounded cursor-pointer" />
            </label>
            <a href={`#fn-${ex.id}`} class="quick-link flex items-center gap-2.5 flex-1 min-w-0 no-underline text-inherit">
              <span class="quick-num">{String(ex.id).padStart(2, '0')}</span>
              <span class="quick-title">{ex.title}</span>
              <span class="quick-badge-done hidden text-[0.65rem] font-bold bg-sky-100 text-sky-800 px-1.5 py-0.5 rounded border border-sky-300">✓ Hecho</span>
              <span class="quick-arrow">↓</span>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- RESOLUCIÓN GUIADA CON CHECKLISTS -->
    <section class="mb-8">
      <div class="flex items-center justify-between mb-4 border-b-2 border-[#1E1210] pb-2">
        <h2 class="text-base font-nunito font-black text-[#1E1210] m-0 flex items-center gap-2">
          <span>🎯</span> Resolución Guiada y Checklists de Progreso
        </h2>
      </div>

      <div id="exerciseList" class="flex flex-col gap-3">
        {exercises.map((ex) => (
          <details class="ex-card border-2 border-[#1E1210] bg-white rounded-2xl p-4 shadow-[3px_3px_0px_#1E1210] search-target transition-all" id={`fn-${ex.id}`} data-ex-id={`fn-${ex.id}`} data-keywords={`${ex.title} ${ex.section}`.toLowerCase()}>
            <summary class="ex-summary flex items-center justify-between cursor-pointer font-nunito font-black select-none">
              <div class="flex items-center gap-3 pr-2 min-w-0">
                <span class="ex-num w-8 h-8 rounded-xl bg-[#0284c7] text-white flex items-center justify-center text-xs shrink-0">{String(ex.id).padStart(2, '0')}</span>
                <div class="truncate">
                  <span class="text-[0.68rem] text-sky-700 font-extrabold uppercase block leading-tight">{ex.section}</span>
                  <h3 class="m-0 text-sm sm:text-base text-[#1E1210] truncate flex items-center gap-2">
                    <span>{ex.id}. {ex.title}</span>
                    <span class="card-done-tag hidden text-xs font-bold text-sky-700 bg-sky-100 px-2 py-0.5 rounded-md border border-sky-300">✓ Completado</span>
                  </h3>
                </div>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <label class="flex items-center gap-1.5 text-xs font-extrabold bg-sky-50 hover:bg-sky-100 text-sky-900 px-2.5 py-1 rounded-lg border border-sky-200 cursor-pointer" onclick="event.stopPropagation()">
                  <input type="checkbox" data-complete-id={`fn-${ex.id}`} class="w-4 h-4 accent-sky-600 rounded cursor-pointer" />
                  <span>Completado</span>
                </label>
                <span class="ex-progress text-xs font-bold text-slate-500 bg-slate-100 px-2 py-1 rounded-lg border border-slate-200" data-progress-for={`fn-${ex.id}`}>0 / 5</span>
              </div>
            </summary>

            <div class="ex-body mt-3 pt-3 border-t border-slate-200">
              <p class="ex-statement font-quicksand font-bold text-sm text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-200">
                <strong>Enunciado:</strong> {ex.statement}
              </p>

              <div class="ex-checks flex flex-col gap-2 mt-3 text-xs font-nunito font-extrabold">
                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-sky-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="firma" class="w-4 h-4 accent-sky-600 rounded" />
                  <span>1. Declaré la firma de la función/método con el nombre y parámetros requeridos</span>
                </label>

                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-sky-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="param" class="w-4 h-4 accent-sky-600 rounded" />
                  <span>2. Pasé e identifiqué los parámetros de entrada dentro de la función</span>
                </label>

                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-sky-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="proceso" class="w-4 h-4 accent-sky-600 rounded" />
                  <span>3. Implementé el cuerpo del algoritmo o cálculo modularizado</span>
                </label>

                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-sky-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="retorno" class="w-4 h-4 accent-sky-600 rounded" />
                  <span>4. Retorné el valor con <code>return</code> (o imprimí si era sin retorno)</span>
                </label>

                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-sky-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="invocacion" class="w-4 h-4 accent-sky-600 rounded" />
                  <span>5. Invoqué la función desde el programa principal y verifiqué la salida</span>
                </label>
              </div>
            </div>
          </details>
        ))}
      </div>
    </section>

  </article>

  <!-- SCRIPT DE LOCALSTORAGE Y SINCRONIZACIÓN -->
  <script is:inline>
    (function () {
      const KEY = 'aprende_funciones_metodos_v1';
      const readStore = () => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } };
      const writeStore = (s) => localStorage.setItem(KEY, JSON.stringify(s));

      const syncCompleteStatus = (exId, isCompleted) => {
        document.querySelectorAll('input[data-complete-id="' + exId + '"]').forEach((chk) => { chk.checked = isCompleted; });
        const quickItem = document.querySelector('.quick-item[data-quick-id="' + exId + '"]');
        if (quickItem) {
          const badge = quickItem.querySelector('.quick-badge-done');
          if (isCompleted) {
            quickItem.classList.add('is-completed');
            if (badge) badge.classList.remove('hidden');
          } else {
            quickItem.classList.remove('is-completed');
            if (badge) badge.classList.add('hidden');
          }
        }
        const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
        if (card) {
          const tag = card.querySelector('.card-done-tag');
          if (isCompleted) {
            card.classList.add('border-sky-500', 'bg-sky-50/30');
            if (tag) tag.classList.remove('hidden');
          } else {
            card.classList.remove('border-sky-500', 'bg-sky-50/30');
            if (tag) tag.classList.add('hidden');
          }
        }
      };

      const updateProgressFor = (exId) => {
        const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
        if (!card) return;
        const boxes = card.querySelectorAll('input[type="checkbox"][data-check-id]');
        const done = Array.from(boxes).filter((b) => b.checked).length;
        const total = boxes.length;
        const els = card.querySelectorAll('[data-progress-for="' + exId + '"]');
        els.forEach((el) => {
          el.textContent = done + ' / ' + total;
          if (done === total && total > 0) {
            el.classList.add('bg-sky-600', 'text-white');
            el.classList.remove('bg-slate-100', 'text-slate-500');
          } else {
            el.classList.remove('bg-sky-600', 'text-white');
            el.classList.add('bg-slate-100', 'text-slate-500');
          }
        });

        const store = readStore();
        if (done === total && total > 0) {
          if (!store[exId]) store[exId] = {};
          store[exId]['__completed__'] = true;
          writeStore(store);
          syncCompleteStatus(exId, true);
        }
      };

      document.querySelectorAll('.ex-card[data-ex-id]').forEach((card) => {
        const exId = card.getAttribute('data-ex-id');
        const perEx = (readStore()[exId]) || {};
        card.querySelectorAll('input[type="checkbox"][data-check-id]').forEach((input) => {
          const checkId = input.getAttribute('data-check-id');
          input.checked = Boolean(perEx[checkId]);
          input.addEventListener('click', (e) => e.stopPropagation());
          input.addEventListener('change', () => {
            const s = readStore();
            if (!s[exId]) s[exId] = {};
            s[exId][checkId] = input.checked;
            writeStore(s);
            updateProgressFor(exId);
          });
        });
        updateProgressFor(exId);
        syncCompleteStatus(exId, Boolean(perEx['__completed__']));
      });

      document.querySelectorAll('input[data-complete-id]').forEach((chk) => {
        chk.addEventListener('change', () => {
          const exId = chk.getAttribute('data-complete-id');
          const isDone = chk.checked;
          const s = readStore();
          if (!s[exId]) s[exId] = {};
          s[exId]['__completed__'] = isDone;

          const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
          if (card) {
            card.querySelectorAll('input[type="checkbox"][data-check-id]').forEach((box) => {
              box.checked = isDone;
              const checkId = box.getAttribute('data-check-id');
              s[exId][checkId] = isDone;
            });
          }

          writeStore(s);
          syncCompleteStatus(exId, isDone);
          updateProgressFor(exId);
        });
      });

      document.getElementById('expandAll')?.addEventListener('click', () => {
        document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = true));
      });
      document.getElementById('collapseAll')?.addEventListener('click', () => {
        document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = false));
      });

      const searchBox = document.getElementById('searchBox');
      if (searchBox) {
        searchBox.addEventListener('input', (e) => {
          const q = e.target.value.toLowerCase().trim();
          document.querySelectorAll('.search-target').forEach((el) => {
            const kw = el.getAttribute('data-keywords') || '';
            const txt = el.textContent.toLowerCase();
            el.style.display = (txt.includes(q) || kw.includes(q)) ? '' : 'none';
          });
        });
      }
    })();
  </script>

