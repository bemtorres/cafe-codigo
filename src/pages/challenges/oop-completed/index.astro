---
import Layout from '../../../layouts/Layout.astro';
import MermaidDiagram from '../../../components/challenges/MermaidDiagram.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import { pooCompletedChallenges, toMermaidCompleted } from '../../../data/pooCompletedChallenges';
import { generateJavaCode, generatePythonCode, generateCsharpCode, generateCppCode } from '../../../lib/pooCodeGenerators';

const totalChallenges = pooCompletedChallenges.length;
---

<Layout
  title="Taller Práctico de POO Completa — 25 Desafíos Avanzados"
  description="25 ejercicios de Programación Orientada a Objetos en Java con la estructura estricta: 1 Padre + 3 Hijas + 1 Interfaz + 1 Clase Externa + 1 Propia."
>
  <article class="content-section">
    <p class="kicker">POO Completa y Arquitectura</p>
    <h1>Desafíos de POO Completa</h1>
    <p>
      25 sistemas reales diseñados con la <strong>estructura técnica estricta</strong>: 
      <strong>1 Clase Padre + 3 Clases Hijas + 1 Interfaz + 1 Clase Externa (Composición) + 1 Clase con comportamiento propio</strong>. 
      Cada desafío incluye su <strong>Diagrama UML interactivo</strong> y su <strong>solución completa en Java protegida por clave</strong>.
    </p>
    <p class="muted">
      Ruta canónica: <code>/challenges/oop-completed</code> · Progreso guardado como <code>aprende_poo_completed_challenges_v1</code> en este navegador.
    </p>

    <!-- Banner Neobrutalista de Reglas de Arquitectura -->
    <div class="rules-card">
      <div class="rules-card-header">
        <span class="rules-badge">ESTRUCTURA TÉCNICA ESTRICTA</span>
        <h3>🏛️ Reglas Arquitectónicas de cada Desafío</h3>
      </div>
      <ul class="rules-grid">
        <li><strong>1. Clase Padre Abstracta:</strong> Modela la abstracción raíz con estado común y métodos polimórficos. <em>(La clase padre NO implementa la interfaz)</em>.</li>
        <li><strong>2. Herencia Desacoplada:</strong> 3 Clases Hijas que extienden del padre. Cada hija atiende un caso de uso específico.</li>
        <li><strong>3. Interfaz Específica (Hija 3):</strong> Únicamente la 3ra clase hija implementa la Interfaz de contrato. Las demás hijas y el padre quedan libres de esa carga.</li>
        <li><strong>4. Composición (Hija 2):</strong> La 2da clase hija contiene por composición una instancia de la Clase Externa independiente.</li>
        <li><strong>5. Especialización Propia (Hija 1):</strong> La 1ra clase hija define atributos y métodos de negocio propios exclusivos.</li>
        <li><strong>6. Main y Polimorfismo:</strong> Prueba polimórfica en colección de tipo Padre y ejecución del contrato de interfaz.</li>
      </ul>
      <div class="arch-warning-note">
        💡 <strong>Principio de Segregación de Interfaces (ISP):</strong> La Interfaz nunca se asocia a la Clase Padre para no obligar a todas las clases hijas a implementar métodos innecesarios. Se asocia exclusivamente a la clase hija que requiere dicho contrato.
      </div>
    </div>

    <!-- Barra de Herramientas -->
    <div class="exercise-toolbar">
      <p class="exercise-toolbar-hint">{totalChallenges} desafíos con arquitectura completa · clic para expandir diagrama y checklist</p>
      <div class="exercise-toolbar-actions">
        <button type="button" id="expandAll" class="toolbar-btn">Expandir todo</button>
        <button type="button" id="collapseAll" class="toolbar-btn toolbar-btn--ghost">Colapsar todo</button>
      </div>
    </div>

    <!-- Lista de Desafíos Neobrutalistas -->
    <div id="exerciseList" class="exercise-list">
      {pooCompletedChallenges.map((ch) => {
        const metaText = `${ch.parent.name} → [${ch.ownClassSpec.name}, ${ch.children[1].name} (*-- ${ch.externalClass.name}), ${ch.children[2].name} (<|.. ${ch.interfaceSpec.name})]`;
        const isEval = ch.id >= 21 && ch.id <= 25;
        return (
          <details class={`ex-card ex-card--completed ${isEval ? 'ex-card--evaluation' : ''}`} id={ch.slug} data-ex-id={`poo-comp-${ch.id}`}>
            <summary class="ex-summary">
              <span class="ex-num" aria-hidden="true">{String(ch.id).padStart(2, '0')}</span>
              <div class="ex-summary-main">
                <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                  <h3>{ch.title}</h3>
                  {isEval && <span class="eval-badge">💎 Evaluación Especial</span>}
                </div>
                <span class="ex-summary-meta">{metaText}</span>
              </div>
              <span class="ex-progress" data-progress-for={`poo-comp-${ch.id}`}>0 / 5</span>
              <span class="ex-chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
              </span>
            </summary>

            <div class="ex-body">
              <p class="ex-statement"><strong>Contexto:</strong> {ch.context}</p>
              <p class="ex-task"><strong>Qué hacer:</strong> {ch.task}</p>

              <!-- Resumen visual de clases neobrutalista -->
              <div class="structure-box">
                <h4>📐 Componentes del Sistema:</h4>
                <ul>
                  <li><strong>Padre Abstracto:</strong> <code>{ch.parent.name}</code></li>
                  <li><strong>Interfaz Contrato (Solo Hija 3):</strong> <code>{ch.interfaceSpec.name}</code></li>
                  <li><strong>Clase Externa (Composición Hija 2):</strong> <code>{ch.externalClass.name}</code></li>
                  <li><strong>Hija con Propio:</strong> <code>{ch.ownClassSpec.name}</code></li>
                </ul>
              </div>

              {ch.methodGuide && ch.methodGuide.length > 0 && (
                <div class="method-guide-box">
                  <h4>⚙️ Especificación y Lógica de cada Método:</h4>
                  <div class="method-guide-grid">
                    {ch.methodGuide.map((mg) => (
                      <div class="method-guide-item">
                        <div class="method-guide-head">
                          <span class="method-tag">{mg.className}</span>
                          <code class="method-sig">{mg.name}</code>
                        </div>
                        <p class="method-desc">{mg.description}</p>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <!-- Diagrama UML -->
              <MermaidDiagram title={`Diagrama UML — ${ch.title}`} code={toMermaidCompleted(ch)} />

              <!-- Checklist del desafío -->
              <div class="ex-checks">
                <label class="chk"><input type="checkbox" data-check-id="padre" /> Creé la clase padre <code>{ch.parent.name}</code></label>
                <label class="chk"><input type="checkbox" data-check-id="interfaz" /> Creé la interfaz <code>{ch.interfaceSpec.name}</code></label>
                <label class="chk"><input type="checkbox" data-check-id="externa" /> Usé la clase externa <code>{ch.externalClass.name}</code></label>
                <label class="chk"><input type="checkbox" data-check-id="hijas" /> Implementé las 3 clases hijas</label>
                <label class="chk"><input type="checkbox" data-check-id="main" /> Probé polimorfismo en <code>Main.java</code></label>
              </div>

              <!-- Solución protegida por contraseña inline abajo del ejercicio -->
              <div class="solution-trigger-wrap" style="margin-top: 1rem;">
                <button
                  type="button"
                  class="solution-btn open-solution-btn"
                  data-target-solution={`pooc-sol-${ch.id}`}
                  data-ch-id={ch.id}
                  data-ch-title={ch.title}
                >
                  🔒 Ingresa la clave para ver los resultados
                </button>
              </div>

              <div id={`pooc-sol-${ch.id}`} class="solution-content-hidden" style="display:none; margin-top: 1.25rem; padding: 1.25rem; background: var(--bg-secondary); border-radius: 14px; border: 2px solid #e65100;">
                <h4 style="margin-top: 0; color: #e65100; font-size: 1.15rem; display: flex; align-items: center; gap: 0.4rem;">
                  <span>💡 Soluciones del Sistema:</span> <span>{ch.title}</span>
                </h4>

                <!-- Pestañas de Lenguaje -->
                <div class="lang-tabs" style="display: flex; gap: 0.4rem; margin-bottom: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; flex-wrap: wrap;">
                  <button type="button" class="tab-btn is-active" data-lang="java" data-ch={ch.id} style="padding: 0.4rem 0.8rem; border-radius: 6px; font-weight: 800; border: 1px solid var(--border-color); background: #e65100; color: white; cursor: pointer;">☕ Java</button>
                  <button type="button" class="tab-btn" data-lang="python" data-ch={ch.id} style="padding: 0.4rem 0.8rem; border-radius: 6px; font-weight: 800; border: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-primary); cursor: pointer;">🐍 Python</button>
                  <button type="button" class="tab-btn" data-lang="csharp" data-ch={ch.id} style="padding: 0.4rem 0.8rem; border-radius: 6px; font-weight: 800; border: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-primary); cursor: pointer;">🎮 C#</button>
                  <button type="button" class="tab-btn" data-lang="cpp" data-ch={ch.id} style="padding: 0.4rem 0.8rem; border-radius: 6px; font-weight: 800; border: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-primary); cursor: pointer;">⚙️ C++</button>
                </div>

                <div class="lang-panels" data-ch-panels={ch.id}>
                  <div class="panel-item panel-java" style="display: block;">
                    <CodeBlock lang="java" code={generateJavaCode(ch)} title={`${ch.parent.name}Sistema.java`} />
                  </div>
                  <div class="panel-item panel-python" style="display: none;">
                    <CodeBlock lang="python" code={generatePythonCode(ch)} title={`${ch.slug}_sistema.py`} />
                  </div>
                  <div class="panel-item panel-csharp" style="display: none;">
                    <CodeBlock lang="csharp" code={generateCsharpCode(ch)} title={`${ch.parent.name}Sistema.cs`} />
                  </div>
                  <div class="panel-item panel-cpp" style="display: none;">
                    <CodeBlock lang="cpp" code={generateCppCode(ch)} title={`${ch.slug}_sistema.cpp`} />
                  </div>
                </div>
              </div>
            </div>
          </details>
        );
      })}
    </div>

    <!-- Modal de Contraseña para Desbloquear Resultados -->
    <div id="passwordModal" class="poo-modal" aria-hidden="true">
      <div class="poo-modal-backdrop" id="closePassModalBackdrop"></div>
      <div class="poo-modal-panel" role="dialog" aria-modal="true">
        <div class="modal-lock-icon">🔐</div>
        <h3 id="modalChallengeTitle">Acceso Privado a Resultados</h3>
        <p class="modal-subtext" id="modalSubtext">Ingresa la clave para ver los resultados</p>

        <form id="passForm" class="modal-form">
          <input
            type="password"
            id="passInput"
            placeholder="Clave de acceso..."
            required
            autocomplete="off"
          />
          <p id="passErrorMsg" class="modal-error">
            ⚠️ Clave incorrecta. Inténtalo de nuevo.
          </p>
          <div class="modal-actions">
            <button type="button" id="btnCancelPass" class="modal-btn modal-btn--cancel">
              Cancelar
            </button>
            <button type="submit" class="modal-btn modal-btn--submit">
              Desbloquear 🔓
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Navegación inferior neobrutalista -->
    <div class="next-modules">
      <a href="/challenges/inheritance/" class="unit-card">
        <h3>← Desafíos de Herencia</h3>
        <p>20 jerarquías de 3 niveles y colecciones polimórficas.</p>
      </a>
      <a href="/challenges/interface/" class="unit-card">
        <h3>Desafíos de Interfaces →</h3>
        <p>20 contratos de interfaces con implementaciones múltiples.</p>
      </a>
    </div>
  </article>
</Layout>

<script is:inline>
(function() {
  const KEY = 'aprende_poo_completed_challenges_v1';
  const readStore = () => {
    try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; }
  };
  const writeStore = (s) => localStorage.setItem(KEY, JSON.stringify(s));
  const updateProgressFor = (exId) => {
    const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
    if (!card) return;
    const boxes = card.querySelectorAll('input[type="checkbox"][data-check-id]');
    const done = Array.from(boxes).filter((b) => b.checked).length;
    const total = boxes.length;
    const els = card.querySelectorAll('[data-progress-for="' + exId + '"]');
    els.forEach((el) => {
      el.textContent = done + ' / ' + total;
      el.classList.toggle('is-done', done === total && total > 0);
    });
  };

  document.querySelectorAll('.ex-card[data-ex-id]').forEach((card) => {
    const exId = card.getAttribute('data-ex-id');
    const perEx = (readStore()[exId]) || {};
    card.querySelectorAll('input[type="checkbox"][data-check-id]').forEach((input) => {
      const checkId = input.getAttribute('data-check-id');
      input.checked = Boolean(perEx[checkId]);
      input.addEventListener('click', (e) => e.stopPropagation());
      input.addEventListener('change', () => {
        const s = readStore();
        if (!s[exId]) s[exId] = {};
        s[exId][checkId] = input.checked;
        writeStore(s);
        updateProgressFor(exId);
      });
    });
    updateProgressFor(exId);
  });

  document.getElementById('expandAll')?.addEventListener('click', () => {
    document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = true));
  });
  document.getElementById('collapseAll')?.addEventListener('click', () => {
    document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = false));
  });

  // Lógica de contraseña para ver solución inline
  let targetSolId = null;
  let targetChId = null;
  const passModal = document.getElementById('passwordModal');
  const passForm = document.getElementById('passForm');
  const passInput = document.getElementById('passInput');
  const passErrorMsg = document.getElementById('passErrorMsg');
  const backdrop = document.getElementById('closePassModalBackdrop');
  const btnCancelPass = document.getElementById('btnCancelPass');

  function getExpectedKey(chId) {
    if (chId >= 21 && chId <= 25) {
      return 'revisionevaluacion';
    }
    const now = new Date();
    const dd = String(now.getDate()).padStart(2, '0');
    const mm = String(now.getMonth() + 1).padStart(2, '0');
    const yyyy = now.getFullYear();
    return dd + mm + yyyy; // Ej: 05092026
  }

  function openPassModal(solId, chId, chTitle) {
    targetSolId = solId;
    targetChId = Number(chId);
    if (passInput) passInput.value = '';
    if (passErrorMsg) passErrorMsg.style.display = 'none';
    const titleEl = document.getElementById('modalChallengeTitle');
    const subtextEl = document.getElementById('modalSubtext');
    if (titleEl && chTitle) {
      titleEl.textContent = chTitle;
    }
    if (subtextEl) {
      if (targetChId >= 21 && targetChId <= 25) {
        subtextEl.innerHTML = 'Módulo de Evaluación (21-25): Ingresa la clave especial de revisión';
      } else {
        subtextEl.textContent = 'Ingresa la clave para ver los resultados';
      }
    }
    if (passModal) {
      passModal.classList.add('is-open');
      passModal.setAttribute('aria-hidden', 'false');
      setTimeout(() => passInput?.focus(), 100);
    }
  }

  function closePassModal() {
    if (passModal) {
      passModal.classList.remove('is-open');
      passModal.setAttribute('aria-hidden', 'true');
    }
    targetSolId = null;
    targetChId = null;
  }

  document.querySelectorAll('.open-solution-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const solId = btn.getAttribute('data-target-solution');
      const chId = btn.getAttribute('data-ch-id');
      const chTitle = btn.getAttribute('data-ch-title');
      const targetDiv = document.getElementById(solId);
      if (targetDiv && targetDiv.style.display !== 'none') {
        targetDiv.style.display = 'none';
        btn.textContent = '🔒 Ingresa la clave para ver los resultados';
        return;
      }
      openPassModal(solId, chId, chTitle);
    });
  });

  if (backdrop) backdrop.addEventListener('click', closePassModal);
  if (btnCancelPass) btnCancelPass.addEventListener('click', closePassModal);

  if (passForm) {
    passForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const enteredKey = passInput.value.trim().toLowerCase();
      const expectedKey = getExpectedKey(targetChId).toLowerCase();

      if (enteredKey === expectedKey) {
        if (targetSolId) {
          const targetDiv = document.getElementById(targetSolId);
          if (targetDiv) {
            targetDiv.style.display = 'block';
            const triggerBtn = document.querySelector('[data-target-solution="' + targetSolId + '"]');
            if (triggerBtn) {
              triggerBtn.textContent = '🔓 Ocultar Resultados';
            }
          }
        }
        closePassModal();
      } else {
        if (passErrorMsg) passErrorMsg.style.display = 'block';
        passInput?.select();
      }
    });
  }

  // Manejo de Pestañas Multilenguaje
  document.querySelectorAll('.tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang');
      const chId = btn.getAttribute('data-ch');
      const container = document.querySelector('[data-ch-panels="' + chId + '"]');
      if (!container) return;

      const parentWrap = btn.parentElement;
      if (parentWrap) {
        parentWrap.querySelectorAll('.tab-btn').forEach((b) => {
          b.classList.remove('is-active');
          b.style.background = 'var(--bg-primary)';
          b.style.color = 'var(--text-primary)';
        });
      }
      btn.classList.add('is-active');
      btn.style.background = '#e65100';
      btn.style.color = 'white';

      container.querySelectorAll('.panel-item').forEach((panel) => {
        if (panel.classList.contains('panel-' + lang)) {
          panel.style.display = 'block';
        } else {
          panel.style.display = 'none';
        }
      });
    });
  });

  const openFromHash = () => {
    const hash = location.hash.replace(/^#/, '');
    if (!hash) return;
    const target = document.getElementById(hash);
    if (target && target.classList.contains('ex-card') && 'open' in target) {
      target.open = true;
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  };
  window.addEventListener('hashchange', openFromHash);
  if (location.hash) setTimeout(openFromHash, 80);
})();
</script>

<style>
  .kicker { margin: 0; font-size: 0.7rem; font-weight: 900; letter-spacing: 0.16em; text-transform: uppercase; color: #e65100; }
  .muted { color: var(--text-muted); font-weight: 650; line-height: 1.6; }
  
  .arch-warning-note {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    background: #fff8e1;
    border: 2px solid #ffa000;
    border-radius: 12px;
    font-size: 0.88rem;
    color: #5d4037;
    font-weight: 700;
    line-height: 1.5;
  }
  :global(.dark) .arch-warning-note {
    background: #261f18;
    border-color: #f59e0b;
    color: #fed7aa;
  }
  
  .rules-card {
    background: linear-gradient(135deg, rgba(255, 243, 224, 0.9) 0%, rgba(255, 255, 255, 0.95) 100%);
    border: 3px solid #1e1210;
    border-radius: 18px;
    padding: 1.25rem 1.5rem;
    margin: 1.25rem 0 1.5rem;
    box-shadow: 0 16px 34px rgba(30, 18, 16, 0.08);
  }
  :global(.dark) .rules-card {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.9) 0%, rgba(15, 23, 42, 0.95) 100%);
    border-color: #f97316;
  }
  .rules-card-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.85rem;
  }
  .rules-badge {
    align-self: flex-start;
    background: #e65100;
    color: white;
    font-weight: 900;
    font-size: 0.65rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    letter-spacing: 0.05em;
  }
  .rules-card h3 {
    margin: 0;
    color: #e65100;
    font-size: 1.25rem;
    font-weight: 900;
  }
  :global(.dark) .rules-card h3 {
    color: #f97316;
  }
  .rules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 0.65rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .rules-grid li {
    background: rgba(255, 255, 255, 0.9);
    padding: 0.65rem 0.85rem;
    border-radius: 12px;
    font-size: 0.86rem;
    line-height: 1.45;
    border: 2px solid #1e1210;
    box-shadow: 2px 2px 0 rgba(30, 18, 16, 0.1);
  }
  :global(.dark) .rules-grid li {
    background: #1e293b;
    border-color: #334155;
    color: #f8fafc;
  }

  .exercise-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 1.25rem 0 0.9rem;
  }
  .exercise-toolbar-hint {
    margin: 0;
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .exercise-toolbar-actions {
    display: flex;
    gap: 0.5rem;
  }
  .toolbar-btn {
    appearance: none;
    border: 2px solid #1e1210;
    background: #e65100;
    color: #fff;
    font-family: 'Nunito', sans-serif;
    font-weight: 900;
    font-size: 0.82rem;
    padding: 0.42rem 0.85rem;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 3px 3px 0 #1e1210;
    transition: transform 0.1s;
  }
  .toolbar-btn:hover {
    transform: translateY(-1px);
  }
  .toolbar-btn--ghost {
    background: #fff;
    color: #1e1210;
  }

  .exercise-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .ex-card {
    border: 3px solid var(--border);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 16px 34px rgba(30, 18, 16, 0.08);
    scroll-margin-top: 1.25rem;
    overflow: hidden;
  }
  .ex-card--evaluation {
    border: 3.5px solid #00d2ff !important;
    box-shadow: 0 0 16px rgba(0, 210, 255, 0.35), 0 16px 34px rgba(0, 119, 182, 0.12) !important;
    background: linear-gradient(180deg, rgba(240, 249, 255, 0.95) 0%, rgba(255, 255, 255, 0.98) 100%) !important;
  }
  :global(.dark) .ex-card--evaluation {
    border: 3.5px solid #00e5ff !important;
    box-shadow: 0 0 20px rgba(0, 229, 255, 0.3), 0 16px 34px rgba(0, 0, 0, 0.4) !important;
    background: linear-gradient(180deg, rgba(12, 28, 48, 0.95) 0%, rgba(15, 23, 42, 0.98) 100%) !important;
  }
  .ex-card--evaluation .ex-num {
    background: #0284c7;
    border-color: #00b4d8;
    color: #ffffff;
  }
  .ex-card--evaluation[open] .ex-num {
    background: #00b4d8;
    border-color: #0077b6;
  }
  .ex-card--evaluation .ex-summary-main h3 {
