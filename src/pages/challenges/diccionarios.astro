---
import Layout from '../../layouts/Layout.astro';

const exercises = [
  { id: 1, title: 'Crear y consultar un diccionario', statement: 'Declarar un diccionario con datos de un objeto (ej. clave: "nombre", "edad", "ciudad") e imprimir sus valores consultando por clave.' },
  { id: 2, title: 'Agregar una nueva clave-valor', statement: 'Dado un diccionario existente, añadir una nueva propiedad/clave y su valor correspondiente dinámicamente.' },
  { id: 3, title: 'Modificar el valor de una clave', statement: 'Actualizar o cambiar el valor almacenado en una clave específica dentro del diccionario.' },
  { id: 4, title: 'Eliminar una clave', statement: 'Eliminar una clave del diccionario y verificar que ya no esté presente.' },
  { id: 5, title: 'Verificar si existe una clave', statement: 'Escribir una función/bloque que verifique si una clave existe en el diccionario antes de acceder a su valor.' },
  { id: 6, title: 'Recorrer todas las claves', statement: 'Utilizar un bucle para iterar e imprimir todas las claves definidas en el diccionario.' },
  { id: 7, title: 'Recorrer todos los valores', statement: 'Iterar e imprimir únicamente los valores contenidos en el diccionario.' },
  { id: 8, title: 'Recorrer pares clave-valor', statement: 'Iterar simultáneamente sobre las claves y sus valores mostrando el par formateado (clave: valor).' },
  { id: 9, title: 'Contar cantidad de elementos', statement: 'Obtener el número total de pares clave-valor almacenados en el diccionario.' },
  { id: 10, title: 'Vaciar o limpiar un diccionario', statement: 'Eliminar todas las claves de un diccionario dejándolo totalmente vacío.' },
  { id: 11, title: 'Agenda telefónica básica', statement: 'Construir una agenda telefónica donde las claves son nombres de personas y los valores son sus números de teléfono.' },
  { id: 12, title: 'Diccionario de notas de alumnos', statement: 'Mapear nombres de alumnos con sus respectivas notas de examen final.' },
  { id: 13, title: 'Catálogo de productos y precios', statement: 'Guardar nombres de productos como clave y sus precios numéricos como valor.' },
  { id: 14, title: 'País y su ciudad capital', statement: 'Crear un diccionario de países como clave y sus capitales como valor para hacer consultas rápidas.' },
  { id: 15, title: 'Alumno y su promedio ponderado', statement: 'Mapear nombres de estudiantes con su promedio final calculado.' },
  { id: 16, title: 'Frecuencia de palabras en un texto', statement: 'Dado un texto o lista de palabras, contar cuántas veces se repite cada palabra usando un diccionario.' },
  { id: 17, title: 'Encontrar la clave con el mayor valor', statement: 'Dado un diccionario de productos y precios, iterar para determinar qué producto tiene el precio más alto.' },
  { id: 18, title: 'Encontrar la clave con el menor valor', statement: 'Iterar sobre el diccionario para hallar la clave que posee el valor numérico más bajo.' },
  { id: 19, title: 'Modificar valores según una condición', statement: 'Incrementar un 10% el valor de todos los productos cuyo precio actual sea menor a $1.000.' },
  { id: 20, title: 'Sistema compacto de gestión con diccionarios', statement: 'Crear un pequeño programa interactivo que permita buscar, actualizar e imprimir la información de un diccionario.' },
];
---

<Layout
  title="Diccionarios y Mapas (20 Desafíos)"
  description="Domina el uso de estructuras asociativas clave-valor: agregar, modificar, eliminar, buscar e iterar."
>
  <article class="content-section max-w-5xl mx-auto px-4 py-6">

    <!-- HEADER DE LA PÁGINA -->
    <div class="mb-6 pb-4 border-b-2 border-dashed border-[#1E1210]/15">
      <div class="flex items-center gap-2 mb-1">
        <a href="/challenges/" class="text-xs font-nunito font-extrabold text-[#8b5cf6] no-underline hover:underline">← Volver al Catálogo</a>
        <span class="text-slate-300">•</span>
        <span class="text-xs font-nunito font-extrabold uppercase tracking-widest text-[#8b5cf6]">Módulo 07 · Diccionarios</span>
      </div>
      <h1 class="m-0 text-2xl sm:text-3xl font-nunito font-black text-[#1E1210]">
        Diccionarios y Mapas (Clave → Valor)
      </h1>
      <p class="mt-2 text-sm text-slate-600 font-medium leading-relaxed">
        20 desafíos interactivos para dominar las estructuras asociativas <code>&#123;&#125;</code> (<code>dict</code>, <code>HashMap</code>, <code>Object</code>). Válido en <strong>Python, Java, C#, C++, JS, PHP y PSeInt</strong>.
      </p>
    </div>

    <!-- CONTROLES -->
    <div class="mb-6 flex flex-col sm:flex-row items-center justify-between gap-4 bg-purple-50/60 p-4 rounded-2xl border-2 border-[#1E1210]">
      <div class="w-full sm:w-auto">
        <span class="text-xs font-nunito font-black text-purple-900 uppercase tracking-wider block">🔍 Filtro de búsqueda</span>
        <input
          type="text"
          id="searchBox"
          placeholder="Buscar ejercicio en el diccionario..."
          class="mt-1 w-full sm:w-80 px-3 py-2 rounded-xl border-2 border-[#1E1210] font-nunito font-bold text-xs bg-white focus:outline-none focus:ring-2 focus:ring-purple-500"
        />
      </div>
      <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
        <button type="button" id="expandAll" class="px-3.5 py-2 rounded-xl border-2 border-[#1E1210] bg-[#1E1210] text-white font-nunito font-black text-xs cursor-pointer shadow-[2px_2px_0px_#1E1210] hover:-translate-y-0.5">Expandir todos (20)</button>
        <button type="button" id="collapseAll" class="px-3.5 py-2 rounded-xl border-2 border-[#1E1210] bg-white text-[#1E1210] font-nunito font-black text-xs cursor-pointer shadow-[2px_2px_0px_#1E1210] hover:-translate-y-0.5">Colapsar todos</button>
      </div>
    </div>

    <!-- LISTADO RÁPIDO -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-3 border-b-2 border-[#1E1210] pb-2">
        <h2 class="text-base font-nunito font-black text-[#1E1210] m-0 flex items-center gap-2">
          <span>📋</span> Listado Rápido (1 al 20)
        </h2>
        <span class="text-xs font-nunito font-bold bg-purple-100 text-purple-800 px-2.5 py-0.5 rounded-full border border-purple-300">20 ítems</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-2" id="quickList">
        {exercises.map((ex) => (
          <div class="quick-item search-target" data-keywords={ex.title.toLowerCase()} data-quick-id={`dict-${ex.id}`}>
            <label class="flex items-center cursor-pointer p-0.5 shrink-0" title="Marcar como completado">
              <input type="checkbox" data-complete-id={`dict-${ex.id}`} class="w-4 h-4 accent-purple-600 rounded cursor-pointer" />
            </label>
            <a href={`#dict-${ex.id}`} class="quick-link flex items-center gap-2.5 flex-1 min-w-0 no-underline text-inherit">
              <span class="quick-num">{String(ex.id).padStart(2, '0')}</span>
              <span class="quick-title">{ex.title}</span>
              <span class="quick-badge-done hidden text-[0.65rem] font-bold bg-purple-100 text-purple-800 px-1.5 py-0.5 rounded border border-purple-300">✓ Hecho</span>
              <span class="quick-arrow">↓</span>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- RESOLUCIÓN GUIADA CON CHECKLISTS -->
    <section class="mb-8">
      <div class="flex items-center justify-between mb-4 border-b-2 border-[#1E1210] pb-2">
        <h2 class="text-base font-nunito font-black text-[#1E1210] m-0 flex items-center gap-2">
          <span>🎯</span> Resolución Guiada y Checklists de Progreso
        </h2>
      </div>

      <div id="exerciseList" class="flex flex-col gap-3">
        {exercises.map((ex) => (
          <details class="ex-card border-2 border-[#1E1210] bg-white rounded-2xl p-4 shadow-[3px_3px_0px_#1E1210] search-target transition-all" id={`dict-${ex.id}`} data-ex-id={`dict-${ex.id}`} data-keywords={ex.title.toLowerCase()}>
            <summary class="ex-summary flex items-center justify-between cursor-pointer font-nunito font-black select-none">
              <div class="flex items-center gap-3 pr-2 min-w-0">
                <span class="ex-num w-8 h-8 rounded-xl bg-[#8b5cf6] text-white flex items-center justify-center text-xs shrink-0">{String(ex.id).padStart(2, '0')}</span>
                <h3 class="m-0 text-sm sm:text-base text-[#1E1210] truncate flex items-center gap-2">
                  <span>{ex.id}. {ex.title}</span>
                  <span class="card-done-tag hidden text-xs font-bold text-purple-700 bg-purple-100 px-2 py-0.5 rounded-md border border-purple-300">✓ Completado</span>
                </h3>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <label class="flex items-center gap-1.5 text-xs font-extrabold bg-purple-50 hover:bg-purple-100 text-purple-900 px-2.5 py-1 rounded-lg border border-purple-200 cursor-pointer" onclick="event.stopPropagation()">
                  <input type="checkbox" data-complete-id={`dict-${ex.id}`} class="w-4 h-4 accent-purple-600 rounded cursor-pointer" />
                  <span>Completado</span>
                </label>
                <span class="ex-progress text-xs font-bold text-slate-500 bg-slate-100 px-2 py-1 rounded-lg border border-slate-200" data-progress-for={`dict-${ex.id}`}>0 / 5</span>
              </div>
            </summary>

            <div class="ex-body mt-3 pt-3 border-t border-slate-200">
              <p class="ex-statement font-quicksand font-bold text-sm text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-200">
                <strong>Enunciado:</strong> {ex.statement}
              </p>

              <div class="ex-checks flex flex-col gap-2 mt-3 text-xs font-nunito font-extrabold">
                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-purple-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="declara" class="w-4 h-4 accent-purple-600 rounded" />
                  <span>1. Definí la estructura del diccionario y los pares clave-valor</span>
                </label>

                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-purple-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="clave" class="w-4 h-4 accent-purple-600 rounded" />
                  <span>2. Consulté o verifiqué la existencia de la clave antes de usarla</span>
                </label>

                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-purple-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="iterar" class="w-4 h-4 accent-purple-600 rounded" />
                  <span>3. Iteré sobre las claves/valores según el requerimiento</span>
                </label>

                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-purple-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="modificar" class="w-4 h-4 accent-purple-600 rounded" />
                  <span>4. Apliqué las modificaciones o cálculos necesarios</span>
                </label>

                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-purple-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="salida" class="w-4 h-4 accent-purple-600 rounded" />
                  <span>5. Imprimí el resultado asociativo correctamente</span>
                </label>
              </div>
            </div>
          </details>
        ))}
      </div>
    </section>

  </article>

  <!-- SCRIPT DE LOCALSTORAGE Y SINCRONIZACIÓN -->
  <script is:inline>
    (function () {
      const KEY = 'aprende_diccionarios_v1';
      const readStore = () => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } };
      const writeStore = (s) => localStorage.setItem(KEY, JSON.stringify(s));

      const syncCompleteStatus = (exId, isCompleted) => {
        document.querySelectorAll('input[data-complete-id="' + exId + '"]').forEach((chk) => { chk.checked = isCompleted; });
        const quickItem = document.querySelector('.quick-item[data-quick-id="' + exId + '"]');
        if (quickItem) {
          const badge = quickItem.querySelector('.quick-badge-done');
          if (isCompleted) {
            quickItem.classList.add('is-completed');
            if (badge) badge.classList.remove('hidden');
          } else {
            quickItem.classList.remove('is-completed');
            if (badge) badge.classList.add('hidden');
          }
        }
        const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
        if (card) {
          const tag = card.querySelector('.card-done-tag');
          if (isCompleted) {
            card.classList.add('border-purple-500', 'bg-purple-50/30');
            if (tag) tag.classList.remove('hidden');
          } else {
            card.classList.remove('border-purple-500', 'bg-purple-50/30');
            if (tag) tag.classList.add('hidden');
          }
        }
      };

      const updateProgressFor = (exId) => {
        const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
        if (!card) return;
        const boxes = card.querySelectorAll('input[type="checkbox"][data-check-id]');
        const done = Array.from(boxes).filter((b) => b.checked).length;
        const total = boxes.length;
        const els = card.querySelectorAll('[data-progress-for="' + exId + '"]');
        els.forEach((el) => {
          el.textContent = done + ' / ' + total;
          if (done === total && total > 0) {
            el.classList.add('bg-purple-600', 'text-white');
            el.classList.remove('bg-slate-100', 'text-slate-500');
          } else {
            el.classList.remove('bg-purple-600', 'text-white');
            el.classList.add('bg-slate-100', 'text-slate-500');
          }
        });

        const store = readStore();
        if (done === total && total > 0) {
          if (!store[exId]) store[exId] = {};
          store[exId]['__completed__'] = true;
          writeStore(store);
          syncCompleteStatus(exId, true);
        }
      };

      document.querySelectorAll('.ex-card[data-ex-id]').forEach((card) => {
        const exId = card.getAttribute('data-ex-id');
        const perEx = (readStore()[exId]) || {};
        card.querySelectorAll('input[type="checkbox"][data-check-id]').forEach((input) => {
          const checkId = input.getAttribute('data-check-id');
          input.checked = Boolean(perEx[checkId]);
          input.addEventListener('click', (e) => e.stopPropagation());
          input.addEventListener('change', () => {
            const s = readStore();
            if (!s[exId]) s[exId] = {};
            s[exId][checkId] = input.checked;
            writeStore(s);
            updateProgressFor(exId);
          });
        });
        updateProgressFor(exId);
        syncCompleteStatus(exId, Boolean(perEx['__completed__']));
      });

      document.querySelectorAll('input[data-complete-id]').forEach((chk) => {
        chk.addEventListener('change', () => {
          const exId = chk.getAttribute('data-complete-id');
          const isDone = chk.checked;
          const s = readStore();
          if (!s[exId]) s[exId] = {};
          s[exId]['__completed__'] = isDone;

          const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
          if (card) {
            card.querySelectorAll('input[type="checkbox"][data-check-id]').forEach((box) => {
              box.checked = isDone;
              const checkId = box.getAttribute('data-check-id');
              s[exId][checkId] = isDone;
            });
          }

          writeStore(s);
          syncCompleteStatus(exId, isDone);
          updateProgressFor(exId);
        });
      });

      document.getElementById('expandAll')?.addEventListener('click', () => {
        document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = true));
      });
      document.getElementById('collapseAll')?.addEventListener('click', () => {
        document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = false));
      });

      const searchBox = document.getElementById('searchBox');
      if (searchBox) {
        searchBox.addEventListener('input', (e) => {
          const q = e.target.value.toLowerCase().trim();
          document.querySelectorAll('.search-target').forEach((el) => {
            const kw = el.getAttribute('data-keywords') || '';
            const txt = el.textContent.toLowerCase();
            el.style.display = (txt.includes(q) || kw.includes(q)) ? '' : 'none';
          });
        });
      }
    })();
  </script>

  <style>
    .quick-item.is-completed {
      background: #F5F3FF;
      border-color: #8b5cf6;
    }
    .quick-item.is-completed .quick-num {
      background: #7c3aed;
    }
    .quick-item {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.55rem 0.85rem;
      background: #ffffff;
      border: 2px solid #1E1210;
      border-radius: 12px;
      text-decoration: none;
      color: inherit;
      box-shadow: 2px 2px 0 #1E1210;
      transition: all 0.12s ease;
    }
    .quick-item:hover {
      transform: translateX(3px);
      box-shadow: 3px 3px 0 #1E1210;
      background: #F5F3FF;
    }
    .quick-num {
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 0.72rem;
      background: #8b5cf6;
      color: #ffffff;
      padding: 0.15rem 0.45rem;
      border-radius: 6px;
      flex-shrink: 0;
    }
    .quick-title {
      font-family: 'Nunito', sans-serif;
      font-weight: 800;
      font-size: 0.88rem;
      color: #1E1210;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex: 1;
    }
    .quick-arrow {
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 0.9rem;
      color: #8b5cf6;
      flex-shrink: 0;
    }
  </style>
</Layout>
