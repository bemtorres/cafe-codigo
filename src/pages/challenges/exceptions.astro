---
import Layout from '../../layouts/Layout.astro';

const exercises = [
  // 1-5: COMPRENDER EL MECANISMO
  { id: 1, section: 'Mecanismos Básicos', title: 'Provocar y capturar una excepción', statement: 'Provocar intencionalmente un error de conversión o división e interceptarlo con un bloque try/catch (try/except en Python) imprimiendo un aviso.' },
  { id: 2, section: 'Mecanismos Básicos', title: 'Capturar entrada no numérica', statement: 'Solicitar un número entero al usuario y capturar el error si ingresa texto, evitando que el programa se detenga abruptamente.' },
  { id: 3, section: 'Mecanismos Básicos', title: 'Controlar división por cero', statement: 'Solicitar dividendo y divisor; si el divisor es 0, capturar la excepción específica de división por cero y mostrar un aviso.' },
  { id: 4, section: 'Mecanismos Básicos', title: 'Convertir texto a número de forma segura', statement: 'Crear un algoritmo que intente parsear una cadena a decimal; si falla, retornar 0.0 y notificar el formato inválido.' },
  { id: 5, section: 'Mecanismos Básicos', title: 'Acceder a una posición o índice inválido', statement: 'Intentar acceder al índice 10 de un arreglo de 3 elementos dentro de un bloque try para capturar el error de índice fuera de rango.' },

  // 6-10: VALIDACIÓN
  { id: 6, section: 'Validación de Datos', title: 'Validar edad válida', statement: 'Solicitar la edad del usuario; si ingresa letras o un número negativo, capturar la excepción o lanzar un aviso hasta obtener un valor coherente.' },
  { id: 7, section: 'Validación de Datos', title: 'Validar número dentro de un rango [1, 100]', statement: 'Solicitar un entero entre 1 y 100; capturar errores de tipo y notificar si el valor está fuera del rango establecido.' },
  { id: 8, section: 'Validación de Datos', title: 'Validar nota académica (1.0 a 7.0 / 0 a 100)', statement: 'Ingresar una nota con decimales controlando excepciones de tipeo y asegurando que la nota sea válida antes de calcular promedios.' },
  { id: 9, section: 'Validación de Datos', title: 'Validar opción de menú numérico', statement: 'Leer la opción elegida por el usuario para un menú; si la entrada no es un entero válido, evitar la caída del sistema.' },
  { id: 10, section: 'Validación de Datos', title: 'Manejar múltiples excepciones en un mismo bloque', statement: 'Construir un bloque try que pueda lanzar tanto error de formato no numérico como error de división por cero, capturando cada uno por separado.' },

  // 11-15: COMBINAR CON FUNCIONES Y MÉTODOS
  { id: 11, section: 'Funciones Seguras', title: 'Función que valida un número entero', statement: 'Crear la función solicitarEntero(mensaje) que pida un dato repetidamente con un bucle hasta que el usuario ingrese un entero válido.' },
  { id: 12, section: 'Funciones Seguras', title: 'Función de división segura', statement: 'Crear la función dividirSeguro(a, b) que realice la división dentro de un try y retorne null/None o 0 si ocurre una división por cero.' },
  { id: 13, section: 'Funciones Seguras', title: 'Función para solicitar edad con reintento', statement: 'Crear la función pedirEdad() que reintente la lectura mediante un ciclo hasta que se ingrese un entero entre 0 y 120.' },
  { id: 14, section: 'Funciones Seguras', title: 'Función para solicitar opción de menú protegida', statement: 'Crear la función obtenerOpcion(maxOpciones) que capture cualquier error tipográfico y reitere la solicitud hasta recibir una opción válida.' },
  { id: 15, section: 'Funciones Seguras', title: 'Menú principal protegido contra caídas', statement: 'Implementar un bucle de menú interactivo completo envuelto en funciones que nunca finalice por errores de entrada del usuario.' },

  // 16-19: ESTRUCTURAS DE DATOS Y EXCEPCIONES
  { id: 16, section: 'Estructuras y Excepciones', title: 'Operaciones seguras con arreglos', statement: 'Crear la función obtenerElementoSeguro(arreglo, indice) que capture IndexOutOfBounds / IndexError y retorne un valor por defecto.' },
  { id: 17, section: 'Estructuras y Excepciones', title: 'Búsqueda segura en posiciones inexistentes', statement: 'Recorrer un arreglo consultando posiciones dinámicas con try/catch para registrar intentos fallidos sin detener la iteración.' },
  { id: 18, section: 'Estructuras y Excepciones', title: 'Acceso seguro a claves de diccionarios', statement: 'Crear la función obtenerValorClave(diccionario, clave) que intente leer la clave y capture KeyError / Exception si no existe.' },
  { id: 19, section: 'Estructuras y Excepciones', title: 'Procesar colección ignorando datos inválidos', statement: 'Dada una lista de cadenas (ej. ["10", "20", "abc", "30"]), intentar convertirlas a enteros acumulando la suma de los datos válidos e ignorando los erróneos.' },

  // 20: DESAFÍO INTEGRADOR
  { id: 20, section: 'Desafío Integrador', title: 'Sistema de Gestión Robusto e Inmune a Errores', statement: 'Crear un mini-sistema (ej. Registro de Alumnos o Productos) con menú CRUD que maneje lecturas de teclado, conversiones, rangos y búsquedas en arreglos/diccionarios sin caerse jamás por excepciones.' },
];
---

<Layout
  title="Manejo de Excepciones y Control de Errores (20 Desafíos)"
  description="Aprende a capturar excepciones (try/catch / try/except), validar entradas, evitar caídas del programa y construir software robusto."
>
  <article class="content-section max-w-5xl mx-auto px-4 py-6">

    <!-- HEADER DE LA PÁGINA -->
    <div class="mb-6 pb-4 border-b-2 border-dashed border-[#1E1210]/15">
      <div class="flex items-center gap-2 mb-1">
        <a href="/challenges/" class="text-xs font-nunito font-extrabold text-[#e11d48] no-underline hover:underline">← Volver al Catálogo</a>
        <span class="text-slate-300">•</span>
        <span class="text-xs font-nunito font-extrabold uppercase tracking-widest text-[#e11d48]">Módulo 06 · Excepciones</span>
      </div>
      <h1 class="m-0 text-2xl sm:text-3xl font-nunito font-black text-[#1E1210]">
        Manejo de Excepciones y Control de Errores
      </h1>
      <p class="mt-2 text-sm text-slate-600 font-medium leading-relaxed">
        20 desafíos graduales para dominar el control de errores (<code>try / catch</code> o <code>try / except</code>), validación de entradas, reintentos y software a prueba de caídas.
      </p>
    </div>

    <!-- PESTAÑAS DE SINTAXIS MULTI-LENGUAJE -->
    <div class="mb-6 bg-slate-900 text-white p-4 rounded-2xl border-2 border-[#1E1210] shadow-[4px_4px_0px_#1E1210]">
      <div class="flex items-center justify-between gap-2 mb-2">
        <span class="text-xs font-nunito font-black uppercase tracking-wider text-rose-400">💡 Sintaxis de Excepciones según tu lenguaje:</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 text-xs font-mono">
        <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700">
          <span class="text-amber-400 font-bold block mb-1">🐍 Python:</span>
          <code>try:<br/>&nbsp;&nbsp;n = int(input())<br/>except ValueError:<br/>&nbsp;&nbsp;print("Inválido")</code>
        </div>
        <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700">
          <span class="text-orange-400 font-bold block mb-1">☕ Java:</span>
          <code>try &#123;<br/>&nbsp;&nbsp;int n = sc.nextInt();<br/>&#125; catch (Exception e) &#123;<br/>&nbsp;&nbsp;System.out.println();<br/>&#125;</code>
        </div>
        <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700">
          <span class="text-purple-400 font-bold block mb-1">🎮 C# / C++:</span>
          <code>try &#123;<br/>&nbsp;&nbsp;int n = int.Parse(s);<br/>&#125; catch (FormatException) &#123;<br/>&nbsp;&nbsp;Console.WriteLine();<br/>&#125;</code>
        </div>
        <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700">
          <span class="text-sky-400 font-bold block mb-1">⚡ JavaScript / PHP:</span>
          <code>try &#123;<br/>&nbsp;&nbsp;let n = Number(str);<br/>&#125; catch (err) &#123;<br/>&nbsp;&nbsp;console.error(err);<br/>&#125;</code>
        </div>
      </div>
    </div>

    <!-- CONTROLES DE BÚSQUEDA Y BOTONES -->
    <div class="mb-6 flex flex-col md:flex-row items-center justify-between gap-4 bg-rose-50/60 p-4 rounded-2xl border-2 border-[#1E1210]">
      <div class="w-full md:w-auto flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div>
          <span class="text-xs font-nunito font-black text-rose-900 uppercase tracking-wider block">🔍 Filtro de búsqueda</span>
          <input
            type="text"
            id="searchBox"
            placeholder="Buscar desafío de excepción..."
            class="mt-1 w-full sm:w-64 px-3 py-2 rounded-xl border-2 border-[#1E1210] font-nunito font-bold text-xs bg-white focus:outline-none focus:ring-2 focus:ring-rose-500"
          />
        </div>

        <!-- TOGGLE SWITCH DE SUGERENCIAS PASO A PASO -->
        <div class="flex items-center gap-2.5 bg-white px-3.5 py-2 rounded-xl border-2 border-[#1E1210] shadow-[2px_2px_0px_#1E1210] mt-1 sm:mt-5">
          <input type="checkbox" id="toggleSuggestions" class="w-4 h-4 accent-rose-600 rounded cursor-pointer" />
          <label for="toggleSuggestions" class="text-xs font-nunito font-extrabold text-[#1E1210] cursor-pointer select-none">
            💡 Activar sugerencias guiadas (Paso a Paso)
          </label>
        </div>
      </div>

      <div class="flex items-center gap-2 w-full md:w-auto justify-end">
        <button type="button" id="expandAll" class="px-3.5 py-2 rounded-xl border-2 border-[#1E1210] bg-[#1E1210] text-white font-nunito font-black text-xs cursor-pointer shadow-[2px_2px_0px_#1E1210] hover:-translate-y-0.5">Expandir todos (20)</button>
        <button type="button" id="collapseAll" class="px-3.5 py-2 rounded-xl border-2 border-[#1E1210] bg-white text-[#1E1210] font-nunito font-black text-xs cursor-pointer shadow-[2px_2px_0px_#1E1210] hover:-translate-y-0.5">Colapsar todos</button>
      </div>
    </div>

    <!-- LISTADO RÁPIDO DE 20 EJERCICIOS -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-3 border-b-2 border-[#1E1210] pb-2">
        <h2 class="text-base font-nunito font-black text-[#1E1210] m-0 flex items-center gap-2">
          <span>📋</span> Listado Rápido de Excepciones (1 al 20)
        </h2>
        <span class="text-xs font-nunito font-bold bg-rose-100 text-rose-800 px-2.5 py-0.5 rounded-full border border-rose-300">20 ítems</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-2" id="quickList">
        {exercises.map((ex) => (
          <div class="quick-item search-target" data-keywords={`${ex.title} ${ex.section}`.toLowerCase()} data-quick-id={`exc-${ex.id}`}>
            <label class="flex items-center cursor-pointer p-0.5 shrink-0" title="Marcar como completado">
              <input type="checkbox" data-complete-id={`exc-${ex.id}`} class="w-4 h-4 accent-rose-600 rounded cursor-pointer" />
            </label>
            <a href={`#exc-${ex.id}`} class="quick-link flex items-center gap-2.5 flex-1 min-w-0 no-underline text-inherit">
              <span class="quick-num">{String(ex.id).padStart(2, '0')}</span>
              <span class="quick-title">{ex.title}</span>
              <span class="quick-badge-done hidden text-[0.65rem] font-bold bg-rose-100 text-rose-800 px-1.5 py-0.5 rounded border border-rose-300">✓ Hecho</span>
              <span class="quick-arrow">↓</span>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- RESOLUCIÓN GUIADA CON CHECKLISTS -->
    <section class="mb-8">
      <div class="flex items-center justify-between mb-4 border-b-2 border-[#1E1210] pb-2">
        <h2 class="text-base font-nunito font-black text-[#1E1210] m-0 flex items-center gap-2">
          <span>🎯</span> Resolución Guiada y Checklists de Progreso
        </h2>
      </div>

      <div id="exerciseList" class="flex flex-col gap-3">
        {exercises.map((ex) => (
          <details class="ex-card border-2 border-[#1E1210] bg-white rounded-2xl p-4 shadow-[3px_3px_0px_#1E1210] search-target transition-all" id={`exc-${ex.id}`} data-ex-id={`exc-${ex.id}`} data-keywords={`${ex.title} ${ex.section}`.toLowerCase()}>
            <summary class="ex-summary flex items-center justify-between cursor-pointer font-nunito font-black select-none">
              <div class="flex items-center gap-3 pr-2 min-w-0">
                <span class="ex-num w-8 h-8 rounded-xl bg-[#e11d48] text-white flex items-center justify-center text-xs shrink-0">{String(ex.id).padStart(2, '0')}</span>
                <div class="truncate">
                  <span class="text-[0.68rem] text-rose-700 font-extrabold uppercase block leading-tight">{ex.section}</span>
                  <h3 class="m-0 text-sm sm:text-base text-[#1E1210] truncate flex items-center gap-2">
                    <span>{ex.id}. {ex.title}</span>
                    <span class="card-done-tag hidden text-xs font-bold text-rose-700 bg-rose-100 px-2 py-0.5 rounded-md border border-rose-300">✓ Completado</span>
                  </h3>
                </div>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <label class="flex items-center gap-1.5 text-xs font-extrabold bg-rose-50 hover:bg-rose-100 text-rose-900 px-2.5 py-1 rounded-lg border border-rose-200 cursor-pointer" onclick="event.stopPropagation()">
                  <input type="checkbox" data-complete-id={`exc-${ex.id}`} class="w-4 h-4 accent-rose-600 rounded cursor-pointer" />
                  <span>Completado</span>
                </label>
                <span class="ex-progress text-xs font-bold text-slate-500 bg-slate-100 px-2 py-1 rounded-lg border border-slate-200" data-progress-for={`exc-${ex.id}`}>0 / 5</span>
              </div>
            </summary>

            <div class="ex-body mt-3 pt-3 border-t border-slate-200">
              <p class="ex-statement font-quicksand font-bold text-sm text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-200">
                <strong>Enunciado:</strong> {ex.statement}
              </p>

              <div class="ex-checks flex flex-col gap-2 mt-3 text-xs font-nunito font-extrabold">
                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-rose-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="riesgo" class="w-4 h-4 accent-rose-600 rounded" />
                  <span>1. Identifiqué la operación propensa a error (conversión, división, índice)</span>
                </label>

                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-rose-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="try" class="w-4 h-4 accent-rose-600 rounded" />
                  <span>2. Envolví la instrucción riesgosa dentro del bloque <code>try</code></span>
                </label>

                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-rose-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="catch" class="w-4 h-4 accent-rose-600 rounded" />
                  <span>3. Capturé la excepción específica en el bloque <code>catch</code> / <code>except</code></span>
                </label>

                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-rose-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="recuperacion" class="w-4 h-4 accent-rose-600 rounded" />
                  <span>4. Implementé la recuperación (reintento con ciclo o valor por defecto)</span>
                </label>

                <label class="chk flex items-center gap-2.5 cursor-pointer hover:bg-rose-50/50 p-1.5 rounded-lg transition-colors">
                  <input type="checkbox" data-check-id="verificado" class="w-4 h-4 accent-rose-600 rounded" />
                  <span>5. Probé ingresando datos inválidos y verifiqué que el programa NO se caiga</span>
                </label>
              </div>
            </div>
          </details>
        ))}
      </div>
    </section>

  </article>

  <!-- SCRIPT DE LOCALSTORAGE Y SINCRONIZACIÓN -->
  <script is:inline>
    (function () {
      const KEY = 'aprende_manejo_excepciones_v1';
      const readStore = () => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } };
      const writeStore = (s) => localStorage.setItem(KEY, JSON.stringify(s));

      const syncCompleteStatus = (exId, isCompleted) => {
        document.querySelectorAll('input[data-complete-id="' + exId + '"]').forEach((chk) => { chk.checked = isCompleted; });
        const quickItem = document.querySelector('.quick-item[data-quick-id="' + exId + '"]');
        if (quickItem) {
          const badge = quickItem.querySelector('.quick-badge-done');
          if (isCompleted) {
            quickItem.classList.add('is-completed');
            if (badge) badge.classList.remove('hidden');
          } else {
            quickItem.classList.remove('is-completed');
            if (badge) badge.classList.add('hidden');
          }
        }
        const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
        if (card) {
          const tag = card.querySelector('.card-done-tag');
          if (isCompleted) {
            card.classList.add('border-rose-500', 'bg-rose-50/30');
            if (tag) tag.classList.remove('hidden');
          } else {
            card.classList.remove('border-rose-500', 'bg-rose-50/30');
            if (tag) tag.classList.add('hidden');
          }
        }
      };

      const updateProgressFor = (exId) => {
        const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
        if (!card) return;
        const boxes = card.querySelectorAll('input[type="checkbox"][data-check-id]');
        const done = Array.from(boxes).filter((b) => b.checked).length;
        const total = boxes.length;
        const els = card.querySelectorAll('[data-progress-for="' + exId + '"]');
        els.forEach((el) => {
          el.textContent = done + ' / ' + total;
          if (done === total && total > 0) {
            el.classList.add('bg-rose-600', 'text-white');
            el.classList.remove('bg-slate-100', 'text-slate-500');
          } else {
            el.classList.remove('bg-rose-600', 'text-white');
            el.classList.add('bg-slate-100', 'text-slate-500');
          }
        });

        const store = readStore();
        if (done === total && total > 0) {
          if (!store[exId]) store[exId] = {};
          store[exId]['__completed__'] = true;
          writeStore(store);
          syncCompleteStatus(exId, true);
        }
      };

      document.querySelectorAll('.ex-card[data-ex-id]').forEach((card) => {
        const exId = card.getAttribute('data-ex-id');
        const perEx = (readStore()[exId]) || {};
        card.querySelectorAll('input[type="checkbox"][data-check-id]').forEach((input) => {
          const checkId = input.getAttribute('data-check-id');
          input.checked = Boolean(perEx[checkId]);
          input.addEventListener('click', (e) => e.stopPropagation());
          input.addEventListener('change', () => {
            const s = readStore();
            if (!s[exId]) s[exId] = {};
            s[exId][checkId] = input.checked;
            writeStore(s);
            updateProgressFor(exId);
          });
        });
        updateProgressFor(exId);
        syncCompleteStatus(exId, Boolean(perEx['__completed__']));
      });

      document.querySelectorAll('input[data-complete-id]').forEach((chk) => {
        chk.addEventListener('change', () => {
          const exId = chk.getAttribute('data-complete-id');
          const isDone = chk.checked;
          const s = readStore();
          if (!s[exId]) s[exId] = {};
          s[exId]['__completed__'] = isDone;

          const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
          if (card) {
            card.querySelectorAll('input[type="checkbox"][data-check-id]').forEach((box) => {
              box.checked = isDone;
              const checkId = box.getAttribute('data-check-id');
              s[exId][checkId] = isDone;
            });
          }

          writeStore(s);
          syncCompleteStatus(exId, isDone);
          updateProgressFor(exId);
        });
      });

      document.getElementById('expandAll')?.addEventListener('click', () => {
        document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = true));
      });
      document.getElementById('collapseAll')?.addEventListener('click', () => {
        document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = false));
      });

      // Lógica del Toggle de Sugerencias Guiadas Paso a Paso
      const toggleBtn = document.getElementById('toggleSuggestions');
      const SUGGESTIONS_KEY = 'aprende_show_step_suggestions';

      const updateSuggestionsVisibility = (show) => {
        document.querySelectorAll('.ex-checks').forEach((el) => {
          if (show) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });
      };

      if (toggleBtn) {
        const savedPref = localStorage.getItem(SUGGESTIONS_KEY);
        const isEnabled = savedPref === 'true';
        toggleBtn.checked = isEnabled;
        updateSuggestionsVisibility(isEnabled);

        toggleBtn.addEventListener('change', (e) => {
          const checked = e.target.checked;
          localStorage.setItem(SUGGESTIONS_KEY, String(checked));
          updateSuggestionsVisibility(checked);
        });
      }

      const searchBox = document.getElementById('searchBox');
      if (searchBox) {
        searchBox.addEventListener('input', (e) => {
          const q = e.target.value.toLowerCase().trim();
          document.querySelectorAll('.search-target').forEach((el) => {
            const kw = el.getAttribute('data-keywords') || '';
            const txt = el.textContent.toLowerCase();
            el.style.display = (txt.includes(q) || kw.includes(q)) ? '' : 'none';
          });
        });
      }
    })();
  </script>

  <style>
    .quick-item.is-completed {
      background: #FFF1F2;
      border-color: #e11d48;
    }
    .quick-item.is-completed .quick-num {
      background: #be123c;
    }
    .quick-item {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.55rem 0.85rem;
      background: #ffffff;
      border: 2px solid #1E1210;
      border-radius: 12px;
      text-decoration: none;
      color: inherit;
      box-shadow: 2px 2px 0 #1E1210;
      transition: all 0.12s ease;
    }
    .quick-item:hover {
      transform: translateX(3px);
      box-shadow: 3px 3px 0 #1E1210;
      background: #FFF1F2;
    }
    .quick-num {
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 0.72rem;
      background: #e11d48;
      color: #ffffff;
      padding: 0.15rem 0.45rem;
      border-radius: 6px;
      flex-shrink: 0;
    }
    .quick-title {
      font-family: 'Nunito', sans-serif;
      font-weight: 800;
      font-size: 0.88rem;
      color: #1E1210;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex: 1;
    }
    .quick-arrow {
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 0.9rem;
      color: #e11d48;
      flex-shrink: 0;
    }
  </style>
</Layout>
