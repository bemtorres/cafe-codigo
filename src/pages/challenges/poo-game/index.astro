---
import Layout from '../../../layouts/Layout.astro';
import MermaidDiagram from '../../../components/challenges/MermaidDiagram.astro';
import { pooGameChallenges, toMermaidGame, pooGameLevelMeta, pooGameLevelOf } from '../../../data/pooGameChallenges';
import type { PooGameChallenge, PooGameLevel } from '../../../data/pooGameChallenges';

const totalChallenges = pooGameChallenges.length;
const levelOrder: PooGameLevel[] = ['basico', 'intermedio', 'avanzado', 'experto'];

const levelSummary = levelOrder.map((level) => {
  const ids = pooGameChallenges.filter((ch) => pooGameLevelOf(ch) === level).map((ch) => ch.id);
  return {
    level,
    meta: pooGameLevelMeta[level],
    count: ids.length,
    from: String(ids[0] ?? 0).padStart(2, '0'),
    to: String(ids[ids.length - 1] ?? 0).padStart(2, '0'),
  };
});

const battleChecks = [
  'Analicé las clases del combate y sus asociaciones',
  'Modelé la asociación y composición en constructores y atributos',
  'Implementé las acciones del combate (ataque, defensa, daño, curación)',
  'Simulé la batalla por turnos 1v1 en el método Main',
];

const checksFor = (ch: PooGameChallenge): string[] => {
  const level = pooGameLevelOf(ch);
  if (level === 'experto') return battleChecks;

  const names = ch.associatedClasses.map((c) => c.name).join(', ');
  const classCount = ch.associatedClasses.length + 1;
  const checks = [
    `Analicé ${ch.mainClass.name} y su asociación con ${names}`,
    'Creé los constructores y conecté los objetos de una clase con otra',
  ];

  if (level === 'basico') {
    checks.push('Implementé los métodos indicados en las 2 clases');
  } else if (level === 'intermedio') {
    checks.push(`Implementé los métodos de las ${classCount} clases sin usar List`);
  } else {
    checks.push(`Implementé los métodos de las ${classCount} clases y encadené la asociación`);
  }

  checks.push('Probé la asociación completa en el método Main');
  return checks;
};
---

<Layout
  title="Desafíos de POO Game — Asociación y Combate por Turnos (40 Desafíos)"
  description="40 desafíos de POO con temática de videojuegos: 20 retos nuevos de asociación simple (2, 3 y 4 clases) y 20 combates por turnos avanzados con Pokémon, Yu-Gi-Oh, Minecraft, Fortnite, RPGs y más."
>
  <article class="content-section">
    <div class="header-badge-row">
      <p class="kicker">POO Gamer · Clases & Asociación</p>
      <span class="game-pill">🎮 40 Desafíos · Ruta Guiada</span>
    </div>
    <h1>Desafíos de POO Game — Asociación y Combate por Turnos</h1>
    <p class="hero-desc">
      Aprende a modelar <strong>asociación y composición pura entre clases</strong> (sin herencia) con temática de videojuegos. 
      Empieza por los <strong>20 retos nuevos</strong> ordenados por dificultad: asociación de <strong>2 clases</strong> (1–10), 
      <strong>3 clases sin usar listas</strong> (11–15) y <strong>4 clases</strong> (16–20); después salta a los 
      <strong>20 combates por turnos 1v1</strong> (21–40) con armas, escudos, habilidades y listas de ítems consumibles.
    </p>
    <p class="muted">
      Ruta canónica: <code>/challenges/poo-game</code> · Módulos relacionados: <a href="/challenges/poo/">/challenges/poo</a> (clases básicas), <a href="/challenges/inheritance/">/challenges/inheritance</a> (herencia) y <a href="/challenges/interface/">/challenges/interface</a> (interfaces).
    </p>

    <!-- Ruta por niveles (filtro + guía) -->
    <div class="level-ruta" id="levelRuta">
      <p class="level-ruta-title">🗺️ Ruta de aprendizaje — elige un nivel para filtrar</p>
      <div class="level-chips" role="group" aria-label="Filtrar desafíos por nivel">
        <button type="button" class="level-filter-btn is-active" data-level-filter="todos">🎯 Todos ({totalChallenges})</button>
        {levelSummary.map((item) => (
          <button type="button" class="level-filter-btn" data-level-filter={item.level}>
            {item.meta.icon} {item.meta.short} ({item.count})
          </button>
        ))}
      </div>
      <ul class="level-cards">
        {levelSummary.map((item) => (
          <li class="level-card" data-level-card={item.level}>
            <span class="level-card-head">
              <strong>{item.meta.icon} {item.meta.label}</strong>
              <span class="level-card-count">{item.count} retos</span>
            </span>
            <span class="level-card-detail">{item.meta.detail}</span>
            <span class="level-card-range">Desafíos {item.from} – {item.to}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Barra de herramientas superior -->
    <div class="exercise-toolbar">
      <p class="exercise-toolbar-hint">
        <strong>{totalChallenges} desafíos</strong> · Selecciona o expande para ver el diagrama de asociación UML y probar la lógica:
      </p>
      <div class="exercise-toolbar-actions">
        <div class="global-uml-switch" role="group" aria-label="Notación UML global">
          <button type="button" class="global-format-btn" data-global-format="classic" title="Formato Clásico (nombre: Tipo)">🏛️ Clásico</button>
          <button type="button" class="global-format-btn" data-global-format="alt" title="Formato Alternativo (Tipo nombre)">⚡ Alternativo</button>
        </div>
        <button type="button" id="expandAll" class="toolbar-btn">Expandir todo</button>
        <button type="button" id="collapseAll" class="toolbar-btn toolbar-btn--ghost">Colapsar todo</button>
      </div>
    </div>

    <!-- Lista de Desafíos Gamer -->
    <div id="exerciseList" class="exercise-list">
      {pooGameChallenges.map((ch) => {
        const level = pooGameLevelOf(ch);
        const levelMeta = pooGameLevelMeta[level];
        const totalClasses = ch.associatedClasses.length + 1;
        return (
        <details class="ex-card" id={ch.slug} data-ex-id={`poo-game-${ch.id}`} data-level={level}>
          <summary class="ex-summary">
            <span class="ex-num" aria-hidden="true">{String(ch.id).padStart(2, '0')}</span>
            <div class="ex-summary-main">
              <div class="ex-title-row">
                <h3>{ch.id}. {ch.title}</h3>
                <span class="theme-tag">{ch.icon} {ch.gameTheme}</span>
                <span class={`level-tag level-tag--${level}`}>{levelMeta.icon} {levelMeta.short}</span>
              </div>
              <span class="ex-summary-meta">
                Clase Principal: <strong>{ch.mainClass.name}</strong> · {totalClasses} clases en total · {ch.relations.length} conexiones (o-- / *--)
              </span>
            </div>
            <span class="ex-progress" data-progress-for={`poo-game-${ch.id}`}>0 / 4</span>
            <span class="ex-chevron" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
            </span>
          </summary>
          <div class="ex-body">
            <div class="battle-scenario-banner">
              <span class="scenario-icon">{ch.icon}</span>
              <div class="scenario-text">
                <strong>{level === 'experto' ? 'Escenario de Batalla' : 'Escenario de Juego'}:</strong>
                <p>{ch.context}</p>
              </div>
            </div>

            <p class="ex-task">
              <strong>🎯 Misión POO:</strong> {ch.task}
            </p>

            {ch.methodHints && ch.methodHints.length > 0 && (
              <div class="method-hints">
                <p class="method-hints-title">💡 Métodos que puedes implementar</p>
                <ul>
                  {ch.methodHints.map((hint) => (
                    <li><code>{hint}</code></li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Diagrama UML en Mermaid con relaciones de Asociación y Composición -->
            <div class="diagram-wrapper">
              <MermaidDiagram title={`Diagrama de Asociación — ${ch.title}`} code={toMermaidGame(ch)} />
            </div>

            <div class="ex-checks">
              {checksFor(ch).map((label, i) => (
                <label class="chk"><input type="checkbox" data-check-id={`paso_${i + 1}`} /> {label}</label>
              ))}
            </div>

            <!-- Botón de Solución Protegido -->
            <div class="solution-trigger-wrap" style="margin-top: 1.25rem;">
              <button type="button" class="solution-btn open-solution-btn" data-target-solution={`poo-game-sol-${ch.id}`}>
                🔒 Ingresa la clave para ver la solución en Java
              </button>
            </div>

            <div id={`poo-game-sol-${ch.id}`} class="solution-content-hidden" style="display:none;">
              <div class="sol-header">
                <h4>
                  <span>💡 Simulación Java Completa:</span>
                  <span class="sol-badge">{ch.mainClass.name} ({levelMeta.label.split('·')[1]?.trim()})</span>
                </h4>
              </div>
              <p class="sol-desc">
                Código Java funcional listo para compilar y ejecutar con la simulación en consola:
              </p>
              <div class="code-block-wrap">
                <pre><code>{ch.solutionCodeJava}</code></pre>
              </div>
            </div>
          </div>
        </details>
      );
      })}
    </div>

    <!-- Modal de Contraseña para Soluciones -->
    <div id="passwordModal" class="poo-modal" aria-hidden="true">
      <div class="poo-modal-backdrop" id="closePassModalBackdrop"></div>
      <div class="poo-modal-panel" role="dialog" aria-modal="true" style="max-width: 420px; text-align: center; padding: 2rem;">
        <div class="modal-lock-icon" style="font-size: 2.5rem; margin-bottom: 0.5rem;">🔐</div>
        <h3 style="margin-bottom: 0.5rem; font-size: 1.3rem;">Acceso Privado a Resultados</h3>
        <p style="font-size: 0.92rem; color: var(--text-secondary); margin-bottom: 1.5rem;">
          Ingresa la clave para ver el código de solución en Java
        </p>

        <form id="passForm" style="display: flex; flex-direction: column; gap: 1rem;">
          <input
            type="password"
            id="passInput"
            placeholder="Clave (ej: ddmmyyyy)"
            required
            style="padding: 0.75rem 1rem; border-radius: 8px; border: 2px solid var(--border-color); font-size: 1.1rem; text-align: center; font-weight: 700; background: var(--bg-primary); color: var(--text-primary);"
          />
          <p id="passErrorMsg" style="color: #ef4444; font-weight: 700; font-size: 0.88rem; display: none; margin: 0;">
            ⚠️ Clave incorrecta. Inténtalo de nuevo.
          </p>
          <div style="display: flex; gap: 0.75rem; justify-content: center; margin-top: 0.5rem;">
            <button type="button" id="btnCancelPass" style="padding: 0.6rem 1.2rem; border-radius: 8px; border: 1.5px solid var(--border-color); background: transparent; color: var(--text-primary); font-weight: 700; cursor: pointer;">
              Cancelar
            </button>
            <button type="submit" style="padding: 0.6rem 1.4rem; border-radius: 8px; border: none; background: #1e1210; color: white; font-weight: 800; cursor: pointer;">
              Desbloquear 🔓
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Navegación a otros módulos POO -->
    <div class="next-modules">
      <a href="/challenges/poo/" class="unit-card unit-card--basic">
        <h3>← POO Básico (Clases Únicas)</h3>
        <p>20 clases sin herencia para dominar constructores y atributos.</p>
      </a>
      <a href="/challenges/inheritance/" class="unit-card unit-card--inheritance">
        <h3>→ Herencia y Polimorfismo</h3>
        <p>20 jerarquías de herencia clase base + hijas para el siguiente nivel.</p>
      </a>
      <a href="/challenges/interface/" class="unit-card unit-card--interface">
        <h3>→ Interfaces y Contratos</h3>
        <p>20 contratos de desacoplamiento y polimorfismo por interfaz.</p>
      </a>
    </div>
  </article>

  <script is:inline>
    (function () {
      const KEY = 'aprende_poo_game_v2';
      const readStore = () => {
        try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; }
      };
      const writeStore = (s) => localStorage.setItem(KEY, JSON.stringify(s));
      const updateProgressFor = (exId) => {
        const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
        if (!card) return;
        const boxes = card.querySelectorAll('input[type="checkbox"][data-check-id]');
        const done = Array.from(boxes).filter((b) => b.checked).length;
        const total = boxes.length;
        const els = card.querySelectorAll('[data-progress-for="' + exId + '"]');
        els.forEach((el) => {
          el.textContent = done + ' / ' + total;
          el.classList.toggle('is-done', done === total && total > 0);
        });
      };

      document.querySelectorAll('.ex-card[data-ex-id]').forEach((card) => {
        const exId = card.getAttribute('data-ex-id');
        const perEx = (readStore()[exId]) || {};
        card.querySelectorAll('input[type="checkbox"][data-check-id]').forEach((input) => {
          const checkId = input.getAttribute('data-check-id');
          input.checked = Boolean(perEx[checkId]);
          input.addEventListener('click', (e) => e.stopPropagation());
          input.addEventListener('change', () => {
            const s = readStore();
            if (!s[exId]) s[exId] = {};
            s[exId][checkId] = input.checked;
            writeStore(s);
            updateProgressFor(exId);
          });
        });
        updateProgressFor(exId);
      });

      document.getElementById('expandAll')?.addEventListener('click', () => {
        document.querySelectorAll('.ex-card[id]').forEach((d) => { if (!d.hidden) d.open = true; });
      });
      document.getElementById('collapseAll')?.addEventListener('click', () => {
        document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = false));
      });

      // Filtro por nivel de la ruta de aprendizaje
      const levelButtons = Array.from(document.querySelectorAll('[data-level-filter]'));
      const applyLevelFilter = (level) => {
        document.querySelectorAll('.ex-card[data-level]').forEach((card) => {
          card.hidden = !(level === 'todos' || card.getAttribute('data-level') === level);
        });
        document.querySelectorAll('[data-level-card]').forEach((card) => {
          card.classList.toggle('is-highlight', level !== 'todos' && card.getAttribute('data-level-card') === level);
        });
        levelButtons.forEach((btn) => {
          btn.classList.toggle('is-active', btn.getAttribute('data-level-filter') === level);
        });
      };
      levelButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          applyLevelFilter(btn.getAttribute('data-level-filter'));
        });
      });
      applyLevelFilter('todos');

      // Lógica de contraseña para soluciones inline
      let targetSolId = null;
      const passModal = document.getElementById('passwordModal');
      const passForm = document.getElementById('passForm');
      const passInput = document.getElementById('passInput');
      const passErrorMsg = document.getElementById('passErrorMsg');
      const passBackdrop = document.getElementById('closePassModalBackdrop');
      const btnCancelPass = document.getElementById('btnCancelPass');

      function getExpectedKey() {
        const now = new Date();
        const dd = String(now.getDate()).padStart(2, '0');
        const mm = String(now.getMonth() + 1).padStart(2, '0');
        const yyyy = now.getFullYear();
        return dd + mm + yyyy; // Ej: 27082026
      }

      function openPassModal(solId) {
        targetSolId = solId;
        if (passInput) passInput.value = '';
        if (passErrorMsg) passErrorMsg.style.display = 'none';
        if (passModal) {
          passModal.classList.add('is-open');
          passModal.setAttribute('aria-hidden', 'false');
          setTimeout(() => passInput?.focus(), 100);
        }
      }

      function closePassModal() {
        if (passModal) {
          passModal.classList.remove('is-open');
          passModal.setAttribute('aria-hidden', 'true');
        }
        targetSolId = null;
      }

      document.querySelectorAll('.open-solution-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const solId = btn.getAttribute('data-target-solution');
          const targetDiv = document.getElementById(solId);
          if (targetDiv && targetDiv.style.display !== 'none') {
            targetDiv.style.display = 'none';
            btn.textContent = '🔒 Ingresa la clave para ver la solución en Java';
            return;
          }
          openPassModal(solId);
        });
      });

      if (passBackdrop) passBackdrop.addEventListener('click', closePassModal);
      if (btnCancelPass) btnCancelPass.addEventListener('click', closePassModal);

      if (passForm) {
        passForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const enteredKey = passInput.value.trim();
          const expectedKey = getExpectedKey();

          if (enteredKey === expectedKey) {
            if (targetSolId) {
              const targetDiv = document.getElementById(targetSolId);
              if (targetDiv) {
                targetDiv.style.display = 'block';
                const triggerBtn = document.querySelector('[data-target-solution="' + targetSolId + '"]');
                if (triggerBtn) {
                  triggerBtn.textContent = '🔓 Ocultar Solución';
                }
              }
            }
            closePassModal();
          } else {
            if (passErrorMsg) passErrorMsg.style.display = 'block';
            passInput?.select();
          }
        });
      }

      const openFromHash = () => {
        const hash = location.hash.replace(/^#/, '');
        if (!hash) return;
        const target = document.getElementById(hash);
        if (target && target.classList.contains('ex-card') && 'open' in target) {
          if (target.hidden) applyLevelFilter('todos');
          target.open = true;
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };
      window.addEventListener('hashchange', openFromHash);
      if (location.hash) setTimeout(openFromHash, 80);
    })();
  </script>

  <style>
    .kicker {
      margin: 0;
      font-size: 0.72rem;
      font-weight: 900;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #b45309;
    }
    .header-badge-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 0.35rem;
    }
    .game-pill {
      background: #7c2d12;
      color: #fff8ee;
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 0.78rem;
      padding: 0.3rem 0.75rem;
      border-radius: 999px;
      border: 2px solid #1e1210;
      box-shadow: 2px 2px 0 #1e1210;
    }
    .hero-desc {
      font-size: 1.05rem;
      line-height: 1.6;
      color: var(--text-primary);
      margin: 0.5rem 0 0.8rem;
    }
    .muted {
      color: var(--text-muted);
      font-weight: 650;
      line-height: 1.6;
    }
    /* Ruta por niveles */
    .level-ruta {
      margin: 1.25rem 0 1rem;
      padding: 1rem 1.1rem;
      background: linear-gradient(135deg, #fffbeb, #ffffff);
      border: 3px solid #1e1210;
      border-radius: 18px;
      box-shadow: 5px 5px 0 #1e1210;
    }
    .level-ruta-title {
      margin: 0 0 0.7rem;
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 0.95rem;
      color: #7c2d12;
    }
    .level-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }
    .level-filter-btn {
      appearance: none;
      border: 2px solid #1e1210;
      background: #ffffff;
      color: #1e1210;
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 0.8rem;
      padding: 0.35rem 0.8rem;
      border-radius: 999px;
      cursor: pointer;
      box-shadow: 2px 2px 0 rgba(30, 18, 16, 0.18);
      transition: transform 0.1s, background 0.12s, color 0.12s;
    }
    .level-filter-btn:hover {
      transform: translateY(-1px);
    }
    .level-filter-btn.is-active {
      background: #1e1210;
      color: #fff8ee;
    }
    .level-cards {
      list-style: none;
      margin: 0.9rem 0 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 0.7rem;
    }
    .level-card {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      background: #ffffff;
      border: 2px dashed rgba(30, 18, 16, 0.3);
      border-radius: 14px;
      padding: 0.7rem 0.8rem;
    }
    .level-card.is-highlight {
      border-style: solid;
      border-color: #d97706;
      background: #fffbeb;
      box-shadow: 3px 3px 0 rgba(217, 119, 6, 0.35);
    }
    .level-card-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.4rem;
      font-family: 'Nunito', sans-serif;
      font-size: 0.83rem;
      color: #1e1210;
    }
    .level-card-count {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      font-weight: 700;
      color: #b45309;
      white-space: nowrap;
    }
    .level-card-detail {
      font-size: 0.8rem;
      line-height: 1.45;
      color: var(--text-secondary);
      font-weight: 650;
    }
    .level-card-range {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      font-weight: 700;
      color: #7c2d12;
    }
    .level-tag {
      border: 1.5px solid #1e1210;
      border-radius: 999px;
      padding: 0.14rem 0.55rem;
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 0.7rem;
      white-space: nowrap;
    }
    .level-tag--basico { background: #dcfce7; color: #166534; }
    .level-tag--intermedio { background: #fef9c3; color: #854d0e; }
    .level-tag--avanzado { background: #ffedd5; color: #9a3412; }
    .level-tag--experto { background: #fee2e2; color: #991b1b; }
    .method-hints {
      margin: 0 0 0.9rem;
      padding: 0.8rem 0.95rem;
      background: #f0fdf4;
      border: 2px solid #16a34a;
      border-left-width: 5px;
      border-radius: 12px;
    }
    .method-hints-title {
      margin: 0 0 0.45rem;
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 0.86rem;
      color: #166534;
    }
    .method-hints ul {
      margin: 0;
      padding-left: 1.1rem;
      display: grid;
      gap: 0.3rem;
    }
    .method-hints li {
      font-size: 0.84rem;
      line-height: 1.45;
      color: var(--text-secondary);
    }
    .method-hints code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8rem;
      background: #dcfce7;
      color: #14532d;
      border: 1px solid #86efac;
      border-radius: 6px;
      padding: 0.05rem 0.35rem;
    }
    .exercise-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin: 1.25rem 0 0.85rem;
      padding: 0.75rem 1rem;
