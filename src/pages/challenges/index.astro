---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Desafíos de programación"
  description="Catálogo en lista de ejercicios y desafíos de lógica por unidades y POO."
>
  <article class="content-section max-w-4xl mx-auto px-2 sm:px-4 py-4">
    <!-- Header principal -->
    <div class="mb-4 pb-3 border-b-2 border-dashed border-[#1E1210]/15 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <p class="m-0 text-[0.7rem] font-nunito font-extrabold uppercase tracking-widest text-[#7c2d12]">Catálogo Completo</p>
        <h1 class="m-0 text-2xl sm:text-3xl font-nunito font-black text-[#1E1210]">Desafíos de Programación</h1>
      </div>
    </div>

    <!-- Buscador destacado -->
    <div class="mb-5">
      <div class="relative w-full">
        <input
          type="text"
          id="challengeSearch"
          placeholder="🔍 Buscar desafío por palabra clave (ej: POO, Si, entrada, herencia, contratos)..."
          class="w-full pl-4 pr-10 py-3 rounded-2xl border-[3px] border-[#1E1210] font-nunito font-bold text-sm bg-white shadow-[4px_4px_0px_#1E1210] focus:outline-none focus:ring-2 focus:ring-[#EF476F]"
        />
        <button
          type="button"
          id="clearSearch"
          class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-xs font-nunito font-black bg-gray-200 hover:bg-gray-300 rounded-full w-5 h-5 items-center justify-center text-gray-700 cursor-pointer"
        >✕</button>
      </div>
    </div>

    <!-- CONTENEDOR EN LISTA VERTICAL -->
    <div class="flex flex-col gap-2.5" id="challengesContainer">

      <!-- GRUPO 1: LÓGICA -->
      <div class="group-header text-xs font-nunito font-black uppercase tracking-wider text-[#64748b] mt-1 mb-0.5 flex items-center gap-1.5 border-b border-[#CBD5E1] pb-1">
        <span>⚡</span> Lógica de Programación por Unidades
      </div>

      <a href="/challenges/unidad-1/" class="list-item search-target" data-keywords="unidad 1 eps entrada proceso salida basico variables">
        <div class="item-accent" style="background: #0284c7;"></div>
        <div class="item-icon" style="background: #E0F2FE; color: #0284c7;">📥</div>
        <div class="item-main">
          <div class="item-header">
            <h3 class="item-title">Unidad 1 — Entrada, Proceso y Salida (EPS)</h3>
            <span class="item-tag" style="background: #0284c7;">Lógica · U1</span>
          </div>
          <p class="item-desc">Operaciones básicas, asignación de variables y algoritmos secuenciales sin decisiones complejas.</p>
        </div>
        <div class="item-arrow" style="color: #0284c7;">→</div>
      </a>

      <a href="/challenges/unidad-2/" class="list-item search-target" data-keywords="unidad 2 decisiones si sino entonces condicionales flujo">
        <div class="item-accent" style="background: #10b981;"></div>
        <div class="item-icon" style="background: #D1FAE5; color: #10b981;">🔀</div>
        <div class="item-main">
          <div class="item-header">
            <h3 class="item-title">Unidad 2 — Decisiones y Condicionales</h3>
            <span class="item-tag" style="background: #10b981;">Decisiones · U2</span>
          </div>
          <p class="item-desc">Control de flujo condicional con <code>Si / Entonces / Sino</code> y evaluación de condiciones.</p>
        </div>
        <div class="item-arrow" style="color: #10b981;">→</div>
      </a>

      <a href="/challenges/unidad-3/" class="list-item search-target" data-keywords="unidad 3 avanzado combinadas decisiones ramas complejo">
        <div class="item-accent" style="background: #d97706;"></div>
        <div class="item-icon" style="background: #FEF3C7; color: #d97706;">🧩</div>
        <div class="item-main">
          <div class="item-header">
            <h3 class="item-title">Unidad 3 — Desafíos de Lógica Avanzada</h3>
            <span class="item-tag" style="background: #d97706;">Avanzado · U3</span>
          </div>
          <p class="item-desc">Problemas combinados de alta complejidad lógica con múltiples variables y decisiones.</p>
        </div>
        <div class="item-arrow" style="color: #d97706;">→</div>
      </a>

      <a href="/challenges/unidad-4/" class="list-item search-target" data-keywords="unidad 4 guia problemas integrador presupuesto supermercado notas luz torneo">
        <div class="item-accent" style="background: #ec4899;"></div>
        <div class="item-icon" style="background: #FCE7F3; color: #ec4899;">🏆</div>
        <div class="item-main">
          <div class="item-header">
            <h3 class="item-title">Unidad 4 — Guía Integradora (5 Problemas)</h3>
            <span class="item-tag" style="background: #ec4899;">Integrador · U4</span>
          </div>
          <p class="item-desc">Presupuesto, supermercado, sistema de notas, factura de luz y torneo de deportes.</p>
        </div>
        <div class="item-arrow" style="color: #ec4899;">→</div>
      </a>

      <!-- GRUPO 2: POO Y UML -->
      <div class="group-header text-xs font-nunito font-black uppercase tracking-wider text-[#64748b] mt-4 mb-0.5 flex items-center gap-1.5 border-b border-[#CBD5E1] pb-1">
        <span>🧱</span> Programación Orientada a Objetos (POO & UML)
      </div>

      <a href="/challenges/poo/" class="list-item search-target" data-keywords="poo basico clases unicas instancias atributos metodos 10 ejercicios">
        <div class="item-accent" style="background: #7c2d12;"></div>
        <div class="item-icon" style="background: #FFF7ED; color: #7c2d12;">🧱</div>
        <div class="item-main">
          <div class="item-header">
            <h3 class="item-title">POO Básico — Clases Únicas</h3>
            <span class="item-tag" style="background: #7c2d12;">10 Ejercicios</span>
          </div>
          <p class="item-desc">10 clases independientes sin herencia: atributos, métodos, encapsulamiento y objetos.</p>
        </div>
        <div class="item-arrow" style="color: #7c2d12;">→</div>
      </a>

      <a href="/challenges/inheritance/" class="list-item search-target" data-keywords="herencia polimorfismo jerarquias 20 ejercicios niveles abstracto">
        <div class="item-accent" style="background: #1e1210;"></div>
        <div class="item-icon" style="background: #F4EBD0; color: #1e1210;">🌳</div>
        <div class="item-main">
          <div class="item-header">
            <h3 class="item-title">Herencia y Polimorfismo — Jerarquías</h3>
            <span class="item-tag" style="background: #1e1210;">20 Ejercicios</span>
          </div>
          <p class="item-desc">20 jerarquías completas (Base + 3 hijas y 3 niveles: Interfaz → Abstracta → Hijas).</p>
        </div>
        <div class="item-arrow" style="color: #1e1210;">→</div>
      </a>

      <a href="/challenges/interface/" class="list-item search-target" data-keywords="interfaces contratos desacoplamiento 20 ejercicios arquitectura polimorfismo">
        <div class="item-accent" style="background: #6d28d9;"></div>
        <div class="item-icon" style="background: #F5F0FF; color: #6d28d9;">🔌</div>
        <div class="item-main">
          <div class="item-header">
            <h3 class="item-title">Interfaces y Contratos — Desacoplamiento</h3>
            <span class="item-tag" style="background: #6d28d9;">20 Ejercicios</span>
          </div>
          <p class="item-desc">20 contratos con implementaciones múltiples y jerarquías de 3 niveles para desacoplar.</p>
        </div>
        <div class="item-arrow" style="color: #6d28d9;">→</div>
      </a>

      <!-- Mensaje cuando no hay resultados de búsqueda -->
      <div id="noResults" class="hidden text-center py-8 bg-gray-50 border-2 border-dashed border-gray-300 rounded-2xl mt-2">
        <p class="font-nunito font-bold text-gray-600 m-0">No se encontraron desafíos que coincidan con tu búsqueda.</p>
        <button type="button" onclick="document.getElementById('challengeSearch').value=''; document.getElementById('challengeSearch').dispatchEvent(new Event('input'))" class="mt-2 text-xs font-nunito font-black text-blue-600 underline cursor-pointer">Ver todos los desafíos</button>
      </div>

    </div>
  </article>

  <script is:inline>
    const searchInput = document.getElementById('challengeSearch');
    const clearBtn = document.getElementById('clearSearch');
    const noResults = document.getElementById('noResults');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        const items = document.querySelectorAll('.search-target');
        const headers = document.querySelectorAll('.group-header');
        let visibleCount = 0;

        if (clearBtn) {
          if (query.length > 0) clearBtn.classList.remove('hidden');
          else clearBtn.classList.add('hidden');
        }

        items.forEach((item) => {
          const keywords = item.getAttribute('data-keywords') || '';
          const text = item.textContent.toLowerCase();
          const matches = text.includes(query) || keywords.includes(query);
          
          if (matches) {
            item.style.display = 'flex';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        // Ocultar cabeceras si se busca algo específico
        headers.forEach((h) => {
          h.style.display = query ? 'none' : 'flex';
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          searchInput.dispatchEvent(new Event('input'));
          searchInput.focus();
        });
      }
    }
  </script>

  <style>
    /* ITEM DE LISTA ULTRA-LIMPIO Y HORIZONTAL */
    .list-item {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.85rem;
      background: #FFFFFF;
      border: 2px solid #1E1210;
      border-radius: 14px;
      padding: 0.75rem 1rem 0.75rem 1.1rem;
      box-shadow: 3px 3px 0px #1E1210;
      text-decoration: none;
      color: inherit;
      overflow: hidden;
      transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
    }

    .list-item:hover {
      transform: translateX(4px);
      box-shadow: 4px 4px 0px #1E1210;
      background: #FAFAFA;
    }

    .item-accent {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 6px;
    }

    .item-icon {
      font-size: 1.35rem;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1.5px solid #1E1210;
      border-radius: 10px;
      flex-shrink: 0;
      box-shadow: 1px 1px 0px #1E1210;
    }

    .item-main {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .item-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .item-title {
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 0.98rem;
      color: #1E1210;
      margin: 0;
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .item-tag {
      color: #FFFFFF;
      font-family: 'Nunito', sans-serif;
      font-weight: 800;
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      padding: 0.12rem 0.5rem;
      border-radius: 999px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .item-desc {
      font-family: 'Quicksand', sans-serif;
      font-weight: 600;
      font-size: 0.8rem;
      color: #475569;
      margin: 0;
      line-height: 1.35;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .item-arrow {
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 1.3rem;
      flex-shrink: 0;
      transition: transform 0.12s ease;
      padding-left: 0.25rem;
    }

    .list-item:hover .item-arrow {
      transform: translateX(3px);
    }

    @media (max-width: 640px) {
      .item-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.2rem;
      }
      .item-desc {
        white-space: normal;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
      }
    }
  </style>
</Layout>
