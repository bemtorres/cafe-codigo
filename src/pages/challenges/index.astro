---
import Layout from '../../layouts/Layout.astro';

const modules = [
  {
    block: 'Fundamentos de Lógica y Algoritmos',
    blockNum: 1,
    color: '#0284c7',
    items: [
      {
        slug: 'unidad-1',
        title: 'Entrada, Proceso y Salida (EPS)',
        level: 'Inicial',
        count: 10,
        countLabel: '10 Desafíos',
        icon: '📥',
        color: '#0284c7',
        bgIcon: '#E0F2FE',
        desc: 'Operaciones secuenciales, asignación de variables, fórmulas aritméticas y muestra de resultados sin condicionales.',
        keywords: 'unidad 1 eps entrada proceso salida basico variables secuencia',
      },
      {
        slug: 'unidad-2',
        title: 'Condicionales y Tomas de Decisiones',
        level: 'Básico',
        count: 50,
        countLabel: '50 Desafíos',
        icon: '🔀',
        color: '#10b981',
        bgIcon: '#D1FAE5',
        desc: 'Evaluación de condiciones simples y compuestas con Si / Entonces / Sino en 50 situaciones de la vida real.',
        keywords: 'unidad 2 decisiones si sino entonces condicionales flujo si-entonces',
      },
      {
        slug: 'unidad-3',
        title: 'Decisiones Anidadas y Lógica Avanzada',
        level: 'Intermedio',
        count: 10,
        countLabel: '10 Desafíos',
        icon: '🧩',
        color: '#d97706',
        bgIcon: '#FEF3C7',
