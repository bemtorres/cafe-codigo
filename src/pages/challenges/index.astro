    ],
  },
  {
    block: 'Estructuras de Datos Primarias y Combinadas',
    blockNum: 2,
    color: '#8b5cf6',
    items: [
      {
        slug: 'arreglos-1d-fundamentos',
        title: 'Arreglos 1D — Fundamentos',
        level: 'Básico',
        count: 10,
        countLabel: '10 Desafíos',
        icon: '📊',
        color: '#2563eb',
        bgIcon: '#EFF6FF',
        desc: 'Declarar, recorrer por índice, acumular y encontrar valores extremos en arreglos unidimensionales.',
        keywords: 'arreglos 1d vectores arrays posiciones indices for suma promedio min max',
      },
      {
        slug: 'arreglos-1d-desafios',
        title: 'Arreglos 1D — Desafíos',
        level: 'Intermedio',
        count: 20,
        countLabel: '20 Desafíos',
        icon: '🔄',
        color: '#0891b2',
        bgIcon: '#ECFEFF',
        desc: 'Búsqueda, inversión de vectores, eliminación de duplicados, frecuencias y ordenamiento.',
        keywords: 'arreglos 1d desafios busqueda invertir frecuencia ordenamiento elementos',
      },
      {
        slug: 'diccionarios',
        title: 'Diccionarios y Mapas',
        level: 'Intermedio',
        count: 20,
        countLabel: '20 Desafíos',
        icon: '📖',
        color: '#8b5cf6',
        bgIcon: '#F5F3FF',
        desc: 'Estructuras asociativas clave-valor: agregar, consultar, eliminar, iterar y construir agendas.',
        keywords: 'diccionarios mapas hashes clave valor asociativo dict hashtable',
      },
      {
        slug: 'arreglos-diccionarios',
        title: 'Arreglos + Diccionarios',
        level: 'Avanzado',
        count: 20,
        countLabel: '20 Desafíos',
        icon: '🗂️',
        color: '#4f46e5',
        bgIcon: '#EEF2FF',
        desc: 'Colecciones de registros asociativos: modelado de personas, productos y datos complejos.',
        keywords: 'arreglos diccionarios combinadas registros tablas objetos json',
      },
      {
        slug: 'matrices-2d',
        title: 'Matrices 2D',
        level: 'Avanzado',
        count: 20,
        countLabel: '20 Desafíos',
        icon: '🔲',
        color: '#059669',
        bgIcon: '#ECFDF5',
        desc: 'Recorrido por filas y columnas, suma de bordes, diagonales y transposición de matrices.',
        keywords: 'matrices 2d bidimensional filas columnas grilla diagonal transponer',
      },
      {
        slug: 'list-arraylist',
        title: 'Colecciones Dinámicas (List)',
        level: 'Avanzado',
        count: 20,
        countLabel: '20 Desafíos',
        icon: '📦',
        color: '#d97706',
        bgIcon: '#FFFBEB',
        desc: 'Paso de arreglos fijos a colecciones dinámicas: inserción, borrado, filtrado y sorting.',
        keywords: 'list arraylist listas dinamicas colecciones push pop remove add',
      },
      {
        slug: 'list-diccionarios',
        title: 'List + Diccionario',
        level: 'Avanzado+',
        count: 20,
        countLabel: '20 Desafíos',
        icon: '📑',
        color: '#7c3aed',
        bgIcon: '#F5F3FF',
        desc: 'Listas dinámicas con diccionarios: pedidos, clientes, inventarios y notas.',
        keywords: 'list diccionarios registros dinámicos clientes inventarios pedidos',
      },
    ],
  },
  {
    block: 'Programación Orientada a Objetos (POO)',
    blockNum: 3,
    color: '#7c2d12',
    items: [
      {
        slug: 'poo',
        title: 'POO Básico — Clases Únicas',
        level: 'POO Inicial',
        count: 10,
        countLabel: '10 Desafíos',
        icon: '🧱',
        color: '#7c2d12',
        bgIcon: '#FFF7ED',
        desc: 'Clases independientes sin herencia: atributos, métodos, constructores, encapsulamiento y UML.',
        keywords: 'poo basico clases unicas instancias atributos metodos 10 ejercicios',
      },
      {
        slug: 'inheritance',
        title: 'Herencia y Polimorfismo',
        level: 'POO Avanzado',
        count: 20,
        countLabel: '20 Desafíos',
        icon: '🌳',
        color: '#1e1210',
        bgIcon: '#F4EBD0',
        desc: 'Jerarquías completas con clase base + hijas y 3 niveles: Interfaz → Abstracta → Hijas.',
        keywords: 'herencia polimorfismo jerarquias 20 ejercicios niveles abstracto',
      },
      {
        slug: 'interface',
        title: 'Interfaces y Contratos',
        level: 'POO Avanzado',
        count: 20,
        countLabel: '20 Desafíos',
        icon: '🔌',
        color: '#6d28d9',
        bgIcon: '#F5F0FF',
        desc: '20 contratos con implementaciones múltiples para desacoplamiento y polimorfismo.',
        keywords: 'interfaces contratos desacoplamiento 20 ejercicios arquitectura polimorfismo',
      },
      {
        slug: 'poo-list',
        title: 'POO + Colecciones Dinámicas',
        level: 'POO Experto',
        count: 20,
        countLabel: '20 Desafíos',
        icon: '👥',
        color: '#be185d',
        bgIcon: '#FDF2F8',
        desc: 'Gestión de listas de objetos: List<Persona>, List<Alumno>, List<Producto>.',
        keywords: 'poo list arraylist objetos colecciones list<objeto> gestor',
      },
      {
        slug: 'poo-combinadas',
        title: 'POO + Estructuras Combinadas',
        level: 'POO Experto+',
        count: 20,
        countLabel: '20 Desafíos',
        icon: '🏢',
        color: '#0369a1',
        bgIcon: '#F0F9FF',
        desc: 'Relaciones 1 a N: Cliente → List<Pedido> → List<Producto>. Agregación y composición.',
        keywords: 'poo combinadas relaciones 1 a n agregacion composicion cliente pedido producto',
      },
      {
        slug: 'desafios-integradores',
        title: 'Desafíos Integradores de Sistema',
        level: 'Maestría',
        count: 20,
        countLabel: '20 Sistemas',
        icon: '🚀',
        color: '#431407',
        bgIcon: '#FEF3C7',
        desc: 'Sistemas reales sin estructura impuesta: el estudiante decide la arquitectura completa.',
        keywords: 'desafios integradores sistemas tienda biblioteca banco reservas carrito inventario',
      },
    ],
  },
];

const totalModules = modules.reduce((acc, b) => acc + b.items.length, 0);
const totalExercises = modules.reduce((acc, b) => acc + b.items.reduce((a, i) => a + i.count, 0), 0);
---

<Layout
  title="Ruta de Desafíos de Programación — Estructuras de Datos y POO"
  description="Ruta pedagógica progresiva de desafíos de programación: desde lógica básica hasta Arreglos, Diccionarios, Matrices y POO."
>
  <article class="challenges-hub">

    <!-- ═══ HERO HEADER ═══ -->
    <header class="hub-hero">
      <div class="hero-glow"></div>
      <div class="hero-content">
        <span class="hero-badge">Ruta Pedagógica Progresiva</span>
        <h1 class="hero-title">Desafíos de Programación</h1>
        <p class="hero-sub">
          Una ruta ordenada desde <strong>conceptos iniciales</strong> hasta <strong>POO y sistemas completos</strong>.
          Válido para <strong>Python, Java, C#, C++, JavaScript, PHP o PSeInt</strong>.
        </p>
        <div class="hero-stats">
          <div class="stat-pill">
            <span class="stat-num">{totalModules}</span>
            <span class="stat-label">módulos</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-pill">
            <span class="stat-num">{totalExercises.toLocaleString('es-CL')}</span>
            <span class="stat-label">ejercicios</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-pill">
            <span class="stat-num">3</span>
            <span class="stat-label">bloques</span>
          </div>
        </div>
      </div>
    </header>

    <!-- ═══ SEARCH + FILTERS ═══ -->
    <div class="hub-toolbar">
      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input
          type="text"
          id="challengeSearch"
          placeholder="Buscar por tema (arreglos, matrices, POO, si-entonces...)"
          class="search-input"
        />
        <button type="button" id="clearSearch" class="search-clear hidden">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="filter-pills" id="filterPills">
        <button type="button" class="pill pill--active" data-filter="all">Todos</button>
        <button type="button" class="pill" data-filter="1" style="--pill-c:#0284c7">Lógica</button>
        <button type="button" class="pill" data-filter="2" style="--pill-c:#8b5cf6">Datos</button>
        <button type="button" class="pill" data-filter="3" style="--pill-c:#7c2d12">POO</button>
      </div>
    </div>

    <!-- ═══ BLOCKS ═══ -->
    <div class="blocks-container" id="challengesContainer">
      {modules.map((blk) => (
        <section class="block-section search-block" data-block-num={blk.blockNum}>
          <div class="block-header" style={`--block-c:${blk.color}`}>
            <div class="block-num">{blk.blockNum}</div>
            <div class="block-info">
              <h2 class="block-title">{blk.block}</h2>
              <span class="block-count">{blk.items.length} módulos</span>
            </div>
          </div>

          <div class="cards-grid">
            {blk.items.map((item, idx) => (
              <a
                href={`/challenges/${item.slug}/`}
                class="card search-target"
                data-keywords={item.keywords}
                style={`--card-c:${item.color}; --card-bg:${item.bgIcon}; --card-i:${idx}`}
              >
                <div class="card-accent"></div>
                <div class="card-body">
                  <div class="card-top">
                    <div class="card-icon-wrap" style={`background:${item.bgIcon}`}>
                      <span class="card-icon">{item.icon}</span>
                    </div>
                    <div class="card-meta">
                      <h3 class="card-title">{item.title}</h3>
                      <span class="card-level">{item.level}</span>
                    </div>
                    <span class="card-count" style={`background:${item.bgIcon}; color:${item.color}; border-color:${item.color}30`}>
                      {item.countLabel}
                    </span>
                  </div>
                  <p class="card-desc">{item.desc}</p>
                </div>
                <div class="card-footer">
                  <div class="card-progress">
                    <div class="progress-bar" style={`background:${item.color}20`}>
                      <div class="progress-fill" style={`background:${item.color}; width:${Math.min(item.count * 2, 100)}%`}></div>
                    </div>
                    <span class="progress-text">{item.count} ejercicios</span>
                  </div>
                  <span class="card-arrow" style={`color:${item.color}`}>
                    Explorar
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}

      <div id="noResults" class="no-results hidden">
        <div class="no-results-icon">🔍</div>
        <p class="no-results-text">No se encontraron módulos que coincidan con tu búsqueda.</p>
        <button type="button" onclick="document.getElementById('challengeSearch').value=''; document.getElementById('challengeSearch').dispatchEvent(new Event('input'))" class="no-results-btn">
          Ver todos los módulos
        </button>
      </div>
    </div>

  </article>

  <!-- ═══ SCRIPTS ═══ -->
  <script is:inline>
    const searchInput = document.getElementById('challengeSearch');
    const clearBtn = document.getElementById('clearSearch');
    const targets = document.querySelectorAll('.search-target');
    const blocks = document.querySelectorAll('.search-block');
    const noResults = document.getElementById('noResults');
    const pills = document.querySelectorAll('.pill');
    let activeFilter = 'all';

    function applyFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      if (clearBtn) {
        clearBtn.classList.toggle('hidden', query.length === 0);
        clearBtn.classList.toggle('flex', query.length > 0);
      }

      targets.forEach((card) => {
        const keywords = card.getAttribute('data-keywords') || '';
        const text = card.textContent.toLowerCase();
        const matchesSearch = !query || text.includes(query) || keywords.includes(query);
        const blockNum = card.closest('.search-block')?.getAttribute('data-block-num');
        const matchesFilter = activeFilter === 'all' || blockNum === activeFilter;
        const show = matchesSearch && matchesFilter;
        card.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });

      blocks.forEach((blk) => {
        const visible = blk.querySelectorAll('.search-target:not([style*="display: none"])');
        blk.style.display = visible.length > 0 ? '' : 'none';
      });

      if (noResults) noResults.style.display = visibleCount === 0 ? 'flex' : 'none';
    }

    searchInput?.addEventListener('input', applyFilters);
    clearBtn?.addEventListener('click', () => {
      searchInput.value = '';
      applyFilters();
      searchInput.focus();
    });

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('pill--active'));
        pill.classList.add('pill--active');
        activeFilter = pill.getAttribute('data-filter');
        applyFilters();
      });
    });
  </script>

  <style>
    /* ═══════════════════════════════════
       HUB DE DESAFÍOS — DISEÑO ELEGANTE
       ═══════════════════════════════════ */

    .challenges-hub {
      max-width: 1120px;
      margin: 0 auto;
      padding: 1.5rem 1rem 3rem;
    }

    /* ─── HERO ─── */
    .hub-hero {
      position: relative;
      overflow: hidden;
      border: 3px solid #1E1210;
      border-radius: 20px;
      padding: 2.5rem 2rem 2rem;
      margin-bottom: 1.5rem;
      background: linear-gradient(135deg, #FFFDF7 0%, #FFF9C4 40%, #E0F7FA 100%);
      box-shadow: 6px 6px 0 #1E1210;
    }
    .hero-glow {
      position: absolute;
      top: -60%;
      right: -20%;
      width: 400px;
      height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(6,214,160,0.15) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-content { position: relative; z-index: 1; }
    .hero-badge {
      display: inline-block;
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #7c2d12;
      background: rgba(255,255,255,0.7);
      border: 2px solid #7c2d1230;
      border-radius: 999px;
      padding: 0.3rem 0.9rem;
      margin-bottom: 0.8rem;
      backdrop-filter: blur(4px);
    }
    .hero-title {
      margin: 0;
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: clamp(1.6rem, 4vw, 2.5rem);
      color: #1E1210;
      line-height: 1.15;
    }
    .hero-sub {
      margin: 0.6rem 0 0;
      font-family: 'Quicksand', sans-serif;
      font-weight: 600;
      font-size: 0.92rem;
      color: #4A3A37;
      line-height: 1.6;
      max-width: 600px;
    }
    .hero-sub strong { color: #1E1210; font-weight: 800; }
    .hero-stats {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: 1.2rem;
      flex-wrap: wrap;
    }
    .stat-pill {
      display: flex;
      align-items: baseline;
      gap: 0.35rem;
    }
    .stat-num {
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 1.4rem;
      color: #1E1210;
    }
    .stat-label {
      font-family: 'Quicksand', sans-serif;
      font-weight: 700;
      font-size: 0.78rem;
      color: #6B5B58;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .stat-divider {
      width: 1px;
      height: 24px;
      background: #1E121020;
    }

    /* ─── TOOLBAR ─── */
    .hub-toolbar {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .search-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }
    .search-icon {
      position: absolute;
      left: 1rem;
      width: 18px;
      height: 18px;
      color: #6B5B58;
      pointer-events: none;
    }
    .search-input {
      width: 100%;
      padding: 0.85rem 2.5rem 0.85rem 2.8rem;
      border: 3px solid #1E1210;
      border-radius: 14px;
      background: #fff;
      font-family: 'Nunito', sans-serif;
      font-weight: 700;
      font-size: 0.88rem;
      color: #1E1210;
      box-shadow: 4px 4px 0 #1E1210;
      outline: none;
      transition: box-shadow 0.2s, transform 0.2s;
    }
    .search-input::placeholder { color: #9CA3AF; font-weight: 600; }
    .search-input:focus {
      box-shadow: 5px 5px 0 #06D6A0;
      transform: translateY(-1px);
    }
    .search-clear {
      position: absolute;
      right: 0.85rem;
      width: 26px;
      height: 26px;
      border-radius: 8px;
      border: 2px solid #1E1210;
      background: #E5E7EB;
      color: #1E1210;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s;
    }
    .search-clear:hover { background: #D1D5DB; }

    /* ─── FILTER PILLS ─── */
    .filter-pills {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
    .pill {
      font-family: 'Nunito', sans-serif;
      font-weight: 800;
      font-size: 0.72rem;
      letter-spacing: 0.03em;
      padding: 0.38rem 0.85rem;
      border-radius: 999px;
      border: 2px solid #1E1210;
      background: #fff;
      color: #1E1210;
      cursor: pointer;
      box-shadow: 2px 2px 0 #1E1210;
      transition: all 0.15s;
    }
    .pill:hover {
      transform: translateY(-1px);
      box-shadow: 3px 3px 0 var(--pill-c, #1E1210);
      background: var(--pill-c, #fff);
      color: #fff;
    }
    .pill--active {
      background: #1E1210;
      color: #fff;
      box-shadow: 2px 2px 0 #1E1210;
    }

    /* ─── BLOCKS ─── */
    .blocks-container { display: flex; flex-direction: column; gap: 2rem; }

    .block-section { scroll-margin-top: 1rem; }

    .block-header {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 3px solid var(--block-c);
    }
    .block-num {
      flex-shrink: 0;
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: var(--block-c);
      color: #fff;
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 1rem;
      display: grid;
      place-items: center;
      border: 2px solid #1E1210;
      box-shadow: 2px 2px 0 #1E1210;
    }
    .block-info { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
    .block-title {
      margin: 0;
      font-family: 'Nunito', sans-serif;
      font-weight: 900;
      font-size: 1.05rem;
      color: #1E1210;
    }
    .block-count {
      font-family: 'Nunito', sans-serif;
      font-weight: 800;
      font-size: 0.7rem;
      color: #6B5B58;
