      },
      {
        slug: 'functions',
        title: 'Funciones y Métodos',
        level: 'Intermedio',
        count: 52,
        countLabel: '52 Ejercicios',
        icon: '⚙️',
        color: '#0284c7',
        bgIcon: '#E0F2FE',
