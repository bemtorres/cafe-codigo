---
import Layout from '../../../layouts/Layout.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import { javaFunctionsWorkshop, totalWorkshopExercises } from '../../../data/javaFunctionsWorkshop';

---

<Layout
  title={`Taller de Métodos y Funciones en Java — ${totalWorkshopExercises} ejercicios`}
  description="Taller universitario práctico de métodos y funciones en Java: 52 ejercicios incrementales en 6 bloques (void, parámetros, retorno, lambdas, recursión)."
>
  <article class="content-section">
    <p class="kicker">Taller Práctico · Java</p>
    <h1>Métodos y Funciones en Java</h1>
    <p>
      Taller de <strong>{totalWorkshopExercises} ejercicios</strong> organizados de forma incremental, pensado para una
      sesión de laboratorio universitario. Cada bloque sube un peldaño: desde <strong>métodos void sin parámetros</strong>
      hasta <strong>expresiones lambda</strong> y <strong>recursión</strong>.
    </p>
    <p class="muted">
      Ruta canónica: <code>/challenges/functions</code> · Cada ejercicio trae enunciado, firma sugerida,
      entrada/salida esperada y una pista. Resuélvelos en orden.
    </p>

    <!-- Barra de bloques -->
    <div class="block-nav">
      {javaFunctionsWorkshop.map((b) => (
        <a href={`#bloque-${b.num}`} class="block-nav-pill" style={`--bc:${b.color}`}>
          <span class="block-nav-num">{b.num}</span>
          <span class="block-nav-txt">{b.title}</span>
        </a>
      ))}
    </div>

    <div class="exercise-toolbar">
      <p class="exercise-toolbar-hint">{totalWorkshopExercises} ejercicios · clic para expandir cada uno</p>
      <div class="exercise-toolbar-actions">
        <button type="button" id="expandAll" class="toolbar-btn">Expandir todo</button>
        <button type="button" id="collapseAll" class="toolbar-btn toolbar-btn--ghost">Colapsar todo</button>
      </div>
    </div>

    {javaFunctionsWorkshop.map((block) => (
      <section class="workshop-block" id={`bloque-${block.num}`}>
        <header class="block-header" style={`--bc:${block.color}`}>
          <span class="block-badge">Bloque {block.num}</span>
          <div>
            <h2>{block.title}</h2>
            <p class="block-sub">{block.subtitle}</p>
          </div>
          <span class="block-count">{block.exercises.length} ejercicios</span>
        </header>

        <div class="exercise-list">
          {block.exercises.map((ex) => (
            <details class="ex-card" id={`ej-${ex.id}`}>
              <summary class="ex-summary">
                <span class="ex-num" aria-hidden="true" style={`background:${block.color}`}>{ex.id}</span>
                <div class="ex-summary-main">
                  <h3>{ex.id}. {ex.title}</h3>
                  <span class="ex-summary-meta">{ex.statement}</span>
                </div>
                <span class="ex-chevron" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
                </span>
              </summary>
              <div class="ex-body">
                <p class="ex-statement"><strong>Enunciado:</strong> {ex.statement}</p>

                <div class="ex-field">
                  <span class="ex-label">Firma sugerida</span>
                  <CodeBlock code={ex.signature} lang="java" title={`Ejercicio ${ex.id}`} />
                </div>

                <div class="ex-field">
                  <span class="ex-label">Entrada / Salida esperada</span>
                  <pre class="io-box">{ex.io}</pre>
                </div>

                <div class="ex-field">
                  <span class="ex-label">Pista</span>
                  <p class="ex-hint">{ex.hint}</p>
                </div>
              </div>
            </details>
          ))}
        </div>
      </section>
    ))}
  </article>

  <script is:inline>
    (function () {
      document.getElementById('expandAll')?.addEventListener('click', () => {
        document.querySelectorAll('.ex-card').forEach((d) => (d.open = true));
      });
      document.getElementById('collapseAll')?.addEventListener('click', () => {
        document.querySelectorAll('.ex-card').forEach((d) => (d.open = false));
      });
      // Deep-link a un ejercicio
      const hash = location.hash.replace(/^#/, '');
      if (hash && document.getElementById(hash)) {
        const el = document.getElementById(hash);
        el.open = true;
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    })();
  </script>

  <style>
    .kicker{margin:0; font-size:0.7rem; font-weight:900; letter-spacing:0.16em; text-transform:uppercase; color:#E76F00}
    .muted{color:var(--text-muted); font-weight:650; line-height:1.6}

    .block-nav{display:flex; flex-wrap:wrap; gap:0.5rem; margin:1.1rem 0 0.5rem}
    .block-nav-pill{display:inline-flex; align-items:center; gap:0.45rem; text-decoration:none; border:3px solid var(--border); border-radius:999px; padding:0.35rem 0.7rem; background:#fff; font-family:'Nunito',sans-serif; font-weight:900; font-size:0.78rem; color:var(--text-primary); box-shadow:3px 3px 0 var(--border); transition:transform .12s, box-shadow .12s}
    .block-nav-pill:hover{transform:translateY(-2px); box-shadow:5px 5px 0 var(--bc)}
    .block-nav-num{display:grid; place-items:center; width:22px; height:22px; border-radius:999px; background:var(--bc); color:#fff; font-size:0.72rem}
    .block-nav-txt{white-space:nowrap}

    .exercise-toolbar{display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:0.75rem; margin:0.9rem 0 0.75rem}
    .exercise-toolbar-hint{margin:0; font-family:'Nunito',sans-serif; font-weight:800; font-size:0.85rem; color:var(--text-muted)}
    .exercise-toolbar-actions{display:flex; gap:0.5rem; flex-wrap:wrap}
    .toolbar-btn{appearance:none; border:2px solid #1e1210; background:#E76F00; color:#fff; font-family:'Nunito',sans-serif; font-weight:900; font-size:0.82rem; padding:0.42rem 0.85rem; border-radius:999px; cursor:pointer; box-shadow:3px 3px 0 #1e1210}
    .toolbar-btn--ghost{background:#fff; color:#1e1210}

    .workshop-block{margin:1.6rem 0 0.5rem; scroll-margin-top:1.25rem}
    .block-header{display:flex; align-items:center; gap:0.85rem; padding:0.85rem 1rem; border:3px solid #1e1210; border-left-width:8px; border-left-color:var(--bc); border-radius:16px; background:rgba(255,255,255,0.85); box-shadow:4px 4px 0 rgba(30,18,16,0.12); margin-bottom:0.85rem}
    .block-badge{font-family:'Nunito',sans-serif; font-weight:900; font-size:0.8rem; color:#fff; background:var(--bc); border:2px solid #1e1210; border-radius:999px; padding:0.3rem 0.65rem; white-space:nowrap; box-shadow:2px 2px 0 rgba(30,18,16,0.2)}
    .block-header h2{margin:0; color:#1e1210; font-size:1.25rem; line-height:1.15}
    .block-sub{margin:0.1rem 0 0; font-size:0.85rem; font-weight:650; color:var(--text-secondary)}
    .block-count{margin-left:auto; font-family:'Nunito',sans-serif; font-weight:900; font-size:0.78rem; color:#1e1210; background:#fff; border:2px solid #1e1210; border-radius:999px; padding:0.28rem 0.6rem; white-space:nowrap; box-shadow:2px 2px 0 rgba(30,18,16,0.12)}

    .exercise-list{display:flex; flex-direction:column; gap:0.7rem}
    .ex-card{border:3px solid var(--border); border-radius:16px; background:rgba(255,255,255,0.82); box-shadow:0 14px 30px rgba(30,18,16,0.08); overflow:hidden; scroll-margin-top:1.25rem}
    .ex-card[open]{background:#fff}
    .ex-summary{display:flex; align-items:center; gap:0.7rem; padding:0.8rem 0.9rem; cursor:pointer; list-style:none; user-select:none}
    .ex-summary::-webkit-details-marker{display:none}
    .ex-num{flex-shrink:0; width:36px; height:36px; display:grid; place-items:center; color:#fff8ee; border:2px solid #1e1210; border-radius:11px; font-family:'Nunito',sans-serif; font-weight:900; font-size:0.8rem; box-shadow:2px 2px 0 rgba(30,18,16,0.14)}
    .ex-card[open] .ex-num{background:#1e1210}
    .ex-summary-main{flex:1; min-width:0}
    .ex-summary-main h3{margin:0; color:#1e1210; font-size:0.98rem; line-height:1.25}
    .ex-summary-meta{display:block; margin-top:0.15rem; font-size:0.78rem; font-weight:600; color:var(--text-muted); line-height:1.4}
    .ex-chevron{flex-shrink:0; width:32px; height:32px; display:grid; place-items:center; background:#fff; border:2px solid #1e1210; border-radius:999px; box-shadow:2px 2px 0 rgba(30,18,16,0.1); transition:transform 0.2s; color:#1e1210}
    .ex-card[open] .ex-chevron{transform:rotate(180deg); background:#ffd166}

    .ex-body{padding:0.85rem 1.1rem 1rem; border-top:2px dashed rgba(30,18,16,0.12); background:rgba(255,255,255,0.35)}
    .ex-field{margin-top:0.9rem}
    .ex-label{display:inline-block; font-family:'Nunito',sans-serif; font-weight:900; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.08em; color:#E76F00; margin-bottom:0.35rem}
    .io-box{background:#0f172a; color:#e2e8f0; font-family:'JetBrains Mono',ui-monospace,monospace; font-size:0.82rem; line-height:1.5; padding:0.8rem 0.95rem; border-radius:12px; border:2px solid #1e1210; box-shadow:3px 3px 0 rgba(30,18,16,0.15); white-space:pre-wrap; margin:0; overflow-x:auto}
    .ex-hint{margin:0; padding:0.65rem 0.9rem; background:#FFF9C4; border-left:5px solid #C5A059; border-radius:8px; color:#4a3f1a; font-weight:600; font-size:0.92rem; line-height:1.55}

    @media(max-width:640px){
      .ex-summary{gap:0.55rem; padding:0.72rem}
      .ex-num{width:32px; height:32px}
      .block-header{flex-wrap:wrap; gap:0.6rem}
      .block-count{margin-left:0}
    }
  </style>
</Layout>
