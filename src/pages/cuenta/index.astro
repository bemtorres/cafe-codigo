---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Cuenta desactivada" description="Sistema de cuentas deshabilitado temporalmente. Disfruta de todos los cursos e interactivos de forma libre y gratuita.">
  <div class="mx-auto max-w-2xl px-4 py-16 text-center">
    <div class="inline-flex h-20 w-20 items-center justify-center rounded-3xl border-4 border-[#1E1210] bg-[#FFF7ED] text-4xl shadow-[4px_4px_0px_#1E1210] mb-6">
      🔓
    </div>
    <h1 class="font-nunito text-3xl font-black text-[#1E1210] sm:text-4xl mb-4">
      Acceso Libre sin Registro
    </h1>
    <p class="font-nunito text-base font-semibold text-slate-600 leading-relaxed max-w-lg mx-auto mb-8">
      Actualmente el sistema de cuentas está desactivado. Puedes acceder a <strong>todos los cursos, guías, desafíos e interactivos</strong> de forma 100% libre y gratuita sin necesidad de iniciar sesión.
    </p>
    <div class="flex flex-wrap justify-center gap-3 font-nunito font-extrabold text-sm">
      <a
        href="/cursos/"
        class="inline-flex items-center gap-2 rounded-full border-3 border-[#1E1210] bg-[#10B981] px-6 py-3 text-white no-underline shadow-[3px_3px_0px_#1E1210] hover:-translate-y-0.5 transition-all"
      >
        📚 Explorar Cursos
      </a>
      <a
        href="/challenges/"
        class="inline-flex items-center gap-2 rounded-full border-3 border-[#1E1210] bg-white px-6 py-3 text-[#1E1210] no-underline shadow-[3px_3px_0px_#1E1210] hover:-translate-y-0.5 transition-all"
      >
        🎯 Ver Desafíos
      </a>
    </div>
  </div>
</Layout>
