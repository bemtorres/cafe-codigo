---
import ExpressChallengeLayout from "../../../layouts/ExpressChallengeLayout.astro";
import { expressArraysExercises } from "../../../data/challengesExpressArrays";
import { ExpressChallengeGame } from "../../../components/ExpressChallengeGame";
---

<ExpressChallengeLayout
  title="Desafíos Express — Arreglos, Listas & Vectores (1D)"
  description="Domina el manejo de arreglos, índices, búsquedas de mínimos/máximos, filtros y dos punteros en C++, Python, JavaScript y Java."
>
  <main class="min-h-screen bg-slate-50 text-slate-800 font-sans pb-16">
    <ExpressChallengeGame
      client:load
      allExercises={expressArraysExercises}
      categoryTitle="Arreglos & Listas"
      backUrl="/challenges-express/"
    />
  </main>
</ExpressChallengeLayout>
