---
import ExpressChallengeLayout from "../../../layouts/ExpressChallengeLayout.astro";
import { expressMatricesExercises } from "../../../data/challengesExpressMatrices";
import { ExpressChallengeGame } from "../../../components/ExpressChallengeGame";
---

<ExpressChallengeLayout
  title="Desafíos Express — Matrices & Arreglos 2D"
  description="Domina el manejo de tablas, coordenadas [fila][columna], diagonales, transposiciones y algoritmos sobre cuadrículas en C++, Python, JavaScript y Java."
>
  <main class="min-h-screen bg-slate-50 text-slate-800 font-sans pb-16">
    <ExpressChallengeGame
      client:load
      allExercises={expressMatricesExercises}
      categoryTitle="Matrices & Arreglos 2D"
      backUrl="/challenges-express/"
    />
  </main>
</ExpressChallengeLayout>
