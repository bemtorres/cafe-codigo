---
import ExpressChallengeLayout from "../../../layouts/ExpressChallengeLayout.astro";
import { expressConditionalsExercises } from "../../../data/challengesExpressConditionals";
import { ExpressChallengeGame } from "../../../components/ExpressChallengeGame";
---

<ExpressChallengeLayout
  title="Desafíos Express — Estructuras Condicionales"
  description="Entrena tus habilidades de programación completando y corrigiendo sentencias if, else if, else y operadores lógicos con editor CodeMirror interactivo."
>
  <main class="min-h-screen bg-slate-50 text-slate-800 font-sans pb-16">
    <ExpressChallengeGame
      client:load
      allExercises={expressConditionalsExercises}
      categoryTitle="Estructuras Condicionales"
      backUrl="/challenges-express/"
    />
  </main>
</ExpressChallengeLayout>
