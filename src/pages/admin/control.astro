---
import AdminShellLayout from '../../layouts/AdminShellLayout.astro';
import { courses } from '../../data/courses';
import {
  ArrowRight,
  BookOpen,
  ChartColumn,
  Check,
  Presentation,
  Search,
  Trophy,
  Users,
  Zap,
} from '@lucide/astro';

// Métricas de cursos y diapositivas
const totalCourses = courses.length;
const totalLessons = courses.reduce((acc, c) => acc + (c.lessons?.length ?? 0), 0);

const pptCourses = courses
  .map((course) => {
    const hasExplicitLessonSlides = (course.lessons || []).some((l) => l.hasSlides === true);
    const slideLessons = (course.lessons || []).filter((l) =>
      hasExplicitLessonSlides ? l.hasSlides === true : Boolean(course.hasSlides)
    );
    return {
      slug: course.slug,
      name: course.name,
      lessons: slideLessons,
    };
  })
  .filter((c) => c.lessons.length > 0);

const totalPptLessons = pptCourses.reduce((acc, c) => acc + c.lessons.length, 0);

const adminModules = [
  {
    title: 'Embed Cursos & Quizzes',
    badge: 'LMS & Contenido',
    Icon: BookOpen,
    description:
      'Generador de URLs e iframes para incrustar lecciones y cursos completos en Canvas, Moodle, Blackboard o páginas externas con personalización por parámetros GET.',
    href: '/admin/embed/',
    stats: `${totalCourses} cursos · ${totalLessons} lecciones`,
    features: ['Branding institucional', 'Opciones de quiz on/off', 'Generación de links seguros'],
    ctaText: 'Abrir generador',
  },
  {
    title: 'Embed Desafíos Express',
    badge: 'Interactivos',
    Icon: Zap,
    description:
      'Crea minijuegos de programación interactivos con temporizador, vidas limitadas, niveles de dificultad y selección de lenguaje (C++, Python, JavaScript, Java).',
    href: '/admin/embed-challenges-express/',
    stats: '11 módulos · 90+ ejercicios',
    features: ['Vidas / intentos configurables', 'Filtro por dificultad (E/M/A)', 'Modo examen cronometrado'],
    ctaText: 'Configurar desafíos',
  },
  {
    title: 'Embed PPT / Slides',
    badge: '5 estilos visuales',
    Icon: Presentation,
    description:
      'Presentaciones interactivas en diapositivas con soporte dinámico de 5 sistemas de diseño (Google, Apple, Microsoft, AWS, Vercel) y parámetro &style= en URL.',
    href: '/admin/embed-ppt/',
    stats: `${pptCourses.length} cursos activos (${totalPptLessons} lecciones)`,
    features: ['Parámetro &style= en tiempo real', 'Temporizador flotante movible', 'Evaluación de 10 preguntas'],
    ctaText: 'Crear presentación',
  },
  {
    title: 'Dashboard de Rendimiento',
    badge: 'Analítica',
    Icon: ChartColumn,
    description:
      'Métricas globales de actividad, tasa de finalización de ejercicios, visitas a lecciones y datos agregados de rendimiento de los estudiantes.',
    href: '/admin/dashboard/',
    stats: 'Monitoreo en tiempo real',
    features: ['Progreso por estudiante', 'Tasas de acierto en quizzes', 'Historial de actividad'],
    ctaText: 'Ver métricas',
  },
  {
    title: 'Gestión de Usuarios',
    badge: 'Comunidad & Roles',
    Icon: Users,
    description:
      'Administración de perfiles de usuario, asignación de permisos docentes, supervisión de cuentas registradas y control de accesos.',
    href: '/admin/users/',
    stats: 'Control de accesos y roles',
    features: ['Roles (admin, docente, alumno)', 'Edición de perfiles', 'Historial de sesiones'],
    ctaText: 'Gestionar usuarios',
  },
  {
    title: 'Gestor de Insignias',
    badge: 'Gamificación',
    Icon: Trophy,
    description:
      'Configuración de insignias de logro, medallas por resolución de retos de código y reglas de desbloqueo automático para motivar el aprendizaje.',
    href: '/admin/badges/',
    stats: 'Catálogo de reconocimientos',
    features: ['Niveles bronce, plata, oro', 'Criterios de desbloqueo', 'Diseño de insignias'],
    ctaText: 'Administrar insignias',
  },
];

const stats = [
  { label: 'Cursos activos', value: String(totalCourses), hint: 'Catálogo total' },
  { label: 'Lecciones', value: String(totalLessons), hint: 'En todos los cursos' },
  {
    label: 'Presentaciones PPT',
    value: String(totalPptLessons),
    hint: `${pptCourses.length} cursos con slides`,
  },
  { label: 'Desafíos Express', value: '90+', hint: '11 módulos temáticos' },
];

const quickLinks = [
  {
    href: '/course-slides/django/modelo-bd/?style=cupertino',
    label: 'PPT: Django · modelo-bd',
    meta: '?style=cupertino',
  },
  {
    href: '/challenges-express/',
    label: 'Desafíos Express en vivo',
    meta: '11 módulos',
  },
  { href: '/cursos/', label: 'Catálogo público', meta: 'Portal de cursos' },
  { href: '/admin/embed/?preset=clean', label: 'Embed limpio', meta: 'Sin quiz ni branding' },
];
---

<AdminShellLayout
  title="Admin · Centro de Control"
  description="Panel centralizado de administración, generadores de embeds y herramientas de Café y Código."
  activeSection="control"
>
  <div class="mx-auto w-full max-w-7xl pb-8">
    <!-- HEADER DE PÁGINA -->
    <header>
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-2.5 py-1 text-[11px] font-medium text-zinc-600 shadow-sm"
      >
        <span class="size-1.5 rounded-full bg-emerald-500"></span>
        Centro de Control Operativo
      </span>

      <h1 class="mt-3 text-2xl tracking-tight text-zinc-950">
        Panel de Control y Herramientas
      </h1>
      <p class="mt-1 max-w-2xl text-sm leading-relaxed text-zinc-500">
        Centro neurálgico de <strong>Café y Código</strong>. Accede a los generadores de embeds de
        cursos, desafíos interactivos, presentaciones con múltiples temas y herramientas analíticas.
      </p>
    </header>

    <!-- TARJETAS DE ESTADÍSTICAS -->
    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {
        stats.map((stat) => (
          <div class="rounded-xl border border-zinc-200 bg-white p-4 shadow-sm">
            <p class="m-0 text-[11px] font-medium uppercase tracking-wider text-zinc-500">
              {stat.label}
            </p>
            <p class="m-0 mt-1 text-2xl font-semibold tabular-nums text-zinc-950">{stat.value}</p>
            <p class="m-0 mt-1 text-xs text-zinc-500">{stat.hint}</p>
          </div>
        ))
      }
    </div>

    <!-- BARRA DE HERRAMIENTAS -->
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div class="min-w-0">
        <h2 class="m-0 text-base text-zinc-950">Módulos de administración</h2>
        <p class="m-0 mt-0.5 text-xs text-zinc-500">
          Selecciona un módulo para abrir sus herramientas de configuración o generación de embeds.
        </p>
      </div>

      <div class="relative w-full sm:w-64">
        <Search
          class="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-zinc-400"
        />
        <input
          id="moduleSearch"
          type="text"
          placeholder="Filtrar herramientas..."
          aria-label="Filtrar herramientas"
          class="h-9 w-full rounded-md border border-zinc-200 bg-white pl-8 pr-3 text-sm text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-900/10"
        />
      </div>
    </div>

    <!-- CUADRÍCULA DE MÓDULOS -->
    <div id="modulesGrid" class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {
        adminModules.map((mod) => {
          const { Icon } = mod;
          return (
            <div
              class="admin-module-card group relative flex flex-col rounded-xl border border-zinc-200 bg-white p-5 shadow-sm transition-all hover:border-zinc-300 hover:shadow-md"
              data-title={mod.title.toLowerCase()}
              data-desc={mod.description.toLowerCase()}
            >
              <div class="flex items-start justify-between gap-3">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-zinc-200 bg-zinc-100 text-zinc-700">
                  <Icon class="size-5" />
                </span>
                <span class="rounded-full border border-zinc-200 bg-zinc-50 px-2 py-0.5 text-[11px] font-medium text-zinc-600">
                  {mod.badge}
                </span>
              </div>

              <h3 class="m-0 mt-4 text-base text-zinc-950">{mod.title}</h3>
              <p class="m-0 mt-1 text-xs leading-relaxed text-zinc-500">{mod.description}</p>

              <ul class="m-0 mt-4 list-none space-y-1.5 border-t border-zinc-100 p-0 pt-4">
                {mod.features.map((feat) => (
                  <li class="flex items-center gap-2 text-xs text-zinc-600">
                    <Check class="size-3.5 shrink-0 text-emerald-600" />
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-auto flex items-center justify-between gap-3 border-t border-zinc-100 pt-4">
                <span class="truncate font-mono text-[11px] text-zinc-400">{mod.stats}</span>
                <a
                  href={mod.href}
                  class="inline-flex h-8 shrink-0 items-center gap-1.5 rounded-md bg-zinc-900 px-3 text-xs font-medium text-white no-underline transition-colors hover:bg-zinc-800"
                >
                  <span>{mod.ctaText}</span>
                  <ArrowRight class="size-3.5" />
                </a>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- ACCESOS RÁPIDOS -->
    <section class="mt-8 rounded-xl border border-zinc-200 bg-white p-5 shadow-sm">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
        <h3 class="m-0 text-sm text-zinc-950">Accesos rápidos a recursos en vivo</h3>
        <span class="font-mono text-[11px] text-zinc-400">URLs directas para verificación</span>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          quickLinks.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith('/admin') ? undefined : '_blank'}
              rel="noopener"
              class="flex items-center justify-between gap-3 rounded-lg border border-zinc-200 bg-zinc-50 p-3 no-underline transition-colors hover:border-zinc-300 hover:bg-white"
            >
              <span class="min-w-0">
                <span class="block truncate text-xs font-medium text-zinc-800">{link.label}</span>
                <span class="mt-0.5 block truncate font-mono text-[11px] text-zinc-400">
                  {link.meta}
                </span>
              </span>
              <ArrowRight class="size-4 shrink-0 text-zinc-400" />
            </a>
          ))
        }
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      const searchInput = document.getElementById('moduleSearch');
      const cards = document.querySelectorAll('.admin-module-card');

      searchInput?.addEventListener('input', (e) => {
        const query = (e.target.value || '').toLowerCase().trim();
        cards.forEach((card) => {
          const title = card.getAttribute('data-title') || '';
          const desc = card.getAttribute('data-desc') || '';
          if (!query || title.includes(query) || desc.includes(query)) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    })();
  </script>
</AdminShellLayout>
