---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { courses } from '../../data/courses';
import { SLIDE_TEMPLATES, TEMPLATE_LIST } from '../../data/slides/templates';

// Filtrar estrictamente solo los cursos que tienen activada la PPT
// Un curso tiene PPT si tiene hasSlides: true o si alguna de sus lecciones tiene hasSlides: true
const pptCourses = courses
  .map((course) => {
    const hasExplicitLessonSlides = (course.lessons || []).some((l) => l.hasSlides === true);
    const slideLessons = (course.lessons || []).filter((l) =>
      hasExplicitLessonSlides ? l.hasSlides === true : Boolean(course.hasSlides)
    );
    return {
      slug: course.slug,
      name: course.name,
      description: course.description,
      color: course.color,
      category: course.category,
      hasSlides: course.hasSlides,
      lessons: slideLessons,
    };
  })
  .filter((c) => c.lessons.length > 0);

const totalPptLessons = pptCourses.reduce((acc, c) => acc + c.lessons.length, 0);
---

<AdminLayout
  title="Admin · Embed Presentaciones (PPT / Slides)"
  description="Generador interactivo de URLs y etiquetas iframe para diapositivas con soporte de estilos y parámetros."
  activeSection="ppt"
>
  <article class="content-section admin-embed w-full max-w-7xl mx-auto min-w-0 pb-12">
    <!-- CABECERA -->
    <header class="admin-embed-head mb-5">
      <div class="flex items-center gap-2 mb-2 flex-wrap">
        <a
          href="/admin/control/"
          class="text-xs font-bold text-slate-300 hover:text-white bg-slate-800/90 border border-slate-700 px-2 py-0.5 rounded-md transition-colors"
        >
          ← 🎛️ Centro de Control
        </a>
        <span class="text-slate-600">•</span>
        <a
          href="/admin/embed/"
          class="text-xs font-bold text-sky-400 hover:text-sky-300 transition-colors"
        >
          Embed Cursos
        </a>
        <span class="text-slate-600">•</span>
        <a
          href="/admin/embed-challenges-express/"
          class="text-xs font-bold text-amber-400 hover:text-amber-300 transition-colors"
        >
          ⚡ Desafíos Express
        </a>
        <span class="text-slate-600">•</span>
        <span class="text-xs font-black uppercase text-indigo-300 bg-indigo-950/80 border border-indigo-700/60 px-2.5 py-0.5 rounded-md flex items-center gap-1 shadow-xs">
          <span>📊</span>
          <span>Presentaciones PPT Activas</span>
        </span>
      </div>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div>
          <h1 class="!mb-1 !text-2xl sm:!text-3xl font-black text-white tracking-tight">
            /admin/embed-ppt
          </h1>
          <p class="!mb-0 !text-xs sm:!text-sm text-slate-300 font-medium max-w-3xl leading-relaxed">
            Generador exclusivo de URLs y etiquetas <code>&lt;iframe&gt;</code> para diapositivas y presentaciones interactivas.
            Solo se listan los cursos que tienen activada la PPT (ejemplo: 
            <a href="/course-slides/django/modelo-bd/" target="_blank" class="text-sky-400 underline font-mono hover:text-sky-300">
              Django · modelo-bd
            </a>).
          </p>
        </div>

        <div class="flex items-center gap-2 shrink-0 bg-slate-800/90 border border-slate-700/80 px-3.5 py-2 rounded-xl">
          <div class="text-right">
            <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 block">Cursos con PPT</span>
            <span class="text-lg font-black text-indigo-400 leading-none">{pptCourses.length} cursos ({totalPptLessons} lecciones)</span>
          </div>
          <span class="text-2xl">📽️</span>
        </div>
      </div>
    </header>

    <!-- FORMULARIO GENERADOR DE EMBED PPT -->
    <div class="rounded-2xl border-2 border-slate-700/80 bg-slate-800/90 p-4 sm:p-6 shadow-xl space-y-5">
      <!-- SELECTORES PRINCIPALES: CURSO, LECCIÓN, ESTILO, TEMA -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- CURSO -->
        <label class="ppt-field">
          <span class="ppt-lbl">Curso con PPT Activa</span>
          <select id="pptCourse" class="ppt-input">
            {pptCourses.map((c) => (
              <option value={c.slug} data-color={c.color}>
                {c.name} ({c.lessons.length} {c.lessons.length === 1 ? 'lección' : 'lecciones'})
              </option>
            ))}
          </select>
        </label>

        <!-- LECCIÓN -->
        <label class="ppt-field">
          <span class="ppt-lbl">Lección / Módulo</span>
          <select id="pptLesson" class="ppt-input">
            <!-- Se llena dinámicamente con JS según el curso -->
          </select>
        </label>

        <!-- ESTILO / PLANTILLA (style=) -->
        <label class="ppt-field">
          <span class="ppt-lbl">Estilo de Diseño (style=)</span>
          <select id="pptStyle" class="ppt-input">
            {TEMPLATE_LIST.map((tmpl) => (
              <option value={tmpl.id}>
                {tmpl.icon} {tmpl.name} ({tmpl.shortName})
              </option>
            ))}
          </select>
        </label>

        <!-- TEMA (theme=) -->
        <label class="ppt-field">
          <span class="ppt-lbl">Tema de Color (theme=)</span>
          <select id="pptTheme" class="ppt-input">
            <option value="dark">🌙 Dark Mode (Por defecto)</option>
            <option value="light">☀️ Light Mode</option>
          </select>
        </label>
      </div>

      <!-- BOTONES RÁPIDOS DE LOS 5 ESTILOS DE DISEÑO -->
      <div>
        <span class="ppt-lbl mb-2 block">Acceso Rápido a Estilos de Diapositivas:</span>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2">
          {TEMPLATE_LIST.map((tmpl) => (
            <button
              type="button"
              class="ppt-style-card p-2.5 rounded-xl border text-left flex flex-col justify-between transition-all cursor-pointer bg-slate-900/60 border-slate-700/70 hover:border-indigo-400 hover:bg-slate-800/80"
              data-style-btn={tmpl.id}
            >
              <div class="flex items-center justify-between mb-1">
                <span class="text-lg">{tmpl.icon}</span>
                <span class="text-[9px] font-mono font-bold uppercase text-slate-400 bg-slate-800 px-1.5 py-0.5 rounded">
                  {tmpl.id}
                </span>
              </div>
              <div class="font-extrabold text-xs text-white leading-tight">{tmpl.shortName}</div>
              <div class="text-[10px] text-slate-400 line-clamp-1 mt-0.5">{tmpl.tagline}</div>
              <div class="flex items-center gap-1 mt-2">
                {tmpl.palette.map((color) => (
                  <span
                    class="w-2.5 h-2.5 rounded-full inline-block border border-black/40"
                    style={`background-color: ${color};`}
                  />
                ))}
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- FLAGS Y OPCIONES DE VISUALIZACIÓN -->
      <div class="pt-3 border-t border-slate-700/60 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- BARRA INFERIOR (bar=) -->
        <label class="ppt-field">
          <span class="ppt-lbl">Barra de Navegación Inferior (bar=)</span>
          <select id="pptBar" class="ppt-input">
            <option value="visible">visible · Siempre Visible (Por defecto)</option>
            <option value="autohide">autohide · Ocultar automáticamente</option>
            <option value="hidden">hidden · Barra Oculta (Modo Quiosco)</option>
          </select>
        </label>

        <!-- TEMPORIZADOR (timer=) -->
        <label class="ppt-field">
          <span class="ppt-lbl">Temporizador Flotante (timer=)</span>
          <select id="pptTimer" class="ppt-input">
            <option value="0">Sin temporizador</option>
            <option value="180">180s (3 minutos)</option>
            <option value="300" selected>300s (5 minutos - Estándar)</option>
            <option value="600">600s (10 minutos)</option>
            <option value="900">900s (15 minutos)</option>
          </select>
        </label>

        <!-- FLAGS INTERACTIVOS (embed, quiz, metaquestions) -->
        <div class="ppt-field">
          <span class="ppt-lbl">Flags de Interacción</span>
          <div class="flex flex-col gap-2 mt-1">
            <label class="flex items-center gap-2 text-xs font-bold text-slate-200 cursor-pointer">
              <input id="pptFlagEmbed" type="checkbox" class="ppt-cb" checked />
              <span>embed=true (Optimizar para iframe)</span>
            </label>
            <label class="flex items-center gap-2 text-xs font-bold text-slate-200 cursor-pointer">
              <input id="pptFlagQuiz" type="checkbox" class="ppt-cb" checked />
              <span>quiz=true (Mostrar evaluación 10 preguntas)</span>
            </label>
            <label class="flex items-center gap-2 text-xs font-bold text-slate-200 cursor-pointer">
              <input id="pptFlagMeta" type="checkbox" class="ppt-cb" />
              <span>metaquestions=true (Diapositiva Metacognitiva)</span>
            </label>
          </div>
        </div>
      </div>

      <!-- BRANDING INSTITUCIONAL Y ESTUDIANTE -->
      <div class="pt-3 border-t border-slate-700/60">
        <span class="ppt-lbl mb-2 block">Personalización Institucional y Estudiante (Opcional):</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          <label class="ppt-field">
            <span class="ppt-lbl">Institución / Título (title=)</span>
            <input id="pptTitle" class="ppt-input" placeholder="Ej: Inacap, Duoc UC, Empresa..." />
          </label>
          <label class="ppt-field">
            <span class="ppt-lbl">Nombre Alumno (name=)</span>
            <input id="pptName" class="ppt-input" placeholder="Ej: Matías Torres" />
          </label>
          <label class="ppt-field">
            <span class="ppt-lbl">Email Alumno (email=)</span>
            <input id="pptEmail" class="ppt-input" placeholder="Ej: alumno@inacap.cl" />
          </label>
          <label class="ppt-field">
            <span class="ppt-lbl">URL Logo (logo=)</span>
            <input id="pptLogo" class="ppt-input" placeholder="https://.../logo.png" />
          </label>
        </div>
      </div>

      <!-- PRESETS RÁPIDOS -->
      <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-slate-700/60">
        <span class="text-xs font-black text-slate-400 uppercase tracking-wider">Presets de Configuración:</span>
        <div class="flex flex-wrap gap-1.5">
          <button type="button" class="ppt-chip" data-preset="standard">✨ Estándar (Material)</button>
          <button type="button" class="ppt-chip" data-preset="apple">🍎 Apple Cupertino</button>
          <button type="button" class="ppt-chip" data-preset="microsoft">🪟 Microsoft Fluent</button>
          <button type="button" class="ppt-chip" data-preset="aws">⚡ AWS Prime</button>
          <button type="button" class="ppt-chip" data-preset="cyber">🚀 Hyper Dev</button>
          <button type="button" class="ppt-chip" data-preset="noquiz">🚫 Sin Quiz</button>
          <button type="button" class="ppt-chip" data-preset="meta">🧠 Reflexión Metacognitiva</button>
          <button type="button" class="ppt-chip" data-preset="student">👤 Alumno Demo</button>
        </div>
      </div>
    </div>

    <!-- RESULTADO: URL GENERADA E IFRAME -->
    <section class="mt-6 space-y-4">
      <div class="bg-slate-800/90 border-2 border-slate-700/80 rounded-2xl p-4 sm:p-5 shadow-xl">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-black uppercase text-indigo-400 tracking-wider">URL Generada</span>
            <span class="text-[11px] font-mono text-slate-400">(Parámetro &style= incluido)</span>
          </div>
          <button
            id="btnCopyUrl"
            type="button"
            class="px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-black rounded-lg transition-all cursor-pointer shadow-sm active:scale-95"
          >
            📋 Copiar URL
          </button>
        </div>

        <div class="flex items-center gap-2">
          <input
            id="resultUrl"
            readonly
            class="w-full font-mono text-xs sm:text-sm p-3 rounded-xl bg-slate-900/90 border border-slate-700 text-indigo-300 font-bold select-all focus:outline-none focus:border-indigo-400"
          />
          <a
            id="btnOpenUrl"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-3 bg-slate-700 hover:bg-slate-600 text-white font-extrabold text-xs sm:text-sm rounded-xl shadow-xs shrink-0 flex items-center gap-1.5 transition-all"
            title="Abrir presentación en nueva pestaña"
          >
            <span>Probar</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <!-- CÓDIGO IFRAME EMBED -->
      <div class="bg-slate-800/90 border-2 border-slate-700/80 rounded-2xl p-4 sm:p-5 shadow-xl">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-black uppercase text-slate-400 tracking-wider">Código de Inserción &lt;iframe&gt;</span>
          <button
            id="btnCopyIframe"
            type="button"
            class="px-3.5 py-1.5 bg-sky-600 hover:bg-sky-500 text-white text-xs font-black rounded-lg transition-all cursor-pointer shadow-sm active:scale-95"
          >
            📋 Copiar Iframe
          </button>
        </div>

        <textarea
          id="resultIframe"
          readonly
          rows="3"
          class="w-full font-mono text-xs p-3 rounded-xl bg-slate-900/90 border border-slate-700 text-sky-300 font-bold select-all focus:outline-none focus:border-sky-400 resize-none"
        ></textarea>
      </div>

      <!-- VISTA PREVIA INTERACTIVA -->
      <div class="bg-slate-800/90 border-2 border-slate-700/80 rounded-2xl p-4 sm:p-5 shadow-xl">
        <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-black uppercase text-amber-400 tracking-wider">Vista Previa Interactiva en Vivo</span>
            <span class="text-[10px] text-slate-400 font-medium">(Iframe embebido)</span>
          </div>
          <div class="flex items-center gap-2">
            <button
              id="btnReloadPreview"
              type="button"
              class="px-3 py-1 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-bold rounded-lg transition-all cursor-pointer"
            >
              🔄 Recargar Vista Previa
            </button>
            <button
              id="btnTogglePreview"
              type="button"
              class="px-3 py-1 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-bold rounded-lg transition-all cursor-pointer"
            >
              👁️ Ocultar Preview
            </button>
          </div>
        </div>

        <div id="previewContainer" class="rounded-xl overflow-hidden border border-slate-700 bg-black aspect-[16/9] max-h-[640px] w-full">
          <iframe
            id="previewIframe"
            src="about:blank"
            class="w-full h-full border-0"
            allow="fullscreen; accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <!-- TABLA COMPLETA DE CURSOS Y LECCIONES CON PPT -->
    <section class="mt-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
        <div>
          <h2 class="text-base sm:text-lg font-black text-white m-0 flex items-center gap-2">
            <span>📚 Cursos y Lecciones con PPT Habilitada</span>
            <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-indigo-900/60 text-indigo-300 border border-indigo-700/50">
              {totalPptLessons} disponibles
            </span>
          </h2>
          <p class="text-xs text-slate-400 m-0 mt-0.5">
            Solo aparecen lecciones con diapositivas oficiales. Haz clic en cualquier botón para cargar la lección en el generador.
          </p>
        </div>

        <input
          id="tableSearch"
          type="text"
          placeholder="Buscar curso o lección..."
          class="ppt-input !w-auto min-w-[240px]"
        />
      </div>

      <div class="overflow-x-auto rounded-2xl border-2 border-slate-700/80 bg-slate-800/90 shadow-xl">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          <thead>
            <tr class="bg-slate-900/90 border-b border-slate-700 text-slate-400 text-[11px] font-black uppercase tracking-wider">
              <th class="p-3.5">Curso</th>
              <th class="p-3.5">Lección</th>
              <th class="p-3.5">Slug PPT</th>
              <th class="p-3.5">Ruta Completa</th>
              <th class="p-3.5 text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="pptTableBody" class="divide-y divide-slate-700/60">
            {pptCourses.map((c) =>
              c.lessons.map((l) => (
                <tr
                  class="hover:bg-slate-700/40 transition-colors ppt-table-row"
                  data-course-slug={c.slug}
                  data-lesson-slug={l.slug}
                  data-search-text={`${c.name} ${l.title} ${l.slug}`.toLowerCase()}
                >
                  <td class="p-3.5 align-middle">
                    <span
                      class="px-2.5 py-1 rounded-md text-[11px] font-black uppercase text-white shadow-xs inline-block"
                      style={`background-color: ${c.color};`}
                    >
                      {c.name}
                    </span>
                  </td>
                  <td class="p-3.5 font-bold text-white align-middle">
                    {l.title}
                  </td>
                  <td class="p-3.5 font-mono text-slate-400 text-xs align-middle">
                    <code class="bg-slate-900 px-2 py-0.5 rounded border border-slate-700 text-indigo-300">
                      {l.slug}
                    </code>
                  </td>
                  <td class="p-3.5 font-mono text-xs text-slate-300 align-middle">
                    <a
                      href={`/course-slides/${c.slug}/${l.slug}/`}
                      target="_blank"
                      class="text-sky-400 hover:underline hover:text-sky-300"
                    >
                      /course-slides/{c.slug}/{l.slug}/
                    </a>
                  </td>
                  <td class="p-3.5 text-right align-middle">
                    <div class="flex items-center justify-end gap-1.5">
                      <button
                        type="button"
                        class="px-2.5 py-1 rounded-lg bg-indigo-600/80 hover:bg-indigo-500 text-white font-bold text-xs transition-all cursor-pointer btn-select-ppt"
                        data-cslug={c.slug}
                        data-lslug={l.slug}
                      >
                        Cargar en Generador
                      </button>
                      <a
                        href={`/course-slides/${c.slug}/${l.slug}/`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="p-1 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-bold"
                        title="Abrir directamente"
                      >
                        ↗
                      </a>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </section>
  </article>

  <!-- JSON CON DATOS PARA CLIENT SCRIPT -->
  <script
    type="application/json"
    id="pptCoursesDataJson"
    is:inline
    set:html={JSON.stringify(pptCourses).replace(/</g, '\\u003c')}
  />

  <script is:inline>
    (function () {
      function initPptEmbedBuilder() {
        const rawJsonEl = document.getElementById('pptCoursesDataJson');
        if (!rawJsonEl) return;

        let pptCourses = [];
        try {
          pptCourses = JSON.parse(rawJsonEl.textContent || '[]');
        } catch (e) {
          console.error('Error parsing pptCoursesDataJson', e);
          return;
        }

        const $course = document.getElementById('pptCourse');
        const $lesson = document.getElementById('pptLesson');
        const $style = document.getElementById('pptStyle');
        const $theme = document.getElementById('pptTheme');
        const $bar = document.getElementById('pptBar');
        const $timer = document.getElementById('pptTimer');
        const $embed = document.getElementById('pptFlagEmbed');
        const $quiz = document.getElementById('pptFlagQuiz');
        const $meta = document.getElementById('pptFlagMeta');

        const $title = document.getElementById('pptTitle');
        const $name = document.getElementById('pptName');
        const $email = document.getElementById('pptEmail');
        const $logo = document.getElementById('pptLogo');

        const $resultUrl = document.getElementById('resultUrl');
        const $resultIframe = document.getElementById('resultIframe');
        const $btnOpenUrl = document.getElementById('btnOpenUrl');
        const $btnCopyUrl = document.getElementById('btnCopyUrl');
        const $btnCopyIframe = document.getElementById('btnCopyIframe');

        const $previewIframe = document.getElementById('previewIframe');
        const $btnReloadPreview = document.getElementById('btnReloadPreview');
        const $btnTogglePreview = document.getElementById('btnTogglePreview');
        const $previewContainer = document.getElementById('previewContainer');
        const $tableSearch = document.getElementById('tableSearch');

        // Actualizar opciones de lección según curso seleccionado
        function populateLessons(selectedCourseSlug, preferredLessonSlug) {
          const course = pptCourses.find((c) => c.slug === selectedCourseSlug) || pptCourses[0];
          if (!course) return;

          $lesson.innerHTML = '';
          course.lessons.forEach((l) => {
            const opt = document.createElement('option');
            opt.value = l.slug;
            opt.textContent = `${l.title} (${l.slug})`;
            if (preferredLessonSlug && l.slug === preferredLessonSlug) {
              opt.selected = true;
            }
            $lesson.appendChild(opt);
          });
        }

        // Resaltar tarjeta de estilo activa
        function highlightStyleCard(activeStyleId) {
          document.querySelectorAll('[data-style-btn]').forEach((btn) => {
            const sId = btn.getAttribute('data-style-btn');
            if (sId === activeStyleId) {
              btn.classList.add('ring-2', 'ring-indigo-400', 'bg-indigo-950/60', 'border-indigo-500');
              btn.classList.remove('bg-slate-900/60', 'border-slate-700/70');
            } else {
              btn.classList.remove('ring-2', 'ring-indigo-400', 'bg-indigo-950/60', 'border-indigo-500');
              btn.classList.add('bg-slate-900/60', 'border-slate-700/70');
            }
          });
        }

        // Construir URL y código Iframe
        function updateOutputs() {
          const cSlug = $course.value;
          const lSlug = $lesson.value;
          if (!cSlug || !lSlug) return;

          const origin = window.location.origin;
          const path = `/course-slides/${cSlug}/${lSlug}/`;
          const sp = new URLSearchParams();

          // 1. Estilo (SIEMPRE presente como &style=)
          const chosenStyle = $style.value || 'material';
          sp.set('style', chosenStyle);
          highlightStyleCard(chosenStyle);

          // 2. Embed flag
          if ($embed.checked) {
            sp.set('embed', 'true');
          }

          // 3. Tema
          if ($theme.value === 'light') {
            sp.set('theme', 'light');
          }

          // 4. Quiz
          if (!$quiz.checked) {
            sp.set('quiz', 'false');
          }

          // 5. Metacognición
          if ($meta.checked) {
            sp.set('metaquestions', 'true');
          }

          // 6. Barra
          if ($bar.value && $bar.value !== 'visible') {
            sp.set('bar', $bar.value);
          }

          // 7. Temporizador
          if ($timer.value && $timer.value !== '0') {
            sp.set('timer', $timer.value);
          }

          // 8. Personalización Institucional
          if ($title.value.trim()) {
            sp.set('title', $title.value.trim());
          }
          if ($name.value.trim()) {
            sp.set('name', $name.value.trim());
          }
          if ($email.value.trim()) {
            sp.set('email', $email.value.trim());
          }
          if ($logo.value.trim()) {
            sp.set('logo', $logo.value.trim());
          }

          const fullUrl = `${origin}${path}?${sp.toString()}`;
          $resultUrl.value = fullUrl;
          $btnOpenUrl.href = fullUrl;

          // Generar Iframe HTML responsive
          const iframeCode = `<iframe src="${fullUrl}" width="100%" height="700" frameborder="0" allow="fullscreen; accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="border:0; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);"></iframe>`;
          $resultIframe.value = iframeCode;

          // Actualizar preview iframe
          if ($previewIframe && $previewIframe.src !== fullUrl) {
            $previewIframe.src = fullUrl;
          }
        }

        // Listeners de cambio en controles
        $course.addEventListener('change', () => {
          populateLessons($course.value);
          updateOutputs();
        });

        $lesson.addEventListener('change', updateOutputs);
        $style.addEventListener('change', updateOutputs);
        $theme.addEventListener('change', updateOutputs);
        $bar.addEventListener('change', updateOutputs);
        $timer.addEventListener('change', updateOutputs);
        $embed.addEventListener('change', updateOutputs);
        $quiz.addEventListener('change', updateOutputs);
        $meta.addEventListener('change', updateOutputs);

        $title.addEventListener('input', updateOutputs);
        $name.addEventListener('input', updateOutputs);
        $email.addEventListener('input', updateOutputs);
        $logo.addEventListener('input', updateOutputs);

        // Click en tarjetas de estilo
        document.querySelectorAll('[data-style-btn]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const sId = btn.getAttribute('data-style-btn');
            if (sId) {
              $style.value = sId;
              updateOutputs();
            }
          });
        });

        // Presets rápidos
        document.querySelectorAll('[data-preset]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const preset = btn.getAttribute('data-preset');
            if (preset === 'standard') {
              $style.value = 'material';
              $theme.value = 'dark';
              $embed.checked = true;
              $quiz.checked = true;
              $meta.checked = false;
              $bar.value = 'visible';
              $timer.value = '300';
            } else if (preset === 'apple') {
              $style.value = 'cupertino';
              $theme.value = 'dark';
              $embed.checked = true;
              $quiz.checked = true;
              $bar.value = 'autohide';
            } else if (preset === 'microsoft') {
              $style.value = 'fluent';
              $theme.value = 'dark';
              $embed.checked = true;
              $quiz.checked = true;
            } else if (preset === 'aws') {
              $style.value = 'prime';
              $theme.value = 'dark';
              $embed.checked = true;
              $quiz.checked = true;
            } else if (preset === 'cyber') {
              $style.value = 'hyper';
              $theme.value = 'dark';
              $embed.checked = true;
              $quiz.checked = true;
            } else if (preset === 'noquiz') {
              $quiz.checked = false;
            } else if (preset === 'meta') {
              $meta.checked = true;
              $quiz.checked = true;
            } else if (preset === 'student') {
              $title.value = 'Universidad Tecnológica';
              $name.value = 'Tomás Alumno Demo';
              $email.value = 'tomas.demo@universidad.cl';
            }
            updateOutputs();
          });
        });

        // Botones de copiado
        $btnCopyUrl?.addEventListener('click', () => {
          navigator.clipboard.writeText($resultUrl.value);
          $btnCopyUrl.textContent = '✅ Copiado';
          setTimeout(() => ($btnCopyUrl.textContent = '📋 Copiar URL'), 2000);
        });

        $btnCopyIframe?.addEventListener('click', () => {
          navigator.clipboard.writeText($resultIframe.value);
          $btnCopyIframe.textContent = '✅ Copiado';
          setTimeout(() => ($btnCopyIframe.textContent = '📋 Copiar Iframe'), 2000);
        });

        // Controles de preview
        $btnReloadPreview?.addEventListener('click', () => {
          if ($previewIframe) {
            $previewIframe.src = $resultUrl.value;
          }
        });

        $btnTogglePreview?.addEventListener('click', () => {
          if ($previewContainer) {
            const isHidden = $previewContainer.classList.contains('hidden');
            if (isHidden) {
              $previewContainer.classList.remove('hidden');
              $btnTogglePreview.textContent = '👁️ Ocultar Preview';
            } else {
              $previewContainer.classList.add('hidden');
              $btnTogglePreview.textContent = '👁️ Mostrar Preview';
            }
          }
        });

        // Clic en "Cargar en Generador" de la tabla
        document.querySelectorAll('.btn-select-ppt').forEach((btn) => {
          btn.addEventListener('click', () => {
            const cSlug = btn.getAttribute('data-cslug');
            const lSlug = btn.getAttribute('data-lslug');
            if (cSlug && lSlug) {
              $course.value = cSlug;
              populateLessons(cSlug, lSlug);
              updateOutputs();
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }
          });
        });

        // Filtro de búsqueda en tabla
        $tableSearch?.addEventListener('input', (e) => {
          const q = (e.target.value || '').toLowerCase().trim();
          document.querySelectorAll('.ppt-table-row').forEach((row) => {
            const txt = row.getAttribute('data-search-text') || '';
            if (!q || txt.includes(q)) {
              row.style.display = '';
            } else {
              row.style.display = 'none';
            }
          });
        });

        // Inicializar lecciones y outputs iniciales
        if (pptCourses.length > 0) {
          populateLessons(pptCourses[0].slug);
          updateOutputs();
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPptEmbedBuilder);
      } else {
        initPptEmbedBuilder();
      }
    })();
  </script>

  <style is:inline>
    .ppt-lbl {
      display: block;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #94a3b8;
      margin-bottom: 0.3rem;
    }
    .ppt-input,
    select.ppt-input {
      width: 100%;
      border-radius: 0.65rem;
      border: 2px solid #334155;
      background: #0f172a;
      padding: 0.45rem 0.65rem;
      font-size: 0.78rem;
      font-weight: 700;
      font-family: inherit;
      color: #f8fafc;
      outline: none;
      transition: all 0.2s;
    }
    .ppt-input:focus,
    select.ppt-input:focus {
      border-color: #6366f1;
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
    }
    .ppt-cb {
      width: 1rem;
      height: 1rem;
      border-radius: 0.3rem;
      border: 2px solid #475569;
      background: #0f172a;
      accent-color: #6366f1;
      cursor: pointer;
    }
    .ppt-chip {
      font-size: 0.68rem;
      font-weight: 800;
      padding: 0.25rem 0.6rem;
      border-radius: 0.55rem;
      background: #1e293b;
      border: 1px solid #334155;
      color: #cbd5e1;
      cursor: pointer;
      transition: all 0.15s;
    }
    .ppt-chip:hover {
