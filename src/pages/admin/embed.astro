---
import AdminShellLayout from '../../layouts/AdminShellLayout.astro';
import { COURSES_CANONICAL_FILE, getCoursesForEmbed } from '../../lib/courseRegistry';

const embedCoursesData = getCoursesForEmbed();
---

<AdminShellLayout title="Admin · Embed Cursos & Quizzes" description="Generador interno de URLs de embed para cursos." activeSection="courses">
  <article class="admin-embed mx-auto w-full max-w-7xl min-w-0 pb-8">
    <header class="mb-5">
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="rounded-full border border-zinc-200 bg-white px-2.5 py-1 text-[11px] font-medium text-zinc-600 shadow-sm">
          LMS & Contenido
        </span>
        <span class="font-mono text-[11px] text-zinc-400">{COURSES_CANONICAL_FILE}</span>
      </div>
      <h1 class="!mb-0 !text-xl sm:!text-2xl text-zinc-950">Embed Cursos & Quizzes</h1>
      <p class="!mb-0 !mt-1 !text-xs sm:!text-sm !leading-snug text-zinc-500 max-w-3xl">
        Parámetros GET + tabla de URLs por lección (ancho completo abajo). Cursos y lecciones se
        leen del array <code class="rounded bg-zinc-100 px-1 text-zinc-700">courses</code> de{' '}
        <code class="rounded bg-zinc-100 px-1 text-zinc-700">{COURSES_CANONICAL_FILE}</code>; no
        dupliques listas en otros archivos.
      </p>
    </header>

    <!-- Formulario compacto (una sola tarjeta) -->
    <div
      class="admin-embed-form rounded-xl border border-zinc-200 bg-white p-3 sm:p-4 shadow-sm space-y-3"
    >
      <!-- Filtros + presets -->
      <div class="flex flex-col gap-2 lg:flex-row lg:items-end lg:gap-3">
        <div class="grid min-w-0 flex-1 grid-cols-1 gap-2 sm:grid-cols-2">
          <label class="ae-field">
            <span class="ae-lbl">Curso</span>
            <select id="embCourse" class="ae-input">
              <option value="">Todos</option>
              {embedCoursesData
                .filter((c) => (c.lessons?.length ?? 0) > 0)
                .map((c) => (
                  <option value={c.slug}>{c.name}</option>
                ))}
            </select>
          </label>
          <label class="ae-field">
            <span class="ae-lbl">Buscar</span>
            <input id="embSearch" class="ae-input" placeholder="slug, título, ruta…" />
          </label>
        </div>
        <div class="flex flex-wrap gap-1 lg:shrink-0 lg:justify-end">
          <button type="button" class="ae-chip" data-preset="clean">Limpio</button>
          <button type="button" class="ae-chip" data-preset="noquiz">Sin quiz</button>
          <button type="button" class="ae-chip" data-preset="pdf">PDF</button>
          <button type="button" class="ae-chip" data-preset="student">+ alumno</button>
        </div>
      </div>

      <!-- Flags en línea -->
      <div class="ae-divider flex flex-wrap items-center gap-x-4 gap-y-1 pt-1">
        <span class="ae-lbl !mb-0 w-full sm:w-auto">Flags</span>
        <label class="ae-inline">
          <input id="pEmbed" type="checkbox" class="ae-cb" checked />
          <span>embed</span>
        </label>
        <label class="ae-inline">
          <input id="pQuiz" type="checkbox" class="ae-cb" checked />
          <span>quiz</span>
        </label>
        <label class="ae-inline">
          <input id="pPdf" type="checkbox" class="ae-cb" />
          <span>pdf</span>
        </label>
        <label class="ae-inline">
          <input id="pEncrypt" type="checkbox" class="ae-cb" title="Primera visita: la URL pasa a ?code=jwt (menos datos visibles arriba)" />
          <span>encrypt</span>
        </label>
        <span class="text-[10px] font-bold text-textMuted">quiz off = <code class="rounded bg-black/5 px-1">quiz=false</code></span>
      </div>

      <!-- Cabecera embed: title, name, email -->
      <div class="grid grid-cols-1 gap-2 md:grid-cols-3">
        <label class="ae-field">
          <span class="ae-lbl">title</span>
          <input id="pTitle" class="ae-input" placeholder="Institución" />
        </label>
        <label class="ae-field">
          <span class="ae-lbl">name</span>
          <input id="pName" class="ae-input" placeholder="Alumno" />
        </label>
        <label class="ae-field">
          <span class="ae-lbl">email</span>
          <input id="pEmail" class="ae-input" placeholder="correo" />
        </label>
      </div>

      <!-- Branding -->
      <div class="grid grid-cols-1 gap-2 lg:grid-cols-4">
        <label class="ae-field">
          <span class="ae-lbl">logo</span>
          <input id="pLogo" class="ae-input" placeholder="https://…/logo.png" />
        </label>
        <div class="ae-field">
          <span class="ae-lbl">background (fondo página)</span>
          <input id="pBackground" type="hidden" />
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
            <label class="ae-field !m-0">
              <span class="sr-only">Background URL</span>
              <input id="pBackgroundUrl" class="ae-input" placeholder="URL imagen…" />
            </label>
            <label class="ae-field !m-0">
              <span class="sr-only">Background color</span>
              <div class="flex items-center gap-2">
                <input type="color" id="pBackgroundColor" class="ae-color" value="#ffffff" title="Color de fondo (background=)" />
                <span id="pBackgroundHex" class="font-mono text-[10px] font-bold text-textMuted" aria-live="polite">#ffffff</span>
              </div>
            </label>
          </div>
        </div>
        <label class="ae-field">
          <span class="ae-lbl">cabecera (fondo)</span>
          <div class="flex items-center gap-2">
            <input
              type="color"
              id="pColor"
              class="ae-color"
              value="#2b1d1b"
              title="Color de fondo de la cabecera embed (?color=)"
            />
            <span id="pColorHex" class="font-mono text-[10px] font-bold text-textMuted" aria-live="polite">#2b1d1b</span>
          </div>
        </label>
        <label class="ae-field">
          <span class="ae-lbl">cabecera (texto)</span>
          <div class="flex items-center gap-2">
            <input
              type="color"
              id="pText"
              class="ae-color"
              value="#fdf6e9"
              title="Color de texto de la cabecera embed (?text=)"
            />
            <span id="pTextHex" class="font-mono text-[10px] font-bold text-textMuted" aria-live="polite">#fdf6e9</span>
          </div>
        </label>
      </div>

      <!-- Preview mini -->
      <div class="ae-divider grid grid-cols-1 gap-2 pt-1 sm:grid-cols-3">
        <div>
          <span class="ae-lbl mb-1 block">Preview logo</span>
          <div class="flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-2 py-1.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-zinc-200 bg-zinc-100">
              <img id="logoPrev" alt="" class="hidden h-full w-full object-contain p-0.5" />
              <span id="logoPrevFallback" class="text-sm">🏫</span>
            </div>
            <div class="min-w-0 text-[11px] leading-tight">
              <div class="truncate font-semibold text-zinc-900">Institución</div>
              <div class="truncate font-medium text-zinc-500">Lección</div>
            </div>
          </div>
        </div>
        <div>
          <span class="ae-lbl mb-1 block">Preview cabecera</span>
          <div id="headerPrev" class="rounded-lg border border-zinc-200 px-3 py-2 text-[11px] font-semibold shadow-sm bg-[#2b1d1b]" style="color:#fdf6e9">
            Cabecera embed
          </div>
        </div>
        <div>
          <span class="ae-lbl mb-1 block">Preview fondo página</span>
          <div id="pageBgPrev" class="rounded-lg border border-zinc-200 px-3 py-2 text-[11px] font-semibold text-zinc-900 shadow-sm bg-white">
            Fondo de página
          </div>
        </div>
      </div>
    </div>

    <!-- Listado col-12: ancho completo del contenedor -->
    <section class="admin-embed-table-section mt-4 w-full min-w-0" aria-label="Tabla de URLs">
      <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="!m-0 !text-sm text-zinc-950">URLs por lección</h2>
        <span id="listMeta" class="text-[11px] font-medium text-zinc-500"></span>
      </div>
      <div class="w-full min-w-0 overflow-x-auto rounded-lg border border-zinc-200 bg-white">
        <table class="admin-embed-table w-full min-w-0 table-fixed border-collapse text-left">
          <colgroup>
            <col class="w-[14%]" />
            <col class="w-[20%]" />
            <col />
            <col class="w-[5.5rem]" />
          </colgroup>
          <thead class="bg-zinc-50">
            <tr>
              <th class="ae-th">Curso</th>
              <th class="ae-th">Lección</th>
              <th class="ae-th">URL</th>
              <th class="ae-th">Acción</th>
            </tr>
          </thead>
          <tbody id="lessonsList"></tbody>
        </table>
      </div>
      <p class="!mb-0 !mt-2 !text-[10px] font-medium text-zinc-500">
        Ruta interna; no es autenticación real.
      </p>
    </section>
  </article>

  <!-- JSON primero: el bundle (import) va aparte para que el navegador ejecute siempre un módulo ES válido -->
  <script
    type="application/json"
    id="adminEmbedCoursesJson"
    is:inline
    set:html={JSON.stringify(embedCoursesData).replace(/</g, '\\u003c')}
  />
  <script>
    import { initAdminEmbed } from '../../lib/embed/adminEmbedClient';
    import type { EmbedCoursePayload } from '../../lib/courseRegistry';

    const el = document.getElementById('adminEmbedCoursesJson');
    let data: EmbedCoursePayload[] = [];
    if (el?.textContent) {
      try {
        data = JSON.parse(el.textContent) as EmbedCoursePayload[];
      } catch {
        data = [];
      }
    }
    initAdminEmbed(Array.isArray(data) ? data : []);
  </script>

  <style is:inline>
    .admin-embed h1 {
      margin-bottom: 0.25rem;
    }
    .admin-embed .ae-lbl {
      display: block;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #71717a;
      margin-bottom: 0.2rem;
    }
    .admin-embed .ae-input,
    .admin-embed .ae-field select {
      width: 100%;
      border-radius: 0.375rem;
      border: 1px solid #e4e4e7;
      background: #fff;
      padding: 0.35rem 0.55rem;
      font-size: 0.75rem;
      font-weight: 500;
      font-family: inherit;
      color: #18181b;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .admin-embed .ae-input:focus,
    .admin-embed .ae-field select:focus {
      outline: none;
      border-color: #a1a1aa;
      box-shadow: 0 0 0 2px rgba(24, 24, 27, 0.08);
    }
    .admin-embed input[type='color'].ae-color {
      height: 2rem;
      width: 2.75rem;
      padding: 0.15rem;
      border-radius: 0.375rem;
      border: 1px solid #e4e4e7;
      background: #fff;
      cursor: pointer;
    }
    .admin-embed input[type='color'].ae-color::-webkit-color-swatch-wrapper {
      padding: 0;
    }
    .admin-embed input[type='color'].ae-color::-webkit-color-swatch {
      border-radius: 0.25rem;
      border: none;
    }
    .admin-embed .ae-chip {
      border-radius: 0.375rem;
      border: 1px solid #e4e4e7;
      background: #fafafa;
      padding: 0.25rem 0.55rem;
      font-size: 0.65rem;
      font-weight: 600;
      line-height: 1.2;
      color: #3f3f46;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
    }
    .admin-embed .ae-chip:hover {
      background: #f4f4f5;
      border-color: #d4d4d8;
    }
    .admin-embed .ae-divider {
      border-top: 1px solid #f4f4f5;
    }
    .admin-embed .ae-inline {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.7rem;
      font-weight: 600;
      color: #3f3f46;
    }
    .admin-embed .ae-cb {
      height: 0.95rem;
      width: 0.95rem;
      accent-color: #18181b;
    }
    .admin-embed .ae-th {
      padding: 0.5rem;
      font-size: 0.65rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #71717a;
      border-bottom: 1px solid #e4e4e7;
    }
    .admin-embed-table-section {
      grid-column: 1 / -1;
    }
  </style>

</AdminShellLayout>
