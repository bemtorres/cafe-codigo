---
import AdminLayout from '../../layouts/AdminLayout.astro';

return Astro.redirect('/admin/control/');
---

<AdminLayout title="Redireccionando al Centro de Control..." activeSection="control">
  <div class="flex flex-col items-center justify-center min-h-[50vh] text-center p-6">
    <div class="w-14 h-14 rounded-2xl bg-indigo-600/20 border-2 border-indigo-500/40 text-indigo-400 flex items-center justify-center text-3xl animate-pulse mb-4 shadow-xl">
      ⚙️
    </div>
    <h1 class="text-xl sm:text-2xl font-black text-white mb-2">Redireccionando al Centro de Control...</h1>
    <p class="m-0 text-sm font-medium text-slate-400">
      Si tu navegador no te redirige de inmediato, accede haciendo clic en{' '}
      <a href="/admin/control/" class="font-bold text-sky-400 underline hover:text-sky-300">/admin/control/</a>.
    </p>
  </div>
  <script is:inline>
    if (typeof window !== 'undefined') window.location.replace('/admin/control/');
  </script>
</AdminLayout>
