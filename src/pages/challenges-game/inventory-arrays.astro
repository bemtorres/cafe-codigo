---
import GameLayout from '../../layouts/GameLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { gameInventorySolutions } from '../../data/gameInventorySolutions';

const exercises = [
  // SECCIÓN 1: VISUALIZACIÓN, RECORRIDO Y BÚSQUEDA BÁSICA (1 - 5)
  {
    id: 1,
    section: '1. Recorrido y Búsqueda Básica',
    title: 'Mostrar Inventario de Aventurero',
    statement: 'Crear una función mostrarInventario(items) que recorra una lista de cadenas con nombres de ítems e imprima "Slot [i]: [item]" para cada uno.',
    steps: [
      { id: 'step1', title: 'Comprendí el recorrido del arreglo', desc: 'Iterar por cada elemento con su índice.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí mostrarInventario(items).' },
      { id: 'step3', title: 'Implementé bucle for', desc: 'Recorrí del slot 1 al N.' },
      { id: 'step4', title: 'Formateé la salida', desc: 'Imprimí "Slot [i]: [item]".' },
      { id: 'step5', title: 'Probé con mochila de 4 ítems', desc: 'Verifiqué que salieron los 4 slots numerados.' },
    ],
  },
  {
    id: 2,
    section: '1. Recorrido y Búsqueda Básica',
    title: 'Buscar Posición de Ítem Clave',
    statement: 'Crear una función buscarItemEnInventario(inventario, itemBuscado) que busque secuencialmente un objeto y retorne el número de slot donde se encuentra o un mensaje de error si no existe.',
    steps: [
      { id: 'step1', title: 'Comprendí la búsqueda lineal', desc: 'Recorrer el arreglo comparando cada cadena.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí buscarItemEnInventario(inventario, itemBuscado).' },
      { id: 'step3', title: 'Retorno temprano al encontrar', desc: 'Devolví el índice + 1 al coincidir.' },
      { id: 'step4', title: 'Manejo de ítem ausente', desc: 'Retorné mensaje de aviso tras el ciclo.' },
      { id: 'step5', title: 'Probé con ítem existente y ausente', desc: 'Validé ambos retornos.' },
    ],
  },
  {
    id: 3,
    section: '1. Recorrido y Búsqueda Básica',
    title: 'Contar Existencias de un Consumible',
    statement: 'Crear una función contarConsumibles(inventario, consumible) que cuente y retorne cuántas unidades de un consumible específico (ej. "Poción de Salud") posee el héroe en su mochila.',
    steps: [
      { id: 'step1', title: 'Comprendí el contador', desc: 'Inicializar variable contador en 0.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí contarConsumibles(inventario, consumible).' },
      { id: 'step3', title: 'Incremento condicional', desc: 'Sumar 1 cada vez que coincida el ítem.' },
      { id: 'step4', title: 'Retorno del total', desc: 'Devolver la cantidad acumulada.' },
      { id: 'step5', title: 'Probé con lista con 3 pociones', desc: 'Verifiqué que el contador arrojó 3.' },
    ],
  },
  {
    id: 4,
    section: '1. Recorrido y Búsqueda Básica',
    title: 'Verificar si la Mochila está Llena',
    statement: 'Crear una función inventarioLleno(inventario, capacidadMaxima) que determine si la cantidad actual de ítems alcanzó el límite máximo de almacenamiento o cuántos espacios libres restan.',
    steps: [
      { id: 'step1', title: 'Comprendí la validación de capacidad', desc: 'Comparar len(inventario) >= capacidadMaxima.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí inventarioLleno(inventario, capacidadMaxima).' },
      { id: 'step3', title: 'Rama de inventario lleno', desc: 'Notifiqué que la mochila está a tope.' },
      { id: 'step4', title: 'Rama de espacios disponibles', desc: 'Calculé los slots libres restantes.' },
      { id: 'step5', title: 'Probé con 4/4 y con 2/5 slots', desc: 'Comprobé ambos estados.' },
    ],
  },
  {
    id: 5,
    section: '1. Recorrido y Búsqueda Básica',
    title: 'Calcular Peso Total de la Mochila',
    statement: 'Crear una función calcularPesoTotal(pesos, pesoMaximo) que sume los pesos de todos los ítems de la mochila y advierta si el héroe sufre sobrepeso (penalización de velocidad).',
    steps: [
      { id: 'step1', title: 'Comprendí la suma de acumulador', desc: 'Sumar todos los números flotantes de pesos.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí calcularPesoTotal(pesos, pesoMaximo).' },
      { id: 'step3', title: 'Calculé el total acumulado', desc: 'Obtuve el peso neto transportado.' },
      { id: 'step4', title: 'Evalué sobrepeso', desc: 'Comparé contra el pesoMaximo permitido.' },
      { id: 'step5', title: 'Probé con carga ligera y pesada', desc: 'Validé los mensajes de estado.' },
    ],
  },

  // SECCIÓN 2: INSERCIÓN, ELIMINACIÓN Y MANIPULACIÓN (6 - 10)
  {
    id: 6,
    section: '2. Inserción y Manipulación de Slots',
    title: 'Agregar Ítem en Primer Slot Disponible',
    statement: 'Crear una función agregarItem(inventario, nuevoItem, capacidad) que agregue un objeto al inventario si no ha alcanzado la capacidad máxima, o rechace la acción si no hay espacio.',
    steps: [
      { id: 'step1', title: 'Comprendí la inserción controlada', desc: 'Verificar longitud previa antes de agregar.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí agregarItem(inventario, nuevoItem, capacidad).' },
      { id: 'step3', title: 'Agregué al arreglo', desc: 'Usé append/push si hay espacio libre.' },
      { id: 'step4', title: 'Manejo de rechazo', desc: 'Mostré alerta de mochila llena.' },
      { id: 'step5', title: 'Probé inserción exitosa y fallida', desc: 'Validé con mochila con y sin slots.' },
    ],
  },
  {
    id: 7,
    section: '2. Inserción y Manipulación de Slots',
    title: 'Descartar Ítem por Nombre',
    statement: 'Crear una función descartarItem(inventario, itemDescartar) que busque y remueva la primera aparición del objeto indicado, devolviendo la lista actualizada.',
    steps: [
      { id: 'step1', title: 'Comprendí la remoción de elementos', desc: 'Localizar y eliminar del arreglo.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí descartarItem(inventario, itemDescartar).' },
      { id: 'step3', title: 'Eliminé el elemento', desc: 'Apliqué remove/splice sobre la colección.' },
      { id: 'step4', title: 'Manejo de ítem inexistente', desc: 'Evité errores si el ítem no estaba.' },
      { id: 'step5', title: 'Probé descartar "Bota Vieja"', desc: 'Verifiqué la mochila actualizada.' },
    ],
  },
  {
    id: 8,
    section: '2. Inserción y Manipulación de Slots',
    title: 'Intercambiar Ítems entre Dos Slots',
    statement: 'Crear una función intercambiarSlots(inventario, slotA, slotB) que intercambie las posiciones de dos objetos en la mochila usando una variable auxiliar o desestructuración.',
    steps: [
      { id: 'step1', title: 'Comprendí el algoritmo de intercambio (Swap)', desc: 'temp = arr[a]; arr[a] = arr[b]; arr[b] = temp.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí intercambiarSlots(inventario, slotA, slotB).' },
      { id: 'step3', title: 'Validé índices dentro de rango', desc: 'Comprobé que ambos slots existen.' },
      { id: 'step4', title: 'Realicé el intercambio', desc: 'Cambié las posiciones en el arreglo.' },
      { id: 'step5', title: 'Probé cambiando Slot 1 con Slot 3', desc: 'Verifiqué las nuevas posiciones.' },
    ],
  },
  {
    id: 9,
    section: '2. Inserción y Manipulación de Slots',
    title: 'Invertir Cinturón de Acceso Rápido (Hotbar)',
    statement: 'Crear una función invertirHotbar(items) que invierta el orden de los accesos directos de la barra rápida para cambiar de táctica de combate.',
    steps: [
      { id: 'step1', title: 'Comprendí la inversión de arreglos', desc: 'Invertir el orden de primero a último.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí invertirHotbar(items).' },
      { id: 'step3', title: 'Invertí la secuencia', desc: 'Usé reverse() o bucle descendente.' },
      { id: 'step4', title: 'Retorné la colección invertida', desc: 'Devolví el nuevo arreglo ordenado.' },
      { id: 'step5', title: 'Probé con 4 consumibles', desc: 'Comprobé que el primero pasó al final.' },
    ],
  },
  {
    id: 10,
    section: '2. Inserción y Manipulación de Slots',
    title: 'Duplicar Recursos con Bendición',
    statement: 'Crear una función duplicarRecursos(cantidades) que tome una lista con las cantidades de materiales recolectados y devuelva un nuevo arreglo con el doble de cada recurso.',
    steps: [
      { id: 'step1', title: 'Comprendí el mapeo/transformación', desc: 'Multiplicar cada valor x2.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí duplicarRecursos(cantidades).' },
      { id: 'step3', title: 'Iteré multiplicando', desc: 'Apliqué map o bucle for.' },
      { id: 'step4', title: 'Construí nuevo arreglo', desc: 'Guardé los resultados duplicados.' },
      { id: 'step5', title: 'Probé con [15, 8, 40, 3]', desc: 'Verifiqué resultado [30, 16, 80, 6].' },
    ],
  },

  // SECCIÓN 3: BÚSQUEDA DE MÁXIMOS, MÍNIMOS Y FILTROS (11 - 15)
  {
    id: 11,
    section: '3. Filtros, Máximos y Estadísticas',
    title: 'Encontrar el Arma con Mayor Daño',
    statement: 'Crear una función obtenerArmaMasPoderosa(nombres, danios) que compare los valores de ataque del arsenal y devuelva el nombre y daño del arma más letal.',
    steps: [
      { id: 'step1', title: 'Comprendí la búsqueda del valor máximo', desc: 'Inicializar max en -1 y comparar.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí obtenerArmaMasPoderosa(nombres, danios).' },
      { id: 'step3', title: 'Iteré comparando daños', desc: 'Guardé el nombre y el valor récord.' },
      { id: 'step4', title: 'Retorné la mejor arma', desc: 'Devolví nombre y poder de ataque.' },
      { id: 'step5', title: 'Probé con 4 armas distintas', desc: 'Verifiqué que eligió el Mandoble con 140 de daño.' },
    ],
  },
  {
    id: 12,
    section: '3. Filtros, Máximos y Estadísticas',
    title: 'Encontrar el Ítem de Menor Valor de Venta',
    statement: 'Crear una función obtenerItemMenosValioso(nombres, precios) que identifique el objeto de menor precio de venta para venderlo o descartarlo primero.',
    steps: [
      { id: 'step1', title: 'Comprendí la búsqueda del mínimo', desc: 'Inicializar min con un valor muy alto.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí obtenerItemMenosValioso(nombres, precios).' },
      { id: 'step3', title: 'Actualicé el mínimo', desc: 'Comparé cada precio con el registro menor.' },
      { id: 'step4', title: 'Identifiqué el ítem', desc: 'Guardé el nombre correspondiente.' },
      { id: 'step5', title: 'Probé con lista variada', desc: 'Verifiqué que detectó el Hueso por 5 monedas.' },
    ],
  },
  {
    id: 13,
    section: '3. Filtros, Máximos y Estadísticas',
    title: 'Filtrar Ítems por Calidad "Legendario"',
    statement: 'Crear una función filtrarItemsLegendarios(items, calidades) que filtre y devuelva únicamente aquellos ítems cuya calidad correspondiente sea "Legendario".',
    steps: [
      { id: 'step1', title: 'Comprendí el filtrado condicional', desc: 'Extraer elementos que cumplan una condición.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí filtrarItemsLegendarios(items, calidades).' },
      { id: 'step3', title: 'Revisé cada posición', desc: 'Comprobé si calidades[i] == "Legendario".' },
      { id: 'step4', title: 'Construí lista filtrada', desc: 'Agregué los nombres coincidentes.' },
      { id: 'step5', title: 'Probé con 4 ítems variados', desc: 'Verifiqué que devolvió solo los 2 legendarios.' },
    ],
  },
  {
    id: 14,
    section: '3. Filtros, Máximos y Estadísticas',
    title: 'Limpiar Ítems de Chatarra / Basura',
    statement: 'Crear una función limpiarChatarra(inventario) que filtre y elimine todos los ítems inservibles como "Chatarra", "Piedra Rota" o "Bota Vieja" para liberar espacio.',
    steps: [
      { id: 'step1', title: 'Comprendí la exclusión de elementos', desc: 'Filtrar elementos no deseados de la lista.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí limpiarChatarra(inventario).' },
      { id: 'step3', title: 'Definí lista de basura', desc: 'Agrupé los nombres de chatarra.' },
      { id: 'step4', title: 'Generé inventario limpio', desc: 'Mantuve solo los ítems útiles.' },
      { id: 'step5', title: 'Probé con mochila con 2 basuras', desc: 'Verifiqué que fueron removidas.' },
    ],
  },
  {
    id: 15,
    section: '3. Filtros, Máximos y Estadísticas',
    title: 'Calcular Promedio de Nivel de Equipamiento (Item Level)',
    statement: 'Crear una función calcularItemLevelPromedio(nivelesEquip) que calcule el promedio aritmético de los niveles de armadura equipados por el personaje.',
    steps: [
      { id: 'step1', title: 'Comprendí el cálculo de promedio', desc: 'Sumar elementos y dividir entre la longitud.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí calcularItemLevelPromedio(nivelesEquip).' },
      { id: 'step3', title: 'Sumé todos los niveles', desc: 'Recorrí el arreglo con acumulador.' },
      { id: 'step4', title: 'Dividí entre la cantidad', desc: 'Calculé suma / longitud.' },
      { id: 'step5', title: 'Probé con set de 5 piezas [85, 90, 80, 95, 75]', desc: 'Comprobé resultado 84.0 iLvl.' },
    ],
  },

  // SECCIÓN 4: TRANSFORMACIONES, STACKS Y OPERACIONES AVANZADAS (16 - 20)
  {
    id: 16,
    section: '4. Fusión, Stacks y Rotaciones',
    title: 'Consolidar Dos Mochilas de Expedición',
    statement: 'Crear una función fusionarInventarios(mochila1, mochila2) que combine todos los elementos de dos mochilas en un solo inventario consolidado.',
    steps: [
      { id: 'step1', title: 'Comprendí la concatenación', desc: 'Unir dos arreglos en uno solo.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí fusionarInventarios(m1, m2).' },
      { id: 'step3', title: 'Concatené las listas', desc: 'Usé operador spread, concat o extend.' },
      { id: 'step4', title: 'Retorné inventario conjunto', desc: 'Devolví la nueva lista consolidada.' },
      { id: 'step5', title: 'Probé con mochilas de 3 y 2 ítems', desc: 'Verifiqué que la resultante tiene 5 ítems.' },
    ],
  },
  {
    id: 17,
    section: '4. Fusión, Stacks y Rotaciones',
    title: 'Apilar / Stackear Consumibles',
    statement: 'Crear una función apilarItems(stackActual, cantidadNueva, maxStack) que acumule unidades en un slot hasta su límite máximo (ej. 64) y retorne las unidades sobrantes para otro slot.',
    steps: [
      { id: 'step1', title: 'Comprendí el apilamiento con límite', desc: 'total = actual + nueva; sobrante = total - max.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí apilarItems(actual, nueva, maxStack).' },
      { id: 'step3', title: 'Caso sin desborde', desc: 'Si total <= maxStack, sobrante es 0.' },
      { id: 'step4', title: 'Caso con desborde', desc: 'Calculé el remanente para un nuevo slot.' },
      { id: 'step5', title: 'Probé con (45, 15) y (50, 30) de 64', desc: 'Comprobé 0 sobrante vs 16 sobrante.' },
    ],
  },
  {
    id: 18,
    section: '4. Fusión, Stacks y Rotaciones',
    title: 'Ordenar Arsenal de Armas de Mayor a Menor',
    statement: 'Crear una función ordenarArsenalPorDanio(danios) que ordene los valores de daño de las armas en orden descendente (de mayor a menor poder).',
    steps: [
      { id: 'step1', title: 'Comprendí el ordenamiento descendente', desc: 'Ordenar de mayor a menor.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí ordenarArsenalPorDanio(danios).' },
      { id: 'step3', title: 'Apliqué algoritmo de ordenamiento', desc: 'Usé sort() con comparador o algoritmo de burbuja.' },
      { id: 'step4', title: 'Retorné lista ordenada', desc: 'Devolví el arreglo con los mayores al inicio.' },
      { id: 'step5', title: 'Probé con [45, 120, 15, 80, 210, 65]', desc: 'Verifiqué que el 210 quedó primero y 15 al final.' },
    ],
  },
  {
    id: 19,
    section: '4. Fusión, Stacks y Rotaciones',
    title: 'Extraer Sub-Inventario de Combate Rápido',
    statement: 'Crear una función obtenerItemsRapidos(inventario, cantidad) que extraiga un sub-arreglo con los primeros N elementos para equiparlos en la barra de combate.',
    steps: [
      { id: 'step1', title: 'Comprendí el rebanado (Slice)', desc: 'Extraer los primeros N elementos de un arreglo.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí obtenerItemsRapidos(inventario, cantidad).' },
      { id: 'step3', title: 'Corté el sub-arreglo', desc: 'Usé slice(0, cant) o take(cant).' },
      { id: 'step4', title: 'Retorné la barra rápida', desc: 'Devolví los ítems seleccionados.' },
      { id: 'step5', title: 'Probé extrayendo 3 de 6 ítems', desc: 'Verifiqué que retornó los 3 primeros.' },
    ],
  },
  {
    id: 20,
    section: '4. Fusión, Stacks y Rotaciones',
    title: 'Rotar Carrusel de Consumibles',
    statement: 'Crear una función rotarConsumibles(inventario) que mueva el último objeto del inventario al primer lugar (rotación circular a la derecha).',
    steps: [
      { id: 'step1', title: 'Comprendí la rotación circular', desc: 'El último elemento pasa a la posición 0.' },
      { id: 'step2', title: 'Declaré la función', desc: 'Definí rotarConsumibles(inventario).' },
      { id: 'step3', title: 'Extraje el último elemento', desc: 'Tomé arr[len - 1].' },
      { id: 'step4', title: 'Reensamblé la lista', desc: 'Coloqué el último al inicio seguido del resto.' },
      { id: 'step5', title: 'Probé con 4 consumibles', desc: 'Verifiqué que la "Antorcha" final pasó al inicio.' },
    ],
  },
];
---

<GameLayout
  title="Arreglos & Inventarios de Loot — 20 Misiones Gamer"
  description="Domina arreglos y colecciones en videojuegos: slots de mochila, peso máximo, filtros de rareza, stacks y ordenamientos."
  activeModule="inventory"
>
  <div class="gamer-universe min-h-screen bg-[#070B14] text-slate-100 relative overflow-hidden pb-16">
    <!-- EFECTO DE LUZ DE FONDO Y GRID -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(168,85,247,0.15),rgba(255,255,255,0))] pointer-events-none"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b12_1px,transparent_1px),linear-gradient(to_bottom,#1e293b12_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none opacity-40"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10 pt-6">

      <!-- HEADER -->
      <div class="mb-6 pb-4 border-b-2 border-purple-500/20">
        <div class="flex items-center gap-2 mb-2">
          <a href="/challenges-game/" class="text-xs font-nunito font-extrabold text-purple-400 no-underline hover:text-purple-300">← Volver a Zona Gamer</a>
          <span class="text-slate-600">•</span>
          <span class="text-xs font-nunito font-black uppercase tracking-widest text-purple-400 bg-purple-950/80 border border-purple-500/40 px-2 py-0.5 rounded-md">Módulo 03 · Inventarios & Datos</span>
        </div>
        <h1 class="m-0 text-2xl sm:text-4xl font-['Orbitron'] font-black text-white flex items-center gap-2.5">
          <span>🎒</span>
          <span>Arreglos & Inventarios de Loot</span>
        </h1>
        <p class="mt-2 text-sm text-slate-300 font-medium leading-relaxed max-w-3xl">
          20 desafíos de gestión de inventarios: slots de mochila, filtrado por rareza, descarte de chatarra, stacks y rotaciones. Resuelve en <strong>Python, Java, C#, C++, JS, PHP o PSeInt</strong>.
        </p>
      </div>

      <!-- CONTROLES -->
      <div class="mb-6 flex flex-col md:flex-row items-center justify-between gap-4 bg-slate-900/90 p-4 rounded-2xl border-2 border-purple-500/40 shadow-[0_0_20px_rgba(168,85,247,0.15)]">
        <div class="w-full md:w-auto flex items-center gap-4">
          <div class="w-full sm:w-80">
            <span class="text-xs font-nunito font-black text-purple-400 uppercase tracking-wider block mb-1">🔍 Filtro de inventario</span>
            <input
              type="text"
              id="searchBox"
              placeholder="Buscar misión de inventario..."
              class="w-full px-3 py-2 rounded-xl border border-slate-700 font-nunito font-bold text-xs bg-slate-950 text-white focus:outline-none focus:border-purple-400"
            />
          </div>
        </div>

        <div class="flex items-center gap-2 w-full md:w-auto justify-end">
          <button type="button" id="expandAll" class="px-3.5 py-2 rounded-xl border border-purple-500/50 bg-purple-950 hover:bg-purple-900 text-purple-300 font-nunito font-black text-xs cursor-pointer shadow-md hover:-translate-y-0.5 transition-transform">Expandir todos (20)</button>
          <button type="button" id="collapseAll" class="px-3.5 py-2 rounded-xl border border-slate-700 bg-slate-950 hover:bg-slate-900 text-slate-400 font-nunito font-black text-xs cursor-pointer hover:-translate-y-0.5 transition-transform">Colapsar todos</button>
        </div>
      </div>

      <!-- LISTADO RÁPIDO -->
      <section class="mb-10">
        <div class="flex items-center justify-between mb-3 border-b border-purple-500/30 pb-2">
          <h2 class="text-base font-['Orbitron'] font-black text-white m-0 flex items-center gap-2">
            <span>📋</span> Misiones de Inventario (1 al 20)
          </h2>
          <span class="text-xs font-nunito font-bold bg-purple-950 border border-purple-500/50 text-purple-300 px-2.5 py-0.5 rounded-full">20 misiones · +2,000 XP</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-2" id="quickList">
          {exercises.map((ex) => (
            <div class="quick-item search-target" data-keywords={`${ex.title} ${ex.section} ${ex.statement}`.toLowerCase()} data-quick-id={`inv-${ex.id}`}>
              <label class="flex items-center cursor-pointer p-0.5 shrink-0" title="Marcar como completado">
                <input type="checkbox" data-complete-id={`inv-${ex.id}`} class="w-4 h-4 accent-purple-500 rounded cursor-pointer" />
              </label>
              <a href={`#inv-${ex.id}`} class="quick-link flex items-center gap-2.5 flex-1 min-w-0 no-underline text-inherit">
                <span class="quick-num">{String(ex.id).padStart(2, '0')}</span>
                <span class="quick-title truncate">{ex.title}</span>
                <span class="quick-badge-done hidden text-[0.65rem] font-bold bg-emerald-950 text-emerald-300 px-1.5 py-0.5 rounded border border-emerald-500/50">✓ Victoria</span>
                <span class="quick-arrow">↓</span>
              </a>
            </div>
          ))}
        </div>
      </section>

      <!-- LISTA DETALLADA -->
      <section class="mb-8">
        <div id="exerciseList" class="flex flex-col gap-3">
          {exercises.map((ex) => (
            <details class="ex-card border-2 border-purple-500/30 bg-slate-900/90 rounded-2xl p-4 shadow-[0_0_15px_rgba(168,85,247,0.08)] search-target transition-all" id={`inv-${ex.id}`} data-ex-id={`inv-${ex.id}`} data-keywords={`${ex.title} ${ex.section} ${ex.statement}`.toLowerCase()}>
              <summary class="ex-summary flex items-center justify-between cursor-pointer font-nunito font-black select-none text-white">
                <div class="flex items-center gap-3 pr-2 min-w-0">
                  <span class="ex-num w-8 h-8 rounded-xl bg-purple-600 text-white flex items-center justify-center text-xs shrink-0 shadow-[0_0_10px_#a855f7]">{String(ex.id).padStart(2, '0')}</span>
                  <div class="truncate">
                    <span class="text-[0.68rem] text-purple-400 font-extrabold uppercase block leading-tight">{ex.section}</span>
                    <h3 class="m-0 text-sm sm:text-base text-white truncate flex items-center gap-2">
                      <span>{ex.id}. {ex.title}</span>
                      <span class="card-done-tag hidden text-xs font-bold text-emerald-300 bg-emerald-950/80 px-2 py-0.5 rounded-md border border-emerald-500/50">✓ Victoria (+100 XP)</span>
                    </h3>
                  </div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <button type="button" data-modal-trigger data-ex-id={ex.id} data-ex-title={ex.title} class="open-solution-modal-btn px-3 py-1 bg-purple-950/80 hover:bg-purple-900 text-purple-300 font-nunito font-black text-xs rounded-xl border border-purple-500/40 shadow-sm transition-all cursor-pointer">
                    Ver solución
                  </button>
                  <label class="flex items-center gap-1.5 text-xs font-extrabold bg-slate-950 hover:bg-slate-800 text-purple-300 px-2.5 py-1 rounded-lg border border-slate-700 cursor-pointer" onclick="event.stopPropagation()">
                    <input type="checkbox" data-complete-id={`inv-${ex.id}`} class="w-4 h-4 accent-purple-500 rounded cursor-pointer" />
                    <span>Completada</span>
                  </label>
                  <span class="ex-progress text-xs font-bold text-slate-400 bg-slate-950 px-2 py-1 rounded-lg border border-slate-800" data-progress-for={`inv-${ex.id}`}>0 / 5</span>
                </div>
              </summary>

              <div class="ex-body mt-3 pt-3 border-t border-slate-800">
                <div class="ex-statement-box bg-[#040814] border border-purple-500/40 rounded-xl p-3.5 shadow-inner">
                  <p class="font-quicksand text-sm m-0 leading-relaxed text-slate-100">
                    <strong class="text-purple-400 font-extrabold uppercase tracking-wide text-xs block mb-1">🎯 Enunciado de la Misión:</strong>
                    <span class="text-slate-100 font-bold text-sm leading-relaxed block">{ex.statement}</span>
                  </p>
                </div>

                <div class="ex-checks flex flex-col gap-2 mt-3 text-xs font-nunito font-extrabold">
                  {ex.steps.map((st, idx) => (
                    <label class="chk flex items-start gap-2.5 cursor-pointer bg-[#060D1F] hover:bg-[#0E1A38] p-2.5 rounded-xl border border-slate-800/90 hover:border-purple-500/50 transition-colors">
                      <input type="checkbox" data-check-id={st.id} class="w-4 h-4 accent-purple-500 rounded mt-0.5 shrink-0 cursor-pointer" />
                      <div>
                        <span class="text-purple-300 font-black block text-xs">{idx + 1}. {st.title}</span>
                        <span class="text-slate-300 font-semibold text-[0.8rem] block leading-snug mt-0.5">{st.desc}</span>
                      </div>
                    </label>
                  ))}
                </div>
              </div>
            </details>
          ))}
        </div>
      </section>

      <!-- MODAL DE SOLUCIÓN -->
      <div id="solutionModal" class="fixed inset-0 z-[100] bg-black/80 backdrop-blur-md hidden items-center justify-center p-4 sm:p-6">
        <div class="bg-[#0B132B] border-2 border-purple-500/50 rounded-3xl w-full max-w-4xl max-h-[92vh] flex flex-col shadow-[0_0_40px_rgba(168,85,247,0.25)] overflow-hidden">
          <div class="bg-purple-950/80 border-b border-purple-500/30 p-4 sm:p-5 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span id="modalExNum" class="w-10 h-10 rounded-2xl bg-purple-600 text-white flex items-center justify-center font-black text-base shadow-[0_0_10px_#a855f7]">01</span>
              <div>
                <span class="text-[0.7rem] text-purple-400 font-extrabold uppercase block tracking-wider">Solución de Inventario & Loot</span>
                <h3 id="modalExTitle" class="m-0 font-['Orbitron'] font-black text-base sm:text-lg text-white">Misión 1: Mostrar Inventario</h3>
              </div>
            </div>
            <button type="button" id="closeSolutionModal" class="w-9 h-9 rounded-xl bg-slate-900 border border-slate-700 font-black text-base text-slate-300 flex items-center justify-center cursor-pointer hover:bg-rose-950 hover:border-rose-500 hover:text-rose-300 transition-colors">✕</button>
          </div>

          <div class="p-5 sm:p-6 overflow-y-auto flex-1 font-nunito">
            <!-- PASO 1: RETO MATEMÁTICO -->
            <div id="mathVerificationStep" class="bg-[#050B1A] border-2 border-purple-500/40 rounded-3xl p-6 sm:p-8 text-center my-4">
              <div class="text-4xl mb-2">🔐</div>
              <h4 class="font-['Orbitron'] font-black text-purple-400 text-lg sm:text-xl m-0 mb-1">Verificación para desbloquear la solución</h4>
              <p class="text-xs sm:text-sm font-bold text-slate-300 m-0 mb-4 max-w-md mx-auto">Resuelve la siguiente operación para visualizar el código:</p>
              <div class="inline-flex items-center justify-center gap-3 bg-slate-950 px-6 py-3.5 rounded-2xl border-2 border-purple-500/40 shadow-[0_0_15px_rgba(168,85,247,0.15)] mb-4">
                <span id="mathChallengeText" class="font-['Orbitron'] font-black text-xl sm:text-2xl text-purple-300">15 + 10 =</span>
                <input type="number" id="mathAnswerInput" class="w-24 px-3 py-2 rounded-xl border border-purple-500/50 bg-slate-900 font-['Orbitron'] font-black text-xl text-center text-white outline-none focus:ring-2 focus:ring-purple-400" placeholder="?" />
              </div>
              <div>
                <button type="button" id="verifyMathBtn" class="px-6 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-['Orbitron'] font-black text-xs sm:text-sm rounded-xl border border-purple-400 shadow-[0_0_15px_rgba(168,85,247,0.3)] hover:-translate-y-0.5 transition-all cursor-pointer">
                  🔓 Comprobar y Desbloquear
                </button>
              </div>
              <p id="mathErrorMessage" class="text-xs sm:text-sm font-black text-rose-400 m-0 mt-3 hidden">❌ Respuesta incorrecta. ¡Inténtalo de nuevo!</p>
            </div>

            <!-- PASO 2: CÓDIGO -->
            <div id="solutionCodeStep" class="hidden flex-col gap-4">
              <div class="bg-[#060D1E] border border-purple-500/30 p-3 rounded-2xl">
                <label class="block text-xs font-black text-purple-400 mb-2 uppercase tracking-wider">Selecciona el lenguaje:</label>
                <div class="flex flex-wrap gap-2" id="langSelectorGroup">
                  <button type="button" data-lang="python" class="lang-tab-btn active px-4 py-2 rounded-xl border border-purple-400 font-black text-xs cursor-pointer bg-purple-600 text-white shadow-[0_0_10px_rgba(168,85,247,0.3)]">🐍 Python</button>
                  <button type="button" data-lang="java" class="lang-tab-btn px-4 py-2 rounded-xl border border-slate-700 font-black text-xs cursor-pointer bg-slate-900 text-slate-300 hover:border-purple-500/50">☕ Java</button>
                  <button type="button" data-lang="csharp" class="lang-tab-btn px-4 py-2 rounded-xl border border-slate-700 font-black text-xs cursor-pointer bg-slate-900 text-slate-300 hover:border-purple-500/50">🔷 C#</button>
                  <button type="button" data-lang="cpp" class="lang-tab-btn px-4 py-2 rounded-xl border border-slate-700 font-black text-xs cursor-pointer bg-slate-900 text-slate-300 hover:border-purple-500/50">⚙️ C++</button>
                  <button type="button" data-lang="javascript" class="lang-tab-btn px-4 py-2 rounded-xl border border-slate-700 font-black text-xs cursor-pointer bg-slate-900 text-slate-300 hover:border-purple-500/50">⚡ JavaScript</button>
                  <button type="button" data-lang="php" class="lang-tab-btn px-4 py-2 rounded-xl border border-slate-700 font-black text-xs cursor-pointer bg-slate-900 text-slate-300 hover:border-purple-500/50">🐘 PHP</button>
                  <button type="button" data-lang="pseint" class="lang-tab-btn px-4 py-2 rounded-xl border border-slate-700 font-black text-xs cursor-pointer bg-slate-900 text-slate-300 hover:border-purple-500/50">📝 PSeInt</button>
                </div>
              </div>

              <div id="codeBlocksContainer" class="mt-1">
                <div class="code-panel" data-lang-panel="python"><CodeBlock lang="python" title="Solución en Python" code="" /></div>
                <div class="code-panel hidden" data-lang-panel="java"><CodeBlock lang="java" title="Solución en Java" code="" /></div>
                <div class="code-panel hidden" data-lang-panel="csharp"><CodeBlock lang="csharp" title="Solución en C#" code="" /></div>
                <div class="code-panel hidden" data-lang-panel="cpp"><CodeBlock lang="cpp" title="Solución en C++" code="" /></div>
                <div class="code-panel hidden" data-lang-panel="javascript"><CodeBlock lang="javascript" title="Solución en JavaScript" code="" /></div>
                <div class="code-panel hidden" data-lang-panel="php"><CodeBlock lang="php" title="Solución en PHP" code="" /></div>
                <div class="code-panel hidden" data-lang-panel="pseint"><CodeBlock lang="pseint" title="Solución en PSeInt" code="" /></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <script is:inline define:vars={{ rawSolutions: gameInventorySolutions }}>
        window.ALL_GAME_INV_SOLUTIONS = rawSolutions;
      </script>

    </div>
  </div>

  <script is:inline>
    (function () {
      const KEY = 'aprende_game_inventory_v1';
      const readStore = () => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } };
      const writeStore = (s) => localStorage.setItem(KEY, JSON.stringify(s));

      const syncCompleteStatus = (exId, isCompleted) => {
        document.querySelectorAll('input[data-complete-id="' + exId + '"]').forEach((chk) => { chk.checked = isCompleted; });
        const rawNum = exId.replace('inv-', '');
        try { localStorage.setItem(`game_inv_${rawNum}_done`, isCompleted ? 'true' : 'false'); } catch (e) {}
        const quickItem = document.querySelector('.quick-item[data-quick-id="' + exId + '"]');
        if (quickItem) {
          const badge = quickItem.querySelector('.quick-badge-done');
          if (isCompleted) { quickItem.classList.add('is-completed'); badge?.classList.remove('hidden'); }
          else { quickItem.classList.remove('is-completed'); badge?.classList.add('hidden'); }
        }
      };

      const updateProgressFor = (exId) => {
        const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
        if (!card) return;
        const boxes = card.querySelectorAll('input[type="checkbox"][data-check-id]');
        const done = Array.from(boxes).filter((b) => b.checked).length;
        const total = boxes.length;
        card.querySelectorAll('[data-progress-for="' + exId + '"]').forEach((el) => {
          el.textContent = done + ' / ' + total;
          if (done === total && total > 0) { el.classList.add('bg-purple-600', 'text-white'); }
          else { el.classList.remove('bg-purple-600', 'text-white'); }
        });
        if (done === total && total > 0) {
          const s = readStore();
          if (!s[exId]) s[exId] = {};
          s[exId]['__completed__'] = true;
          writeStore(s);
          syncCompleteStatus(exId, true);
        }
      };

      document.querySelectorAll('.ex-card[data-ex-id]').forEach((card) => {
        const exId = card.getAttribute('data-ex-id');
        const perEx = (readStore()[exId]) || {};
        card.querySelectorAll('input[type="checkbox"][data-check-id]').forEach((input) => {
          const checkId = input.getAttribute('data-check-id');
          input.checked = Boolean(perEx[checkId]);
          input.addEventListener('click', (e) => e.stopPropagation());
          input.addEventListener('change', () => {
            const s = readStore();
            if (!s[exId]) s[exId] = {};
            s[exId][checkId] = input.checked;
            writeStore(s);
            updateProgressFor(exId);
          });
        });
        updateProgressFor(exId);
        syncCompleteStatus(exId, Boolean(perEx['__completed__']));
      });

      document.querySelectorAll('input[data-complete-id]').forEach((chk) => {
        chk.addEventListener('change', () => {
          const exId = chk.getAttribute('data-complete-id');
          const isDone = chk.checked;
          const s = readStore();
          if (!s[exId]) s[exId] = {};
          s[exId]['__completed__'] = isDone;
          const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
          if (card) {
            card.querySelectorAll('input[type="checkbox"][data-check-id]').forEach((box) => {
              box.checked = isDone;
              s[exId][box.getAttribute('data-check-id')] = isDone;
            });
          }
          writeStore(s);
          syncCompleteStatus(exId, isDone);
          updateProgressFor(exId);
        });
      });

      document.getElementById('expandAll')?.addEventListener('click', () => document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = true)));
      document.getElementById('collapseAll')?.addEventListener('click', () => document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = false)));

      // Buscador
      document.getElementById('searchBox')?.addEventListener('input', (e) => {
        const val = (e.target.value || '').toLowerCase().trim();
        document.querySelectorAll('.search-target').forEach((el) => {
          const kw = el.getAttribute('data-keywords') || '';
          el.style.display = !val || kw.includes(val) ? '' : 'none';
        });
      });

      // Modal
      (function() {
        const ALL_SOLUTIONS = window.ALL_GAME_INV_SOLUTIONS || {};
        const modal = document.getElementById('solutionModal');
        const mathStep = document.getElementById('mathVerificationStep');
        const codeStep = document.getElementById('solutionCodeStep');
        const challengeText = document.getElementById('mathChallengeText');
        const answerInput = document.getElementById('mathAnswerInput');
        const verifyBtn = document.getElementById('verifyMathBtn');
        const errorMsg = document.getElementById('mathErrorMessage');
        let currentExpected = 25;

        const openModal = (e) => {
          if (e) e.stopPropagation();
          const btn = e.currentTarget;
          const exId = parseInt(btn.getAttribute('data-ex-id') || '1', 10);
          const exTitle = btn.getAttribute('data-ex-title') || '';
          document.getElementById('modalExNum').textContent = String(exId).padStart(2, '0');
          document.getElementById('modalExTitle').textContent = `Misión ${exId}: ${exTitle}`;

          const sol = ALL_SOLUTIONS[exId];
          if (sol) {
            document.querySelectorAll('#codeBlocksContainer .code-panel').forEach((p) => {
              const lang = p.getAttribute('data-lang-panel');
              const codeContent = sol[lang];
              const linesContainer = p.querySelector('.code-viewer');
              if (codeContent && linesContainer) {
                linesContainer.innerHTML = codeContent.split('\n').map((line, idx) => {
                  const esc = line.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                  return `<div class="code-line flex px-2 leading-[1.65] text-[0.93rem] hover:bg-white/5 min-w-max"><span class="line-num text-right select-none min-w-[2.2rem] pr-3 mr-3 opacity-40 shrink-0 border-r border-white/10">${idx + 1}</span><span class="whitespace-pre">${esc}</span></div>`;
                }).join('');
              }
            });
          }

          const n1 = Math.floor(Math.random() * 20) + 5;
          const n2 = Math.floor(Math.random() * 20) + 5;
          currentExpected = n1 + n2;
          challengeText.textContent = `${n1} + ${n2} =`;
          answerInput.value = '';
          errorMsg?.classList.add('hidden');
          mathStep?.classList.remove('hidden');
          codeStep?.classList.add('hidden');
          modal?.classList.remove('hidden');
          modal?.classList.add('flex');
        };

        document.querySelectorAll('.open-solution-modal-btn').forEach(b => b.addEventListener('click', openModal));
        document.getElementById('closeSolutionModal')?.addEventListener('click', () => { modal?.classList.add('hidden'); modal?.classList.remove('flex'); });

        verifyBtn?.addEventListener('click', () => {
          if (parseInt(answerInput.value, 10) === currentExpected) {
            mathStep?.classList.add('hidden');
            codeStep?.classList.remove('hidden');
            codeStep?.classList.add('flex');
          } else {
            errorMsg?.classList.remove('hidden');
          }
        });

        document.querySelectorAll('#langSelectorGroup .lang-tab-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const lang = btn.getAttribute('data-lang');
            document.querySelectorAll('#langSelectorGroup .lang-tab-btn').forEach(b => {
              b.classList.remove('bg-purple-600', 'text-white');
              b.classList.add('bg-slate-900', 'text-slate-300');
            });
            btn.classList.remove('bg-slate-900', 'text-slate-300');
            btn.classList.add('bg-purple-600', 'text-white');
            document.querySelectorAll('#codeBlocksContainer .code-panel').forEach(p => {
              p.classList.toggle('hidden', p.getAttribute('data-lang-panel') !== lang);
            });
          });
        });
      })();
    })();
  </script>

  <style>
    .quick-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      background: #0d1527;
      border: 2px solid rgba(168, 85, 247, 0.3);
      border-radius: 0.75rem;
      box-shadow: 0 0 10px rgba(168, 85, 247, 0.1);
      transition: all 0.15s ease;
    }
    .quick-item:hover {
      transform: translateY(-1px);
      border-color: #a855f7;
      box-shadow: 0 0 15px rgba(168, 85, 247, 0.3);
    }
    .quick-item.is-completed {
      background: #3b0764;
      border-color: #a855f7;
    }
    .quick-num {
      font-weight: 900;
      font-size: 0.75rem;
      background: #1e1b4b;
      color: #d8b4fe;
      padding: 0.15rem 0.4rem;
      border-radius: 0.35rem;
      border: 1px solid rgba(168, 85, 247, 0.4);
    }
    .quick-title {
      font-weight: 800;
      font-size: 0.82rem;
      color: #ffffff;
    }
    .quick-arrow {
      margin-left: auto;
      font-weight: 900;
      color: #64748b;
    }
  </style>
</GameLayout>
