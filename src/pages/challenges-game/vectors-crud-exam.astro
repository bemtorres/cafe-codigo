                </span>
              </div>
            </div>

            <!-- ENUNCIADO -->
            <p class="text-sm text-slate-300 leading-relaxed mb-4">
              {ex.statement}
            </p>

            <!-- ESPECIFICACIÓN TÉCNICA -->
            <div class="grid grid-cols-1 md:grid-cols-1 gap-3 my-4">
              <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800">
                <div class="text-[10px] text-blue-400 font-bold uppercase tracking-wider mb-1">📦 Vectores en Memoria:</div>
                <code class="text-xs text-slate-200 font-mono block">{ex.vectors}</code>
              </div>
              <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800">
                <div class="text-[10px] text-indigo-400 font-bold uppercase tracking-wider mb-1">⚙️ Funciones Clave:</div>
                <div class="space-y-1">
                  {ex.functions.map(fn => (
                    <code class="text-[11px] text-emerald-300 font-mono block truncate">{fn}</code>
                  ))}
                </div>
              </div>
            </div>

            <!-- CHECKLIST DE PASOS -->
            <div class="my-4 p-4 rounded-xl bg-slate-900/40 border border-slate-800/80">
              <div class="text-xs font-bold text-slate-300 mb-2">📋 Pasos de Implementación / Criterios de Evaluación:</div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                {ex.steps.map((st) => (
                  <label class="flex items-start gap-2 text-xs text-slate-400 hover:text-slate-200 cursor-pointer select-none">
                    <input type="checkbox" class="mt-0.5 rounded border-slate-700 text-blue-600 focus:ring-0" />
                    <span><strong>{st.title}:</strong> {st.desc}</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- BOTÓN DE DESBLOQUEO DE SOLUCIÓN -->
            <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between flex-wrap gap-3">
              <span class="text-xs text-slate-400">
                Disponible en: <strong>C++, Python, Java, C#, JS, PHP, PSeInt</strong>
              </span>
              <button
                type="button"
                class="open-solution-modal-btn px-4 py-2 rounded-xl bg-blue-600/20 hover:bg-blue-600/30 text-blue-300 border border-blue-500/40 font-bold text-xs transition-all flex items-center gap-2 cursor-pointer active:scale-95"
                data-ex-id={ex.id}
                data-ex-title={ex.title}
              >
                <span>🔒 Desbloquear Solución & Resultado</span>
              </button>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>

  <!-- MODAL DE SOLUCIÓN MULTILENGUAJE CON CLAVE -->
  <div id="solutionModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md">
    <div class="bg-[#0b1222] border-2 border-blue-500/40 w-full max-w-4xl max-h-[90vh] rounded-3xl shadow-2xl flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      
      <!-- CABECERA MODAL -->
      <div class="px-6 py-4 border-b border-slate-800 bg-slate-900/50 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-xl">💡</span>
          <div>
            <h3 id="modalExerciseTitle" class="text-base sm:text-lg font-black text-white m-0">Solución del Ejercicio</h3>
            <p class="text-xs text-blue-400 m-0">Vectores Paralelos y Funciones CRUD Multilenguaje</p>
          </div>
        </div>
        <button id="closeSolutionModal" class="text-slate-400 hover:text-white p-2 rounded-xl hover:bg-slate-800 transition-colors text-lg cursor-pointer">
          ✕
        </button>
      </div>

      <!-- PASO 1: VALIDACIÓN DE CONTRASEÑA -->
      <div id="passwordStep" class="p-8 flex flex-col items-center justify-center text-center">
        <div class="w-16 h-16 rounded-2xl bg-blue-950/80 border border-blue-500/40 text-blue-400 text-3xl flex items-center justify-center mb-4 shadow-lg shadow-blue-500/10">
          🔒
        </div>
        <h4 class="text-xl font-black text-white mb-2">Ingresa la clave para ver el código y resultados</h4>
        <p class="text-slate-300 text-sm max-w-md mb-6">
          Este módulo está protegido para evaluar el razonamiento del estudiante. Introduce la clave de revisión (fecha actual en formato <strong>DDMMAAAA</strong>, ej: <code class="text-amber-300 font-mono font-bold">05092026</code> o clave docente).
        </p>

        <div class="flex items-center gap-2 w-full max-w-sm">
          <input
            type="password"
            id="modalPasswordInput"
            placeholder="Clave (ej: 05092026)..."
            class="flex-1 px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white text-sm font-mono focus:border-blue-400 outline-none"
          />
          <button
            type="button"
            id="btnVerifyPassword"
            class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-black text-sm transition-all shadow-md active:scale-95 cursor-pointer"
          >
            Verificar
          </button>
        </div>

        <div id="modalPasswordError" class="mt-3 text-xs text-red-400 font-bold hidden flex items-center gap-1.5">
          <span>❌ Clave incorrecta. Usa la fecha actual en formato DDMMAAAA (ej: 05092026).</span>
        </div>
      </div>

      <!-- PASO 2: CÓDIGO Y SOLUCIÓN EN 7 LENGUAJES (VISIBLE TRAS VALIDAR) -->
      <div id="codeStep" class="hidden flex-col flex-1 overflow-hidden">
        <!-- SELECTOR DE LENGUAJE -->
        <div class="px-6 py-3 border-b border-slate-800 bg-slate-900/30 flex items-center gap-2 overflow-x-auto" id="langSelectorGroup">
          <button type="button" class="lang-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer bg-blue-600 text-white" data-lang="cpp">C++</button>
          <button type="button" class="lang-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer bg-slate-900 text-slate-300 hover:text-white" data-lang="python">Python</button>
          <button type="button" class="lang-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer bg-slate-900 text-slate-300 hover:text-white" data-lang="java">Java</button>
          <button type="button" class="lang-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer bg-slate-900 text-slate-300 hover:text-white" data-lang="csharp">C#</button>
          <button type="button" class="lang-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer bg-slate-900 text-slate-300 hover:text-white" data-lang="javascript">JavaScript</button>
          <button type="button" class="lang-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer bg-slate-900 text-slate-300 hover:text-white" data-lang="php">PHP</button>
          <button type="button" class="lang-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer bg-slate-900 text-slate-300 hover:text-white" data-lang="pseint">PSeInt</button>
        </div>

        <!-- VISOR DE CÓDIGO -->
        <div class="flex-1 overflow-y-auto p-4 bg-[#070b14]" id="codeBlocksContainer">
          <div class="code-panel" data-lang-panel="cpp"><CodeBlock lang="cpp" title="Solución en C++" code="" /></div>
          <div class="code-panel hidden" data-lang-panel="python"><CodeBlock lang="python" title="Solución en Python" code="" /></div>
          <div class="code-panel hidden" data-lang-panel="java"><CodeBlock lang="java" title="Solución en Java" code="" /></div>
          <div class="code-panel hidden" data-lang-panel="csharp"><CodeBlock lang="csharp" title="Solución en C#" code="" /></div>
          <div class="code-panel hidden" data-lang-panel="javascript"><CodeBlock lang="javascript" title="Solución en JavaScript" code="" /></div>
          <div class="code-panel hidden" data-lang-panel="php"><CodeBlock lang="php" title="Solución en PHP" code="" /></div>
          <div class="code-panel hidden" data-lang-panel="pseint"><CodeBlock lang="pseint" title="Solución en PSeInt" code="" /></div>
        </div>
      </div>

    </div>
  </div>

  <script is:inline define:vars={{ rawSolutions: gameVectorsCrudSolutions }}>
    window.ALL_VECTORS_CRUD_SOLUTIONS = rawSolutions;
  </script>

  <script is:inline>
    (function () {
      function getFormattedToday() {
        const d = new Date();
        const day = String(d.getDate()).padStart(2, "0");
        const month = String(d.getMonth() + 1).padStart(2, "0");
        const year = String(d.getFullYear());
        return day + month + year;
      }

      function isValidKey(inputKey) {
        const cleaned = (inputKey || "").trim().toLowerCase();
        const todayKey = getFormattedToday();
        return (
          cleaned === todayKey ||
          cleaned === "05092026" ||
          cleaned === "06092026" ||
          cleaned === "revisionevaluacion" ||
          cleaned === "examen"
        );
      }

      let isUnlockedGlobally = false;
      let currentExId = 1;

      const ALL_SOLUTIONS = window.ALL_VECTORS_CRUD_SOLUTIONS || {};
      const modal = document.getElementById("solutionModal");
      const titleEl = document.getElementById("modalExerciseTitle");
      const passwordStep = document.getElementById("passwordStep");
      const codeStep = document.getElementById("codeStep");
      const passwordInput = document.getElementById("modalPasswordInput");
      const verifyBtn = document.getElementById("btnVerifyPassword");
      const errorMsg = document.getElementById("modalPasswordError");
      const closeModalBtn = document.getElementById("closeSolutionModal");

      function loadExerciseCode(exId) {
        const sol = ALL_SOLUTIONS[exId];
        if (!sol) return;

        document.querySelectorAll("#codeBlocksContainer .code-panel").forEach((panel) => {
          const lang = panel.getAttribute("data-lang-panel");
          const codeContent = sol[lang];
          const viewer = panel.querySelector(".code-viewer");
          const copyBtn = panel.querySelector(".copy-btn");
          
          if (copyBtn && codeContent) {
            copyBtn.setAttribute("data-copy-code", encodeURIComponent(codeContent));
          }

          if (codeContent && viewer) {
            viewer.innerHTML = codeContent
              .split("\n")
              .map((line, idx) => {
                const esc = line
                  .replace(/&/g, "&amp;")
                  .replace(/</g, "&lt;")
                  .replace(/>/g, "&gt;");
                return `<div class="flex px-2 leading-[1.65] hover:bg-white/5 min-w-max"><span class="text-right select-none min-w-[2.2rem] pr-3 mr-3 opacity-40 shrink-0 border-r border-white/10 text-slate-500">${idx + 1}</span><span class="whitespace-pre">${esc}</span></div>`;
              })
              .join("");
          }
        });
      }

      function openModal(exId, exTitle) {
        currentExId = exId;
        if (titleEl) titleEl.textContent = exTitle;
        loadExerciseCode(exId);

        if (isUnlockedGlobally) {
          passwordStep?.classList.add("hidden");
          codeStep?.classList.remove("hidden");
          codeStep?.classList.add("flex");
        } else {
          passwordStep?.classList.remove("hidden");
          codeStep?.classList.add("hidden");
          if (passwordInput) passwordInput.value = "";
          errorMsg?.classList.add("hidden");
        }

        modal?.classList.remove("hidden");
        modal?.classList.add("flex");
        if (!isUnlockedGlobally) passwordInput?.focus();
      }

      function closeModal() {
        modal?.classList.add("hidden");
        modal?.classList.remove("flex");
      }

      document.querySelectorAll(".open-solution-modal-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const exId = parseInt(btn.getAttribute("data-ex-id") || "1", 10);
          const exTitle = btn.getAttribute("data-ex-title") || "Solución";
          openModal(exId, exTitle);
        });
      });

      closeModalBtn?.addEventListener("click", closeModal);
      modal?.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });

      function handleVerify() {
        const val = passwordInput?.value.trim();
        if (isValidKey(val)) {
          isUnlockedGlobally = true;
          passwordStep?.classList.add("hidden");
          codeStep?.classList.remove("hidden");
          codeStep?.classList.add("flex");
          errorMsg?.classList.add("hidden");
        } else {
          errorMsg?.classList.remove("hidden");
        }
      }

      verifyBtn?.addEventListener("click", handleVerify);
      passwordInput?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") handleVerify();
      });

      // Hero unlock all button
      document.getElementById("btnHeroUnlockAll")?.addEventListener("click", () => {
        openModal(1, "1. CRUD Inventario de Productos y Precios");
      });

      // Tabs de lenguaje
      document.querySelectorAll("#langSelectorGroup .lang-tab-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const lang = btn.getAttribute("data-lang");
          document.querySelectorAll("#langSelectorGroup .lang-tab-btn").forEach((b) => {
            b.classList.remove("bg-blue-600", "text-white");
            b.classList.add("bg-slate-900", "text-slate-300");
          });
          btn.classList.remove("bg-slate-900", "text-slate-300");
          btn.classList.add("bg-blue-600", "text-white");

          document.querySelectorAll("#codeBlocksContainer .code-panel").forEach((p) => {
            p.classList.toggle("hidden", p.getAttribute("data-lang-panel") !== lang);
          });
        });
      });
    })();
  </script>
</GameLayout>
