          <details class="ex-card border-2 border-cyan-500/30 bg-slate-900/90 rounded-2xl p-4 shadow-[0_0_15px_rgba(6,182,212,0.08)] search-target transition-all" id={`fn-${ex.id}`} data-ex-id={`fn-${ex.id}`} data-keywords={`${ex.title} ${ex.section} ${ex.statement}`.toLowerCase()}>
            <summary class="ex-summary flex items-center justify-between cursor-pointer font-nunito font-black select-none text-white">
              <div class="flex items-center gap-3 pr-2 min-w-0">
