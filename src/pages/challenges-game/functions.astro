        <!-- CONTENIDO INTERACTIVO -->
        <div class="p-5 sm:p-6 overflow-y-auto flex-1 font-nunito">
          
          <!-- PASO 1: VERIFICACIÓN MATEMÁTICA -->
          <div id="mathVerificationStep" class="bg-[#050B1A] border-2 border-amber-500/40 rounded-3xl p-6 sm:p-8 text-center my-4">
            <div class="text-4xl mb-2">🔐</div>
            <h4 class="font-['Orbitron'] font-black text-amber-400 text-lg sm:text-xl m-0 mb-1">Verificación para desbloquear la solución</h4>
            <p class="text-xs sm:text-sm font-bold text-slate-300 m-0 mb-4 max-w-md mx-auto">Resuelve la siguiente operación matemática para visualizar el código resuelto en todos los lenguajes soportados:</p>
            
            <div class="inline-flex items-center justify-center gap-3 bg-slate-950 px-6 py-3.5 rounded-2xl border-2 border-cyan-500/40 shadow-[0_0_15px_rgba(6,182,212,0.15)] mb-4">
              <span id="mathChallengeText" class="font-['Orbitron'] font-black text-xl sm:text-2xl text-cyan-300">12 + 8 =</span>
              <input type="number" id="mathAnswerInput" class="w-24 px-3 py-2 rounded-xl border border-cyan-500/50 bg-slate-900 font-['Orbitron'] font-black text-xl text-center text-white outline-none focus:ring-2 focus:ring-cyan-400" placeholder="?" />
            </div>

            <div>
              <button type="button" id="verifyMathBtn" class="px-6 py-3 bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-['Orbitron'] font-black text-xs sm:text-sm rounded-xl border border-cyan-400 shadow-[0_0_15px_rgba(6,182,212,0.3)] hover:-translate-y-0.5 transition-all cursor-pointer">
                🔓 Comprobar y Desbloquear Solución
              </button>
            </div>
            <p id="mathErrorMessage" class="text-xs sm:text-sm font-black text-rose-400 m-0 mt-3 hidden">❌ Respuesta incorrecta. ¡Inténtalo de nuevo!</p>
          </div>

          <!-- PASO 2: CÓDIGO DESBLOQUEADO -->
          <div id="solutionCodeStep" class="hidden flex-col gap-4">
            <!-- SELECTOR DE LENGUAJE -->
            <div class="bg-[#060D1E] border border-cyan-500/30 p-3 rounded-2xl">
              <label class="block text-xs font-black text-cyan-400 mb-2 uppercase tracking-wider">Selecciona el lenguaje de programación:</label>
              <div class="flex flex-wrap gap-2" id="langSelectorGroup">
                <button type="button" data-lang="python" class="lang-tab-btn active px-4 py-2 rounded-xl border border-cyan-400 font-black text-xs cursor-pointer bg-cyan-600 text-white shadow-[0_0_10px_rgba(6,182,212,0.3)]">🐍 Python</button>
                <button type="button" data-lang="java" class="lang-tab-btn px-4 py-2 rounded-xl border border-slate-700 font-black text-xs cursor-pointer bg-slate-900 text-slate-300 hover:border-cyan-500/50">☕ Java</button>
                <button type="button" data-lang="csharp" class="lang-tab-btn px-4 py-2 rounded-xl border border-slate-700 font-black text-xs cursor-pointer bg-slate-900 text-slate-300 hover:border-cyan-500/50">🔷 C#</button>
                <button type="button" data-lang="cpp" class="lang-tab-btn px-4 py-2 rounded-xl border border-slate-700 font-black text-xs cursor-pointer bg-slate-900 text-slate-300 hover:border-cyan-500/50">⚙️ C++</button>
                <button type="button" data-lang="javascript" class="lang-tab-btn px-4 py-2 rounded-xl border border-slate-700 font-black text-xs cursor-pointer bg-slate-900 text-slate-300 hover:border-cyan-500/50">⚡ JavaScript</button>
                <button type="button" data-lang="php" class="lang-tab-btn px-4 py-2 rounded-xl border border-slate-700 font-black text-xs cursor-pointer bg-slate-900 text-slate-300 hover:border-cyan-500/50">🐘 PHP</button>
                <button type="button" data-lang="pseint" class="lang-tab-btn px-4 py-2 rounded-xl border border-slate-700 font-black text-xs cursor-pointer bg-slate-900 text-slate-300 hover:border-cyan-500/50">📝 PSeInt</button>
              </div>
            </div>

            <!-- BLOQUES DE CÓDIGO CON RESALTADO -->
            <div id="codeBlocksContainer" class="mt-1">
              <div class="code-panel" data-lang-panel="python">
