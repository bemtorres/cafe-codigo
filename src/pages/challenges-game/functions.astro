      <div class="w-full md:w-auto flex items-center gap-4">
        <div class="w-full sm:w-80">
          <span class="text-xs font-nunito font-black text-cyan-400 uppercase tracking-wider block mb-1">🔍 Filtro de búsqueda</span>
          <input
            type="text"
            id="searchBox"
            placeholder="Buscar misión por nombre, daño, loot, mana..."
            class="w-full px-3 py-2 rounded-xl border border-slate-700 font-nunito font-bold text-xs bg-slate-950 text-white focus:outline-none focus:border-cyan-400"
          />
        </div>
      </div>

      <div class="flex items-center gap-2 w-full md:w-auto justify-end">
        <button type="button" id="expandAll" class="px-3.5 py-2 rounded-xl border border-cyan-500/50 bg-cyan-950 hover:bg-cyan-900 text-cyan-300 font-nunito font-black text-xs cursor-pointer shadow-md hover:-translate-y-0.5 transition-transform">Expandir todos (50)</button>
        <button type="button" id="collapseAll" class="px-3.5 py-2 rounded-xl border border-slate-700 bg-slate-950 hover:bg-slate-900 text-slate-400 font-nunito font-black text-xs cursor-pointer hover:-translate-y-0.5 transition-transform">Colapsar todos</button>
      </div>
    </div>

    <!-- BOTÓN FLOTANTE DE SUGERENCIAS GUIADAS -->
    <aside class="fixed bottom-6 right-6 z-50 flex items-center">
      <label for="toggleSuggestions" class="flex items-center gap-3 bg-slate-950/95 hover:bg-slate-900 text-cyan-300 px-4 py-3 rounded-2xl border-2 border-cyan-500 shadow-[0_0_20px_rgba(6,182,212,0.3)] hover:-translate-y-1 transition-all cursor-pointer select-none">
        <input type="checkbox" id="toggleSuggestions" class="w-5 h-5 accent-cyan-500 rounded cursor-pointer" />
        <span class="font-nunito font-extrabold text-xs sm:text-sm flex items-center gap-1.5">
          <span>💡</span>
          <span>Activar sugerencias guiadas (Paso a Paso)</span>
        </span>
      </label>
    </aside>

    <!-- LISTADO RÁPIDO DE 50 MISIONES GAMER -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-3 border-b border-cyan-500/30 pb-2">
        <h2 class="text-base font-['Orbitron'] font-black text-white m-0 flex items-center gap-2">
          <span>📋</span> Misiones Gamer Disponibles (1 al 50)
        </h2>
        <span class="text-xs font-nunito font-bold bg-cyan-950 border border-cyan-500/50 text-cyan-300 px-2.5 py-0.5 rounded-full">50 misiones · +5,000 XP</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-2" id="quickList">
        {exercises.map((ex) => (
          <div class="quick-item search-target" data-keywords={`${ex.title} ${ex.section} ${ex.statement}`.toLowerCase()} data-quick-id={`fn-${ex.id}`}>
            <label class="flex items-center cursor-pointer p-0.5 shrink-0" title="Marcar como completado">
              <input type="checkbox" data-complete-id={`fn-${ex.id}`} class="w-4 h-4 accent-cyan-500 rounded cursor-pointer" />
            </label>
            <a href={`#fn-${ex.id}`} class="quick-link flex items-center gap-2.5 flex-1 min-w-0 no-underline text-inherit">
              <span class="quick-num">{String(ex.id).padStart(2, '0')}</span>
              <span class="quick-title truncate">{ex.title}</span>
              <span class="quick-badge-done hidden text-[0.65rem] font-bold bg-emerald-950 text-emerald-300 px-1.5 py-0.5 rounded border border-emerald-500/50">✓ Completada</span>
