    <script is:inline define:vars={{ rawSolutions: gameFunctionSolutions }}>
      window.ALL_GAME_FUNCTIONS_SOLUTIONS = rawSolutions;
    </script>

    </div>
  </div>

  <!-- ═══ SCRIPT DE PERSISTENCIA Y SINCRONIZACIÓN ═══ -->
  <script is:inline>
    (function () {
      const KEY = 'aprende_game_functions_v1';
      const readStore = () => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } };
      const writeStore = (s) => localStorage.setItem(KEY, JSON.stringify(s));

      const syncCompleteStatus = (exId, isCompleted) => {
        document.querySelectorAll('input[data-complete-id="' + exId + '"]').forEach((chk) => { chk.checked = isCompleted; });
        
        // Guardar flag individual para el HUD global de Zona Gamer
        const rawNum = exId.replace('fn-', '');
        try {
          localStorage.setItem(`game_fn_${rawNum}_done`, isCompleted ? 'true' : 'false');
        } catch (e) {}

        const quickItem = document.querySelector('.quick-item[data-quick-id="' + exId + '"]');
        if (quickItem) {
          const badge = quickItem.querySelector('.quick-badge-done');
          if (isCompleted) {
            quickItem.classList.add('is-completed');
            if (badge) badge.classList.remove('hidden');
          } else {
            quickItem.classList.remove('is-completed');
            if (badge) badge.classList.add('hidden');
          }
        }
        const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
        if (card) {
          const tag = card.querySelector('.card-done-tag');
          if (isCompleted) {
            card.classList.add('border-cyan-500', 'bg-cyan-50/30');
            if (tag) tag.classList.remove('hidden');
          } else {
            card.classList.remove('border-cyan-500', 'bg-cyan-50/30');
            if (tag) tag.classList.add('hidden');
          }
        }
      };

      const updateProgressFor = (exId) => {
        const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
        if (!card) return;
        const boxes = card.querySelectorAll('input[type="checkbox"][data-check-id]');
        const done = Array.from(boxes).filter((b) => b.checked).length;
        const total = boxes.length;
        const els = card.querySelectorAll('[data-progress-for="' + exId + '"]');
        els.forEach((el) => {
          el.textContent = done + ' / ' + total;
          if (done === total && total > 0) {
            el.classList.add('bg-cyan-600', 'text-white');
            el.classList.remove('bg-slate-100', 'text-slate-500');
          } else {
            el.classList.remove('bg-cyan-600', 'text-white');
            el.classList.add('bg-slate-100', 'text-slate-500');
          }
        });

        const store = readStore();
        if (done === total && total > 0) {
          if (!store[exId]) store[exId] = {};
          store[exId]['__completed__'] = true;
          writeStore(store);
          syncCompleteStatus(exId, true);
        }
      };

      document.querySelectorAll('.ex-card[data-ex-id]').forEach((card) => {
        const exId = card.getAttribute('data-ex-id');
        const perEx = (readStore()[exId]) || {};
        card.querySelectorAll('input[type="checkbox"][data-check-id]').forEach((input) => {
          const checkId = input.getAttribute('data-check-id');
          input.checked = Boolean(perEx[checkId]);
          input.addEventListener('click', (e) => e.stopPropagation());
          input.addEventListener('change', () => {
            const s = readStore();
            if (!s[exId]) s[exId] = {};
            s[exId][checkId] = input.checked;
            writeStore(s);
            updateProgressFor(exId);
          });
        });
        updateProgressFor(exId);
        syncCompleteStatus(exId, Boolean(perEx['__completed__']));
      });

      document.querySelectorAll('input[data-complete-id]').forEach((chk) => {
        chk.addEventListener('change', () => {
          const exId = chk.getAttribute('data-complete-id');
          const isDone = chk.checked;
          const s = readStore();
          if (!s[exId]) s[exId] = {};
          s[exId]['__completed__'] = isDone;

          const card = document.querySelector('.ex-card[data-ex-id="' + exId + '"]');
          if (card) {
            card.querySelectorAll('input[type="checkbox"][data-check-id]').forEach((box) => {
              box.checked = isDone;
              const checkId = box.getAttribute('data-check-id');
              s[exId][checkId] = isDone;
            });
          }

          writeStore(s);
          syncCompleteStatus(exId, isDone);
          updateProgressFor(exId);
        });
      });

      document.getElementById('expandAll')?.addEventListener('click', () => {
        document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = true));
      });
      document.getElementById('collapseAll')?.addEventListener('click', () => {
        document.querySelectorAll('.ex-card[id]').forEach((d) => (d.open = false));
      });

      // Filtro de búsqueda
      const searchBox = document.getElementById('searchBox');
      searchBox?.addEventListener('input', (e) => {
        const val = (e.target.value || '').toLowerCase().trim();
        document.querySelectorAll('.search-target').forEach((el) => {
          const kw = el.getAttribute('data-keywords') || '';
          const match = !val || kw.includes(val);
          el.style.display = match ? '' : 'none';
        });
      });

      // Toggle de Sugerencias Guiadas
      const toggleBtn = document.getElementById('toggleSuggestions');
      const SUGGESTIONS_KEY = 'aprende_game_show_step_suggestions';

      const updateSuggestionsVisibility = (show) => {
        document.querySelectorAll('.ex-checks').forEach((el) => {
          if (show) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });
      };

      if (toggleBtn) {
        const savedPref = localStorage.getItem(SUGGESTIONS_KEY);
        const isEnabled = savedPref === 'true';
        toggleBtn.checked = isEnabled;
        updateSuggestionsVisibility(isEnabled);

        toggleBtn.addEventListener('change', (e) => {
          const checked = e.target.checked;
          localStorage.setItem(SUGGESTIONS_KEY, String(checked));
          updateSuggestionsVisibility(checked);
        });
      }

      // Modal de Ver Solución con Desafío Matemático
      (function setupSolutionModal() {
        const ALL_SOLUTIONS = window.ALL_GAME_FUNCTIONS_SOLUTIONS || {};
        const modal = document.getElementById('solutionModal');
        const closeBtn = document.getElementById('closeSolutionModal');
        const openBtns = document.querySelectorAll('.open-solution-modal-btn');
        
        const modalExNum = document.getElementById('modalExNum');
        const modalExTitle = document.getElementById('modalExTitle');

        const mathStep = document.getElementById('mathVerificationStep');
        const codeStep = document.getElementById('solutionCodeStep');
        
        const challengeText = document.getElementById('mathChallengeText');
        const answerInput = document.getElementById('mathAnswerInput');
        const verifyBtn = document.getElementById('verifyMathBtn');
        const errorMsg = document.getElementById('mathErrorMessage');

        let currentExpectedAnswer = 0;
        let activeExId = 1;

        const generateMathChallenge = () => {
          const ops = ['+', '-', '*', '/'];
          const op = ops[Math.floor(Math.random() * ops.length)];
          let num1 = 0;
          let num2 = 0;

          if (op === '+') {
            num1 = Math.floor(Math.random() * 20) + 5;
            num2 = Math.floor(Math.random() * 20) + 5;
            currentExpectedAnswer = num1 + num2;
          } else if (op === '-') {
            num1 = Math.floor(Math.random() * 30) + 15;
            num2 = Math.floor(Math.random() * 14) + 1;
            currentExpectedAnswer = num1 - num2;
          } else if (op === '*') {
            num1 = Math.floor(Math.random() * 9) + 2;
            num2 = Math.floor(Math.random() * 9) + 2;
            currentExpectedAnswer = num1 * num2;
          } else if (op === '/') {
            num2 = Math.floor(Math.random() * 8) + 2;
            const factor = Math.floor(Math.random() * 9) + 2;
            num1 = num2 * factor;
            currentExpectedAnswer = factor;
          }

          const symbolMap = { '+': '+', '-': '-', '*': '×', '/': '÷' };
          if (challengeText) {
            challengeText.textContent = `${num1} ${symbolMap[op]} ${num2} =`;
          }
          if (answerInput) {
            answerInput.value = '';
          }
          if (errorMsg) {
            errorMsg.classList.add('hidden');
          }
        };

        const renderCodeForExercise = (exId) => {
          const sol = ALL_SOLUTIONS[exId];
          if (!sol) return;

          const panels = document.querySelectorAll('#codeBlocksContainer .code-panel');
          panels.forEach((p) => {
            const lang = p.getAttribute('data-lang-panel');
            const codeContent = sol[lang];
            const linesContainer = p.querySelector('.code-viewer');
            
            if (codeContent && linesContainer) {
              const lines = codeContent.split('\n');
              linesContainer.innerHTML = lines.map((line, idx) => {
                const escapedLine = line.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                return `<div class="code-line flex px-2 leading-[1.65] text-[0.93rem] hover:bg-white/5 min-w-max">
                  <span class="line-num text-right select-none min-w-[2.2rem] pr-3 mr-3 opacity-40 shrink-0 border-r border-white/10">${idx + 1}</span>
                  <span class="whitespace-pre">${escapedLine}</span>
                </div>`;
              }).join('');
            }
          });
        };

        const openModal = (e) => {
          if (e) e.stopPropagation();
          const btn = e.currentTarget;
          const exId = parseInt(btn.getAttribute('data-ex-id') || '1', 10);
          const exTitle = btn.getAttribute('data-ex-title') || '';
          activeExId = exId;

          if (modalExNum) modalExNum.textContent = String(exId).padStart(2, '0');
          if (modalExTitle) modalExTitle.textContent = `Misión ${exId}: ${exTitle}`;

          renderCodeForExercise(exId);
          generateMathChallenge();

          if (mathStep) mathStep.classList.remove('hidden');
          if (codeStep) codeStep.classList.add('hidden');
          if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
          }
        };

        const closeModal = () => {
          if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
          }
        };

        openBtns.forEach((btn) => btn.addEventListener('click', openModal));
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (modal) {
          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
          });
        }

        if (verifyBtn && answerInput) {
          const doVerify = () => {
            const val = parseInt(answerInput.value, 10);
            if (!isNaN(val) && val === currentExpectedAnswer) {
              if (mathStep) mathStep.classList.add('hidden');
              if (codeStep) {
                codeStep.classList.remove('hidden');
                codeStep.classList.add('flex');
              }
            } else {
              if (errorMsg) errorMsg.classList.remove('hidden');
              answerInput.focus();
            }
          };

          verifyBtn.addEventListener('click', doVerify);
          answerInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') doVerify();
          });
        }

        // Selector de lenguaje en el modal
        const langBtns = document.querySelectorAll('#langSelectorGroup .lang-tab-btn');
        langBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const lang = btn.getAttribute('data-lang');
            langBtns.forEach((b) => {
              b.classList.remove('active', 'bg-[#1E1210]', 'text-white');
              b.classList.add('bg-white', 'text-[#1E1210]');
            });
            btn.classList.add('active', 'bg-[#1E1210]', 'text-white');
            btn.classList.remove('bg-white', 'text-[#1E1210]');

            document.querySelectorAll('#codeBlocksContainer .code-panel').forEach((p) => {
              if (p.getAttribute('data-lang-panel') === lang) {
                p.classList.remove('hidden');
              } else {
                p.classList.add('hidden');
              }
            });
          });
        });
      })();
    })();
  </script>

