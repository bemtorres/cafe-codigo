---
import Layout from '../../layouts/Layout.astro';
import CoursesCatalog from '../../components/courses/CoursesCatalog';
---

<Layout
  title="Catálogo de Cursos — Café y Código"
  description="Catálogo completo de cursos de programación, desarrollo web, bases de datos e ingeniería de software de Café y Código."
>
  <div class="mx-auto max-w-[1400px] px-4 pb-12 pt-4 sm:px-5">
    <header class="mb-6">
      <p class="m-0 font-nunito text-[0.65rem] font-extrabold uppercase tracking-[0.2em] text-textMuted">Catálogo oficial</p>
      <h1 class="!mt-0.5 font-nunito text-2xl font-black text-textPrimary sm:text-3xl">Catálogo de Cursos</h1>
    </header>
    <CoursesCatalog client:load />
  </div>
</Layout>
