    HabitacionHotel <|-- HabitacionEstandar
    HabitacionHotel <|-- SuitePenthouse
    HabitacionHotel <|-- SuiteTematica
    SanitizableAutomatico <|.. SuiteTematica : implements
    SuitePenthouse *-- ServicioMayordomo : tiene`}
