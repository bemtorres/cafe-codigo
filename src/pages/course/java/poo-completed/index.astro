          <h3>2. Clase Externa: Quirofano.java</h3>
          <CodeBlock
            lang="java"
            code={`public class Quirofano {
    private String codigoSala;
    private boolean esterilizado;

    public Quirofano(String codigoSala, boolean esterilizado) {
        this.codigoSala = codigoSala;
        this.esterilizado = esterilizado;
    }

    public String getCodigoSala() { return codigoSala; }
    public boolean isEsterilizado() { return esterilizado; }
}`}
            title="Quirofano.java"
          />

          <h3>3. Clase Padre Abstracta: AtencionMedica.java</h3>
          <CodeBlock
            lang="java"
            code={`public abstract class AtencionMedica {
    private String idAtencion;
    private String nombrePaciente;
    private double costoBase;

    public AtencionMedica(String idAtencion, String nombrePaciente, double costoBase) {
        this.idAtencion = idAtencion;
        this.nombrePaciente = nombrePaciente;
        this.costoBase = costoBase;
    }

    // Método abstracto que obliga sobrescritura en hijas
    public abstract double calcularCostoTotal();

    public void registrarDiagnostico(String diagnostico) {
        System.out.println("🩺 Diagnóstico de " + nombrePaciente + ": " + diagnostico);
    }

    public String getIdAtencion() { return idAtencion; }
    public String getNombrePaciente() { return nombrePaciente; }
    public double getCostoBase() { return costoBase; }
}`}
            title="AtencionMedica.java"
          />

          <h3>4. Clase Hija 1: ConsultaGeneral.java</h3>
          <CodeBlock
            lang="java"
            code={`public class ConsultaGeneral extends AtencionMedica {
    private boolean esRevisionRutina;

    public ConsultaGeneral(String id, String paciente, double costoBase, boolean esRevisionRutina) {
        super(id, paciente, costoBase);
        this.esRevisionRutina = esRevisionRutina;
    }

    @Override
    public double calcularCostoTotal() {
        // Descuento del 20% si es revisión preventiva de rutina
        return esRevisionRutina ? getCostoBase() * 0.80 : getCostoBase();
    }
}`}
            title="ConsultaGeneral.java"
          />

          <h3>5. Clase Hija 2: CirugiaUrgencia.java (Con Clase Externa Quirofano)</h3>
          <CodeBlock
            lang="java"
            code={`public class CirugiaUrgencia extends AtencionMedica {
    private double horasDuracion;
    private Quirofano quirofanoAsignado;

    public CirugiaUrgencia(String id, String paciente, double costoBase, double horas, Quirofano q) {
        super(id, paciente, costoBase);
        this.horasDuracion = horas;
        this.quirofanoAsignado = q;
    }

    @Override
    public double calcularCostoTotal() {
        // Recargo de $150 por cada hora de Quirófano
        return getCostoBase() + (horasDuracion * 150.0);
    }

    public Quirofano getQuirofanoAsignado() { return quirofanoAsignado; }
}`}
            title="CirugiaUrgencia.java"
          />

          <h3>6. Clase Hija 3: Telemedicina.java (Implementa Interfaz)</h3>
          <CodeBlock
            lang="java"
            code={`public class Telemedicina extends AtencionMedica implements FacturableDigital {
    private String plataformaVideo;

    public Telemedicina(String id, String paciente, double costoBase, String plataformaVideo) {
        super(id, paciente, costoBase);
        this.plataformaVideo = plataformaVideo;
    }

    @Override
    public double calcularCostoTotal() {
        // Tarifa fija de servidor +$10
        return getCostoBase() + 10.0;
    }

    @Override
    public String generarFacturaXML() {
        return "<factura id='" + getIdAtencion() + "'><paciente>" + getNombrePaciente() + "</paciente><monto>" + calcularCostoTotal() + "</monto></factura>";
    }

    @Override
    public void enviarPorCorreo(String emailDestino) {
        System.out.println("📧 Factura enviada a " + emailDestino + " vía plataforma " + plataformaVideo);
    }
}`}
            title="Telemedicina.java"
          />

          <h3>7. Clase Principal: Main.java</h3>
          <CodeBlock
            lang="java"
            code={`public class Main {
    public static void main(String[] args) {
        Quirofano q1 = new Quirofano("SALA-A1", true);

        AtencionMedica[] fichaMedica = {
            new ConsultaGeneral("CG-101", "Carlos Mendoza", 50.0, true),
            new CirugiaUrgencia("CU-202", "Ana Beltrán", 800.0, 3.5, q1),
            new Telemedicina("TM-303", "Roberto Gómez", 40.0, "Zoom Medical")
        };

        System.out.println("=== POLIMORFISMO: CÁLCULO DE COSTOS EN HOSPITAL ===");
        for (AtencionMedica atencion : fichaMedica) {
            System.out.println("Paciente: " + atencion.getNombrePaciente() + " | Total a pagar: $" + atencion.calcularCostoTotal());
        }

        System.out.println("\\n=== INTERFAZ DE FACTURACIÓN DIGITAL ===");
        Telemedicina consultaOnline = (Telemedicina) fichaMedica[2];
        System.out.println("XML: " + consultaOnline.generarFacturaXML());
        consultaOnline.enviarPorCorreo("roberto@email.com");
    }
}`}
            title="Main.java"
          />
        </div>
    </section>

