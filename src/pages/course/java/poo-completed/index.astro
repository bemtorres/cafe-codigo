<script is:inline>
(function() {
  var targetSolId = null;
  var modal = document.getElementById('passwordModal');
  var passForm = document.getElementById('passForm');
  var passInput = document.getElementById('passInput');
  var passErrorMsg = document.getElementById('passErrorMsg');
  var backdrop = document.getElementById('closePassModalBackdrop');
  var btnCancel = document.getElementById('btnCancelPass');

  function getExpectedKey() {
    var now = new Date();
    var dd = String(now.getDate()).padStart(2, '0');
    var mm = String(now.getMonth() + 1).padStart(2, '0');
    var yyyy = now.getFullYear();
    return dd + mm + yyyy; // Ej: 26082026
  }

  function openModal(solId) {
    targetSolId = solId;
    passInput.value = '';
    passErrorMsg.style.display = 'none';
    modal.setAttribute('aria-hidden', 'false');
    modal.style.display = 'flex';
    setTimeout(function() { passInput.focus(); }, 100);
  }

  function closeModal() {
    modal.setAttribute('aria-hidden', 'true');
    modal.style.display = 'none';
    targetSolId = null;
  }

  document.querySelectorAll('.open-solution-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var solId = btn.getAttribute('data-target-solution');
      var targetDiv = document.getElementById(solId);
      if (targetDiv && targetDiv.style.display !== 'none') {
        // Si ya está visible, se vuelve a ocultar
        targetDiv.style.display = 'none';
        btn.textContent = '🔒 Ingresa la clave para ver los resultados';
        return;
      }
      openModal(solId);
    });
  });

  if (backdrop) backdrop.addEventListener('click', closeModal);
  if (btnCancel) btnCancel.addEventListener('click', closeModal);

  if (passForm) {
    passForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var enteredKey = passInput.value.trim();
      var expectedKey = getExpectedKey();

      if (enteredKey === expectedKey) {
        if (targetSolId) {
          var targetDiv = document.getElementById(targetSolId);
          if (targetDiv) {
            targetDiv.style.display = 'block';
            var triggerBtn = document.querySelector('[data-target-solution="' + targetSolId + '"]');
            if (triggerBtn) {
              triggerBtn.textContent = '🔓 Ocultar Resultados';
            }
          }
        }
        closeModal();
      } else {
        passErrorMsg.style.display = 'block';
        passInput.select();
      }
    });
  }
})();
</script>

