          <h3>5. Clase Hija 2: SuitePenthouse.java (Con Clase Externa ServicioMayordomo)</h3>
          <CodeBlock
            lang="java"
            code={`public class SuitePenthouse extends HabitacionHotel {
    private boolean incluyeJacuzzi;
    private ServicioMayordomo mayordomoAsignado;

    public SuitePenthouse(int numero, double precioBase, boolean jacuzzi, ServicioMayordomo m) {
        super(numero, precioBase);
        this.incluyeJacuzzi = jacuzzi;
        this.mayordomoAsignado = m;
    }

    @Override
    public double calcularCostoEstadia(int noches) {
        // Recargo del 35% de tasa de lujo + tarifa fija de mayordomo ($100/noche)
        double base = getPrecioNocheBase() * noches * 1.35;
        return base + (noches * 100.0);
    }

    public ServicioMayordomo getMayordomoAsignado() { return mayordomoAsignado; }
}`}
