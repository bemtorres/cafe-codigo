  <script is:inline>
    (function() {
      const tabs = document.querySelectorAll('.lang-tab[data-lang]');
      const panels = document.querySelectorAll('.lang-panel[data-panel]');
      const alias = {
        python: 'python', py: 'python',
        java: 'java',
        javascript: 'javascript', js: 'javascript',
        csharp: 'csharp', 'c#': 'csharp', cs: 'csharp', c_sharp: 'csharp',
        php: 'php',
        cpp: 'cpp', 'c++': 'cpp', 'c%2b%2b': 'cpp', cplusplus: 'cpp', 'c_plus_plus': 'cpp'
      };
      const toCode = { python: 'python', java: 'java', javascript: 'javascript', csharp: 'csharp', php: 'php', cpp: 'c++' };
      const normalize = (raw) => {
        if (!raw) return null;
        const k = String(raw).trim().toLowerCase();
        return alias[k] || null;
      };
      const activate = (lang, opts = {}) => {
        const updateUrl = opts.updateUrl !== false;
        tabs.forEach(t => {
          const on = t.getAttribute('data-lang') === lang;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', String(on));
        });
        panels.forEach(p => {
          const on = p.getAttribute('data-panel') === lang;
          p.classList.toggle('is-active', on);
          if (on) p.removeAttribute('hidden'); else p.setAttribute('hidden', '');
        });
        try { localStorage.setItem('eco_var_lang', lang); } catch {}
        if (updateUrl) {
          try {
            const url = new URL(location.href);
            url.searchParams.set('code', toCode[lang] || lang);
            history.replaceState(null, '', url.toString());
          } catch {}
        }
      };
      tabs.forEach(t => t.addEventListener('click', () => activate(t.getAttribute('data-lang'))));

      // Prioridad: ?code= → localStorage → default python
      // Lee ?code= preservando '+' (URLSearchParams decodifica '+' como espacio, rompería c++)
      let raw = null;
      const codeMatch = location.search.match(/[?&]code=([^&#]*)/i);
      if (codeMatch) {
        try { raw = decodeURIComponent(codeMatch[1]); } catch { raw = codeMatch[1]; }
      } else {
        const params = new URLSearchParams(location.search);
        raw = params.get('lang') || params.get('l');
      }
      const fromUrl = normalize(raw);
      if (fromUrl && document.querySelector(`.lang-tab[data-lang="${fromUrl}"]`)) {
        activate(fromUrl, { updateUrl: false });
      } else {
        let saved = null;
        try { saved = localStorage.getItem('eco_var_lang'); } catch {}
        if (saved && document.querySelector(`.lang-tab[data-lang="${saved}"]`)) activate(saved, { updateUrl: false });
      }
    })();
  </script>

