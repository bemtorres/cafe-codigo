const fullCppCode = `#include <iostream>
#include <vector>
#include <string>

using namespace std;

// 1. CREATE
void crear(vector<string>& nombres, vector<float>& notas) {
    string nombre;
    float nota;
    cout << "Ingrese nombre: ";
    cin >> nombre;
    cout << "Ingrese nota: ";
    cin >> nota;
    
    nombres.push_back(nombre); 
    notas.push_back(nota);
    cout << "-> Guardado con exito.\\n";
}

// 2. READ
void leer(vector<string>& nombres, vector<float>& notas) {
    cout << "\\n--- LISTA DE PERSONAS ---\\n";
    for (int i = 0; i < nombres.size(); i++) {
        cout << "[" << i << "] " << nombres[i] << " | Nota: " << notas[i] << "\\n";
    }
}

// 3. UPDATE
void actualizar(vector<float>& notas) {
    int indice;
    cout << "Ingrese el numero (indice) para modificar la nota: ";
    cin >> indice;
    if (indice >= 0 && indice < notas.size()) {
        cout << "Ingrese nueva nota: ";
        cin >> notas[indice];
        cout << "-> Nota actualizada.\\n";
    } else {
        cout << "-> Indice incorrecto.\\n";
    }
}

// 4. DELETE
void eliminar(vector<string>& nombres, vector<float>& notas) {
    int indice;
    cout << "Ingrese el numero (indice) a eliminar: ";
    cin >> indice;
    if (indice >= 0 && indice < nombres.size()) {
        nombres.erase(nombres.begin() + indice);
        notas.erase(notas.begin() + indice);
        cout << "-> Eliminado con exito.\\n";
    } else {
        cout << "-> Indice incorrecto.\\n";
    }
}

// 5. REPORTES
void reportes(vector<string>& nombres, vector<float>& notas) {
    if (nombres.empty()) {
        cout << "-> No hay registros para generar reportes.\\n";
        return; 
    }

    cout << "\\n--- REPORTES ---\\n";
    cout << "- Total registrados: " << nombres.size() << "\\n";
    cout << "- Primer registro: " << nombres.front() << " (Nota: " << notas.front() << ")\\n";
    cout << "- Ultimo registro: " << nombres.back() << " (Nota: " << notas.back() << ")\\n";
    
    // Promedio usando un ciclo for
    float suma = 0;
    for (int i = 0; i < notas.size(); i++) {
        suma += notas[i];
    }
    
    float promedio = suma / notas.size();
    cout << "- Promedio del curso: " << promedio << "\\n";
}

// ==========================================
// MENÚ PRINCIPAL
// ==========================================
int main() {
    vector<string> nombres;
    vector<float> notas;
    int opcion;

    do {
        cout << "\\n--- MENU CRUD ---\\n";
        cout << "1. Agregar persona\\n";
        cout << "2. Ver lista\\n";
        cout << "3. Modificar nota\\n";
        cout << "4. Eliminar persona\\n";
        cout << "5. Ver reportes\\n";
        cout << "6. Salir\\n";
        cout << "Opcion: ";
        cin >> opcion;

        if (opcion == 1) {
            crear(nombres, notas);
        } else if (opcion == 2) {
            leer(nombres, notas);
        } else if (opcion == 3) {
            actualizar(notas);
        } else if (opcion == 4) {
            eliminar(nombres, notas);
        } else if (opcion == 5) {
            reportes(nombres, notas);
        } else if (opcion != 6) {
            cout << "-> Opcion no valida.\\n";
        }

    } while (opcion != 6);

    return 0;
}`;

