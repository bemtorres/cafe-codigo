        >
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-[11px] font-bold text-blue-600 uppercase tracking-wider bg-blue-50 px-2 py-0.5 rounded-md border border-blue-100">
              Pregunta 4 de 5
            </span>
          </div>
          <p class="font-bold text-slate-900 text-sm mb-3">
            4. ¿Por qué la función <code
              >actualizar(vector&lt;float&gt;& notas)</code
            > solo recibe el vector de notas y no el de nombres?
          </p>
          <div class="space-y-2">
            <button
              type="button"
              class="quiz-opt w-full text-left p-3 rounded-xl border border-slate-200 hover:bg-slate-50 text-xs font-medium transition-all cursor-pointer"
              data-correct="true"
            >
              A) Por principio de menor privilegio y modularidad: la función
              solo necesita editar la nota, por lo que no debe tener acceso
              innecesario a los nombres.
            </button>
            <button
              type="button"
              class="quiz-opt w-full text-left p-3 rounded-xl border border-slate-200 hover:bg-slate-50 text-xs font-medium transition-all cursor-pointer"
              data-correct="false"
            >
              B) Porque en C++ las funciones solo pueden recibir un único vector
              como parámetro.
            </button>
            <button
              type="button"
              class="quiz-opt w-full text-left p-3 rounded-xl border border-slate-200 hover:bg-slate-50 text-xs font-medium transition-all cursor-pointer"
              data-correct="false"
            >
              C) Porque modificar strings en funciones por referencia está
              prohibido.
            </button>
          </div>
          <div class="quiz-feedback mt-3 p-3 rounded-xl text-xs hidden"></div>
        </div>

        <!-- Pregunta 5 -->
        <div
          class="quiz-item p-5 rounded-2xl bg-white border-2 border-slate-200 shadow-sm"
          data-q="5"
        >
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="text-[11px] font-bold text-blue-600 uppercase tracking-wider bg-blue-50 px-2 py-0.5 rounded-md border border-blue-100">
              Pregunta 5 de 5
            </span>
          </div>
          <p class="font-bold text-slate-900 text-sm mb-3">
            5. En la condición <code
              >if (indice &gt;= 0 && indice &lt; notas.size())</code
            >, ¿por qué usamos <code>&lt;</code> en vez de <code>&lt;=</code>?
          </p>
          <div class="space-y-2">
            <button
              type="button"
              class="quiz-opt w-full text-left p-3 rounded-xl border border-slate-200 hover:bg-slate-50 text-xs font-medium transition-all cursor-pointer"
              data-correct="false"
            >
              A) Porque el tamaño del vector siempre disminuye en 1
              automáticamente en tiempo de ejecución.
            </button>
            <button
              type="button"
              class="quiz-opt w-full text-left p-3 rounded-xl border border-slate-200 hover:bg-slate-50 text-xs font-medium transition-all cursor-pointer"
              data-correct="true"
            >
              B) Porque los arreglos en C++ son 0-indexados; el último índice
              válido de un vector de N elementos es <code>N - 1</code>.
            </button>
            <button
              type="button"
              class="quiz-opt w-full text-left p-3 rounded-xl border border-slate-200 hover:bg-slate-50 text-xs font-medium transition-all cursor-pointer"
              data-correct="false"
            >
              C) Para reservar la última posición para el carácter nulo <code
                >'\\0'</code
              >.
            </button>
          </div>
          <div class="quiz-feedback mt-3 p-3 rounded-xl text-xs hidden"></div>
        </div>
      </div>

      <!-- Pie Modal -->
      <div
        class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between"
      >
        <span id="modalLiveScore" class="text-xs font-bold text-slate-600">
          Progreso: 0 de 5 respondidas
        </span>
        <button
          type="button"
          id="btnDoneQuizModal"
          class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-black text-xs transition-all shadow cursor-pointer"
        >
          Listo / Cerrar
        </button>
      </div>
    </div>
  </div>

  <!-- JAVASCRIPT DEL SIMULADOR Y CUESTIONARIO -->
  <script is:inline>
    (function () {
      // Estado de memoria del simulador
      let simNombres = [];
      let simNotas = [];

      const terminalEl = document.getElementById("terminalOutput");
      const memTableBody = document.getElementById("memoryTableBody");
      const memCountBadge = document.getElementById("memCountBadge");
      const statFirst = document.getElementById("statFirst");
      const statLast = document.getElementById("statLast");
      const statAvg = document.getElementById("statAvg");
      const inputForm = document.getElementById("simInputForm");
      const inputTitle = document.getElementById("simInputTitle");
      const inputFields = document.getElementById("simInputFields");

      function printTerminal(msg, colorClass = "text-emerald-400") {
        if (!terminalEl) {
          return;
        }
        const line = document.createElement("div");
        line.className = colorClass;
        line.textContent = msg;
        terminalEl.appendChild(line);
        terminalEl.scrollTop = terminalEl.scrollHeight;
      }

      function updateMemoryView() {
        if (!memTableBody) {
          return;
        }
        memTableBody.innerHTML = "";

        if (simNombres.length === 0) {
          memTableBody.innerHTML = `
            <tr class="text-slate-500 italic">
              <td colspan="4" class="py-6 text-center">
                (Vectores vacíos. Utiliza "1. Crear" o "Cargar Demo" para añadir registros).
              </td>
            </tr>
          `;
          if (memCountBadge) {
            memCountBadge.textContent = "Total: 0 elementos";
          }
          if (statFirst) {
            statFirst.textContent = "--";
          }
          if (statLast) {
            statLast.textContent = "--";
          }
          if (statAvg) {
            statAvg.textContent = "--";
          }
          return;
        }

        if (memCountBadge) {
          memCountBadge.textContent = `Total: ${simNombres.length} elemento(s)`;
        }

        simNombres.forEach((nom, i) => {
          const nota = simNotas[i];
          const tr = document.createElement("tr");
          tr.className = "hover:bg-slate-700/50 transition-colors";
          tr.innerHTML = `
            <td class="py-2.5 px-3 font-bold text-amber-400">[ ${i} ]</td>
            <td class="py-2.5 px-3 text-white font-medium">"${nom}"</td>
            <td class="py-2.5 px-3 ${nota >= 4.0 ? "text-emerald-400 font-bold" : "text-red-400 font-bold"}">${nota.toFixed(1)}</td>
            <td class="py-2.5 px-3 text-right text-slate-500 text-[10px]">0x7FFE_${(1000 + i * 16).toString(16).toUpperCase()}</td>
          `;
          memTableBody.appendChild(tr);
        });

        // Actualizar estadísticas
        if (statFirst) {
          statFirst.textContent = `${simNombres[0]} (${simNotas[0].toFixed(1)})`;
        }
        if (statLast) {
          statLast.textContent = `${simNombres[simNombres.length - 1]} (${simNotas[simNotas.length - 1].toFixed(1)})`;
        }

        const sum = simNotas.reduce((acc, curr) => acc + curr, 0);
        const avg = sum / simNotas.length;
        if (statAvg) {
          statAvg.textContent = `${avg.toFixed(2)}`;
        }
      }

      function hideForm() {
        if (inputForm) {
          inputForm.classList.add("hidden");
        }
        if (inputFields) {
          inputFields.innerHTML = "";
        }
      }

      // 1. CREATE
      document
        .getElementById("btnMenuCreate")
        ?.addEventListener("click", () => {
          if (!inputForm || !inputFields) return;
          inputForm.classList.remove("hidden");
          inputTitle.textContent =
            "1. CREATE: Ingrese Nombre y Nota del Estudiante";
          inputFields.innerHTML = `
          <input type="text" id="inNombre" placeholder="Nombre (ej. Lucas)" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-600 text-white text-xs font-mono focus:border-blue-400 outline-none" required />
          <input type="number" id="inNota" step="0.1" min="1.0" max="7.0" placeholder="Nota (ej. 6.2)" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-600 text-white text-xs font-mono focus:border-blue-400 outline-none w-28" required />
          <button type="button" id="btnSubmitCreate" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs font-mono cursor-pointer">Guardar</button>
          <button type="button" id="btnCancelForm" class="px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-300 font-bold text-xs font-mono cursor-pointer">Cancelar</button>
        `;

          document
            .getElementById("btnSubmitCreate")
            ?.addEventListener("click", () => {
              const nom = document.getElementById("inNombre")?.value.trim();
              const notaVal = parseFloat(
                document.getElementById("inNota")?.value,
              );
              if (!nom || isNaN(notaVal)) {
                printTerminal("-> Error: Datos incompletos.", "text-red-400");
                return;
              }
              simNombres.push(nom);
              simNotas.push(notaVal);
              printTerminal(
                `-> Guardado con exito: "${nom}" con nota ${notaVal.toFixed(1)}`,
              );
              hideForm();
              updateMemoryView();
            });

          document
            .getElementById("btnCancelForm")
            ?.addEventListener("click", hideForm);
        });

      // 2. READ
      document.getElementById("btnMenuRead")?.addEventListener("click", () => {
        hideForm();
        printTerminal("\n--- LISTA DE PERSONAS ---", "text-sky-400");
        if (simNombres.length === 0) {
          printTerminal("(No hay personas registradas en la lista)");
          return;
        }
        for (let i = 0; i < simNombres.length; i++) {
          printTerminal(
            `[${i}] ${simNombres[i]} | Nota: ${simNotas[i].toFixed(1)}`,
          );
        }
      });

      // 3. UPDATE
      document
        .getElementById("btnMenuUpdate")
        ?.addEventListener("click", () => {
          if (simNotas.length === 0) {
            printTerminal("-> No hay notas para actualizar.", "text-amber-400");
            return;
          }
          if (!inputForm || !inputFields) return;
          inputForm.classList.remove("hidden");
          inputTitle.textContent =
            "3. UPDATE: Modificar Calificación por Índice";
          inputFields.innerHTML = `
          <input type="number" id="inIdxUpdate" min="0" max="${simNotas.length - 1}" placeholder="Índice (0 a ${simNotas.length - 1})" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-600 text-white text-xs font-mono focus:border-amber-400 outline-none w-32" required />
          <input type="number" id="inNewNota" step="0.1" min="1.0" max="7.0" placeholder="Nueva Nota" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-600 text-white text-xs font-mono focus:border-amber-400 outline-none w-28" required />
          <button type="button" id="btnSubmitUpdate" class="px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs font-mono cursor-pointer">Actualizar</button>
          <button type="button" id="btnCancelUpdate" class="px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-300 font-bold text-xs font-mono cursor-pointer">Cancelar</button>
        `;

          document
            .getElementById("btnSubmitUpdate")
            ?.addEventListener("click", () => {
              const idx = parseInt(
                document.getElementById("inIdxUpdate")?.value,
                10,
              );
              const newNota = parseFloat(
                document.getElementById("inNewNota")?.value,
              );
              if (idx >= 0 && idx < simNotas.length && !isNaN(newNota)) {
                simNotas[idx] = newNota;
                printTerminal(
                  `-> Nota actualizada: ${simNombres[idx]} ahora tiene ${newNota.toFixed(1)}`,
                );
                hideForm();
                updateMemoryView();
              } else {
                printTerminal("-> Indice incorrecto.", "text-red-400");
              }
            });

          document
            .getElementById("btnCancelUpdate")
            ?.addEventListener("click", hideForm);
        });

      // 4. DELETE
      document
        .getElementById("btnMenuDelete")
        ?.addEventListener("click", () => {
          if (simNombres.length === 0) {
            printTerminal("-> No hay personas para eliminar.", "text-red-400");
            return;
          }
          if (!inputForm || !inputFields) return;
          inputForm.classList.remove("hidden");
          inputTitle.textContent = "4. DELETE: Eliminar Estudiante por Índice";
          inputFields.innerHTML = `
          <input type="number" id="inIdxDel" min="0" max="${simNombres.length - 1}" placeholder="Índice (0 a ${simNombres.length - 1})" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-600 text-white text-xs font-mono focus:border-red-400 outline-none w-32" required />
          <button type="button" id="btnSubmitDel" class="px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-500 text-white font-bold text-xs font-mono cursor-pointer">Eliminar</button>
          <button type="button" id="btnCancelDel" class="px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-300 font-bold text-xs font-mono cursor-pointer">Cancelar</button>
        `;

          document
            .getElementById("btnSubmitDel")
            ?.addEventListener("click", () => {
              const idx = parseInt(
                document.getElementById("inIdxDel")?.value,
                10,
              );
              if (idx >= 0 && idx < simNombres.length) {
                const borrado = simNombres[idx];
                simNombres.splice(idx, 1);
                simNotas.splice(idx, 1);
                printTerminal(`-> Eliminado con exito: "${borrado}"`);
                hideForm();
                updateMemoryView();
              } else {
                printTerminal("-> Indice incorrecto.", "text-red-400");
              }
            });

          document
            .getElementById("btnCancelDel")
            ?.addEventListener("click", hideForm);
        });

      // 5. REPORTES
      document
        .getElementById("btnMenuReport")
        ?.addEventListener("click", () => {
          hideForm();
          if (simNombres.length === 0) {
            printTerminal(
              "-> No hay registros para generar reportes.",
              "text-amber-400",
            );
            return;
          }
          printTerminal("\n--- REPORTES ---", "text-indigo-400");
          printTerminal(`- Total registrados: ${simNombres.length}`);
          printTerminal(
            `- Primer registro: ${simNombres[0]} (Nota: ${simNotas[0].toFixed(1)})`,
          );
          printTerminal(
            `- Ultimo registro: ${simNombres[simNombres.length - 1]} (Nota: ${simNotas[simNotas.length - 1].toFixed(1)})`,
          );

          let suma = 0;
          for (let i = 0; i < simNotas.length; i++) {
            suma += simNotas[i];
          }
          const promedio = suma / simNotas.length;
          printTerminal(
            `- Promedio del curso: ${promedio.toFixed(2)}`,
            "text-emerald-400 font-bold",
          );
        });

      // CARGAR DEMO
      document
        .getElementById("btnMenuSample")
        ?.addEventListener("click", () => {
          hideForm();
          simNombres = ["Valentina", "Mateo", "Sofia", "Joaquin"];
          simNotas = [6.8, 4.5, 5.9, 6.2];
          printTerminal(
            "\n-> [Demo cargada] Se agregaron 4 alumnos a la memoria.",
            "text-blue-300",
          );
          updateMemoryView();
        });

      // REINICIAR
      document.getElementById("btnResetSim")?.addEventListener("click", () => {
        hideForm();
        simNombres = [];
        simNotas = [];
        if (terminalEl)
          terminalEl.innerHTML =
            '<div class="text-slate-400">// Memoria reiniciada.</div>';
        updateMemoryView();
      });

      // MODAL CUESTIONARIO
      const quizModal = document.getElementById("quizModal");
      const btnOpenQuiz = document.getElementById("btnOpenQuizModal");
      const btnCloseQuiz = document.getElementById("btnCloseQuizModal");
      const btnDoneQuiz = document.getElementById("btnDoneQuizModal");
      const quizScoreBadge = document.getElementById("quizScoreBadge");
      const modalLiveScore = document.getElementById("modalLiveScore");

      let correctCount = 0;
      let answeredCount = 0;

      function updateQuizSummary() {
        if (modalLiveScore) {
          modalLiveScore.textContent = `Progreso: ${answeredCount} de 5 respondidas · Aciertos: ${correctCount}/5`;
        }
        if (quizScoreBadge) {
          quizScoreBadge.classList.remove("hidden");
          quizScoreBadge.textContent = `Puntaje obtenido: ${correctCount} / 5 aciertos (${Math.round((correctCount / 5) * 100)}%)`;
        }
      }

      btnOpenQuiz?.addEventListener("click", () => {
        quizModal?.classList.remove("hidden");
        quizModal?.classList.add("flex");
      });

      function closeQuiz() {
        quizModal?.classList.add("hidden");
        quizModal?.classList.remove("flex");
      }

      btnCloseQuiz?.addEventListener("click", closeQuiz);
      btnDoneQuiz?.addEventListener("click", closeQuiz);
      quizModal?.addEventListener("click", (e) => {
        if (e.target === quizModal) {
          closeQuiz();
        }
      });

      // EVALUACIÓN / QUIZ INTERACTIVO
      document.querySelectorAll(".quiz-opt").forEach((btn) => {
        btn.addEventListener("click", () => {
          const parentItem = btn.closest(".quiz-item");
          if (!parentItem) {
            return;
          }
          const feedback = parentItem.querySelector(".quiz-feedback");
          const isCorrect = btn.getAttribute("data-correct") === "true";

          answeredCount++;
          if (isCorrect) {
            correctCount++;
          }

          // Reset styles
          parentItem.querySelectorAll(".quiz-opt").forEach((b) => {
            b.classList.remove(
              "bg-emerald-100",
              "border-emerald-500",
              "text-emerald-950",
              "bg-red-100",
              "border-red-500",
              "text-red-950",
            );
            b.disabled = true;
          });

          if (isCorrect) {
            btn.classList.add(
              "bg-emerald-100",
              "border-emerald-500",
              "text-emerald-950",
            );
            if (feedback) {
              feedback.classList.remove(
                "hidden",
                "bg-red-50",
                "text-red-900",
                "border-red-200",
              );
              feedback.classList.add(
                "bg-emerald-50",
                "text-emerald-900",
                "border",
                "border-emerald-200",
              );
              feedback.innerHTML =
                "✅ <strong>¡Correcto!</strong> Has comprendido perfectamente la lógica técnica de C++.";
            }
          } else {
            btn.classList.add("bg-red-100", "border-red-500", "text-red-950");
            const correctBtn = parentItem.querySelector(
              '[data-correct="true"]',
            );
            if (correctBtn) {
              correctBtn.classList.add("bg-emerald-50", "border-emerald-400");
            }
            if (feedback) {
              feedback.classList.remove(
                "hidden",
                "bg-emerald-50",
                "text-emerald-900",
                "border-emerald-200",
              );
              feedback.classList.add(
                "bg-red-50",
                "text-red-900",
                "border",
                "border-red-200",
              );
              feedback.innerHTML =
                "❌ <strong>Incorrecto.</strong> Revisa la explicación del paso correspondiente en la sección superior.";
            }
          }

          updateQuizSummary();
        });
      });

      updateMemoryView();
    })();
  </script>
</Layout>
