          </p>
          <div
            class="p-3 bg-red-50 border border-red-200 rounded-xl text-xs font-mono text-red-950"
          >
            <code>nombres.erase(nombres.begin() + indice);</code><br />
            <code>notas.erase(notas.begin() + indice);</code>
          </div>
        </div>

        <!-- 5. REPORTES -->
        <div
          class="p-6 rounded-2xl bg-white border-2 border-slate-200 shadow-sm"
        >
          <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
            <span
              class="px-2.5 py-1 rounded-lg bg-indigo-100 text-indigo-900 font-mono text-xs font-black"
            >
              Paso 5 · REPORTES Y ESTADÍSTICAS
            </span>
            <code
              class="text-xs font-mono bg-slate-100 px-2 py-1 rounded text-slate-700"
              >void reportes(vector&lt;string&gt;& nombres, vector&lt;float&gt;&
