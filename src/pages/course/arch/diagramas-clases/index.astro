    <!-- 7. Herencia — extends -->
    <section class="mb-10 arch-section">
      <h2>7. Herencia — class Libro extends Publicacion</h2>
      <p>
        La herencia permite <strong>reutilizar código</strong>: la subclase
        hereda atributos y métodos del padre y puede añadir los suyos o
        reescribirlos.
      </p>
      <p>
        En UML: <strong>triángulo vacío</strong> (▽) apunta del hijo al padre. Relación
        <strong>"es-un"</strong>: <code>Libro es una Publicacion</code>.
      </p>

      <MermaidDiagram
        title="Jerarquía de Herencia — Publicación"
        code={`classDiagram
    class Publicacion {
        -String titulo
        -String isbn
        +String getTitulo()
        +String descripcion()
    }
    class Libro {
        -int paginas
        +int getPaginas()
        +String descripcion()
    }
    class Revista {
        -int numero
        -String frecuencia
        +int getNumero()
        +String descripcion()
    }
    class EBook {
        -double tamanoMb
        +double getTamanoMb()
        +String descripcion()
    }
    Publicacion <|-- Libro
    Publicacion <|-- Revista
    Publicacion <|-- EBook`}
      />

      <CodeBlockMulti
        title="Herencia"
        tabs={[
          {
            label: "☕ Java",
            lang: "java",
            code: `public class Publicacion {
    protected String titulo;
    protected String isbn;
    public Publicacion(String titulo, String isbn) {
        this.titulo = titulo;
        this.isbn = isbn;
    }
    public String getTitulo() { return titulo; }
    public String descripcion() { return "Publicación: " + titulo; }
}

public class Libro extends Publicacion {
    private int paginas;
    public Libro(String titulo, String isbn, int paginas) {
        super(titulo, isbn);
        this.paginas = paginas;
    }
    public int getPaginas() { return paginas; }
    @Override
    public String descripcion() {
        return "Libro: " + titulo + " (" + paginas + " pág.)";
    }
}

public class Revista extends Publicacion {
    private int numero;
    private String frecuencia;
    public Revista(String titulo, String isbn, int numero, String frecuencia) {
        super(titulo, isbn);
        this.numero = numero;
        this.frecuencia = frecuencia;
    }
    public int getNumero() { return numero; }
    @Override
    public String descripcion() {
        return "Revista #" + numero + " (" + frecuencia + ")";
    }
}`,
          },
          {
            label: "🐍 Python",
            lang: "python",
            code: `class Publicacion:
    def __init__(self, titulo, isbn):
        self.titulo = titulo
        self.isbn = isbn
    def descripcion(self):
        return f"Publicación: {self.titulo}"

class Libro(Publicacion):           # hereda de Publicacion
    def __init__(self, titulo, isbn, paginas):
        super().__init__(titulo, isbn)  # llama al padre
        self.paginas = paginas
    def descripcion(self):           # override
        return f"Libro: {self.titulo} ({self.paginas} pág.)"

class Revista(Publicacion):
    def __init__(self, titulo, isbn, numero, frecuencia):
        super().__init__(titulo, isbn)
        self.numero = numero
        self.frecuencia = frecuencia
    def descripcion(self):           # override
        return f"Revista #{self.numero} ({self.frecuencia})"

class EBook(Publicacion):
    def __init__(self, titulo, isbn, tamano_mb):
        super().__init__(titulo, isbn)
        self.tamano_mb = tamano_mb
    def descripcion(self):           # override
        return f"EBook: {self.titulo} ({self.tamano_mb} MB)"`,
