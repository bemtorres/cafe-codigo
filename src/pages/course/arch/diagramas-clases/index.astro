        this.isbn = isbn;
    }
    public string Titulo => titulo;
    public virtual string Descripcion() => $"Publicación: {titulo}";
}

public class Libro : Publicacion {
    private int paginas;
    public Libro(string t, string isbn, int p) : base(t, isbn) => paginas = p;
    public int Paginas => paginas;
    public override string Descripcion() => $"Libro: {titulo} ({paginas} pág.)";
}

public class Revista : Publicacion {
    private int numero;
