    <!-- 8. Interfaces — implements -->
    <section class="mb-10 arch-section">
      <h2>8. Interfaces — implements Imprimible</h2>
      <p>
        Una interfaz es un <strong>contrato</strong>: define qué métodos debe
        tener una clase pero no cómo se implementan. Una clase puede implementar <strong
          >múltiples interfaces</strong
        > (a diferencia de heredar de un solo padre).
      </p>
      <p>
        En UML: se escribe <code>&lt;&lt;interface&gt;&gt;</code> en la cabecera y
        la flecha es <strong>línea punteada con triángulo</strong> (▽LineStyle::dashed).
      </p>

      <MermaidDiagram
        title="Interfaces y Contratos"
        code={`classDiagram
    class Imprimible {
        <<interface>>
        +String imprimir()
    }
    class Libro {
        -String titulo
        +String imprimir()
    }
    class Revista {
        -int numero
        +String imprimir()
    }
    class Recibo {
        -double monto
        +String imprimir()
    }
    Imprimible <|.. Libro : implements
    Imprimible <|.. Revista : implements
    Imprimible <|.. Recibo : implements`}
      />

      <CodeBlockMulti
        title="Interfaces"
        tabs={[
          {
            label: "☕ Java",
            lang: "java",
            code: `public interface Imprimible {
    String imprimir();  // todas las clases que implementen DEBEN tener imprimir()
}

public class Libro implements Imprimible {
    private String titulo;
    public Libro(String titulo) { this.titulo = titulo; }
    @Override
    public String imprimir() { return "Libro: " + titulo; }
}

public class Revista implements Imprimible {
    private int numero;
    public Revista(int numero) { this.numero = numero; }
    @Override
    public String imprimir() { return "Revista #" + numero; }
}

public class Recibo implements Imprimible {
    private double monto;
    public Recibo(double monto) { this.monto = monto; }
    @Override
    public String imprimir() { return "Recibo: $" + monto; }
}

// Polimorfismo
Imprimible[] docs = { new Libro("Rayuela"), new Revista(42), new Recibo(2500) };
for (Imprimible d : docs) {
    System.out.println(d.imprimir());
}`,
          },
          {
            label: "🐍 Python",
            lang: "python",
            code: `from abc import ABC, abstractmethod

class Imprimible(ABC):              # clase abstracta = interfaz
    @abstractmethod
    def imprimir(self) -> str:
        pass

class Libro(Imprimible):
    def __init__(self, titulo):
        self.titulo = titulo
    def imprimir(self) -> str:      # implementa el contrato
        return f"Libro: {self.titulo}"

class Revista(Imprimible):
    def __init__(self, numero):
        self.numero = numero
    def imprimir(self) -> str:
        return f"Revista #{self.numero}"

class Recibo(Imprimible):
    def __init__(self, monto):
        self.monto = monto
    def imprimir(self) -> str:
        return "Recibo: $" + str(self.monto)

# Polimorfismo: todas se tratan como Imprimible
docs = [Libro("Rayuela"), Revista(42), Recibo(2500)]
for d in docs:
    print(d.imprimir())`,
          },
          {
            label: "🎮 C#",
            lang: "csharp",
            code: `public interface Imprimible {
    string Imprimir();  // contrato
}

public class Libro : Imprimible {
    private string titulo;
    public Libro(string titulo) => this.titulo = titulo;
    public string Imprimir() => $"Libro: {titulo}";
}

public class Revista : Imprimible {
    private int numero;
    public Revista(int numero) => this.numero = numero;
    public string Imprimir() => $"Revista #{numero}";
}

public class Recibo : Imprimible {
    private double monto;
    public Recibo(double monto) => this.monto = monto;
    public string Imprimir() => "Recibo: $" + monto;
}

// Polimorfismo
Imprimible[] docs = { new Libro("Rayuela"), new Revista(42), new Recibo(2500) };
foreach (var d in docs) Console.WriteLine(d.Imprimir());`,
          },
          {
            label: "⚙️ C++",
            lang: "cpp",
            code: `class Imprimible {                // interfaz = clase con solo métodos virtuales puros
public:
    virtual std::string imprimir() const = 0;  // = 0 → pura
    virtual ~Imprimible() = default;
};

class Libro : public Imprimible {
    std::string titulo;
public:
    Libro(std::string t) : titulo(t) {}
    std::string imprimir() const override {
        return "Libro: " + titulo;
    }
};

class Revista : public Imprimible {
    int numero;
public:
    Revista(int n) : numero(n) {}
    std::string imprimir() const override {
        return "Revista #" + std::to_string(numero);
    }
};

class Recibo : public Imprimible {
    double monto;
public:
    Recibo(double m) : monto(m) {}
    std::string imprimir() const override {
        return "Recibo: $" + std::to_string(monto);
    }
};

// Polimorfismo
#include <vector>
#include <memory>
std::vector<std::unique_ptr<Imprimible>> docs;
docs.push_back(std::make_unique<Libro>("Rayuela"));
docs.push_back(std::make_unique<Revista>(42));
docs.push_back(std::make_unique<Recibo>(2500));
for (const auto& d : docs) {
    std::cout << d->imprimir() << std::endl;
}`,
          },
        ]}
      />

      <div
        class="note-box"
        style="background:#F5F0FF; border-left:5px solid #6d28d9;"
      >
        <strong>Herencia vs Interface:</strong> Herencia = <strong
          >"es-un"</strong
        > (un tipo). Interface = <strong>"puede-hacer"</strong> (un comportamiento).
        Java/C# permiten heredar de <strong>un solo padre</strong> pero implementar
        <strong>múltiples interfaces</strong>. Ej: <code
          >class Libro extends Publicacion implements Imprimible, Serializable</code
        >.
      </div>
