---
import Layout from '../../../layouts/Layout.astro';
import { courses } from '../../../data/courses';

const pythonCourse = courses.find((c) => c.slug === 'python');
if (!pythonCourse) {
  throw new Error("No se encontró el curso 'python' en el archivo de datos.");
}
---

<Layout title="Curso de Python Pro: De Novato a Data Scientist" description="Aprende el lenguaje más versátil del mundo: automatización, ciencia de datos, IA y desarrollo web simplificado." courseSlug="python">
  <div class="max-w-[1050px] mx-auto px-5 py-10">
    <header class="text-center mb-12">
      <h1 class="text-4xl sm:text-5xl font-black text-[#3776ab] mb-4 font-nunito drop-shadow-[3px_3px_0px_rgba(15,23,42,0.1)]">
        <span class="inline-block mr-2">🐍</span> 
        {pythonCourse.name}
      </h1>
      <p class="text-base sm:text-lg text-slate-600 max-w-[650px] mx-auto font-bold leading-relaxed">
        {pythonCourse.description}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pythonCourse.lessons?.map((lesson, index) => (
        <div class="flex gap-4 bg-white border-[3.5px] border-slate-900 rounded-2xl p-5 shadow-[6px_6px_0px_#0f172a] hover:-translate-y-1 hover:shadow-[10px_10px_0px_#0f172a] transition-all duration-200 relative">
          <div class="text-[2.2rem] font-black text-slate-300 font-mono leading-none shrink-0 opacity-40 select-none">
            {(index + 1).toString().padStart(2, '0')}
          </div>
          <div class="flex-1 min-w-0 flex flex-col justify-between">
            <h3 class="text-[1.1rem] font-black text-slate-900 mb-3 leading-snug">
              {lesson.title}
            </h3>
            <div class="flex items-center gap-3 mt-auto pt-2 flex-wrap">
              <a
                href={lesson.href}
                class="inline-flex items-center text-sm font-black text-[#3776ab] hover:underline font-mono"
              >
                Leer lección →
              </a>
              <a
                href={`/course-slides/python/${lesson.slug}/`}
                class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-black bg-slate-900 text-amber-400 border-2 border-slate-900 rounded-lg shadow-[2px_2px_0px_#ffd43b] hover:-translate-y-0.5 hover:shadow-[3px_3px_0px_#ffd43b] hover:bg-[#3776ab] hover:text-white hover:border-[#3776ab] transition-all font-mono"
                title={`Ver presentación en diapositivas 📊 de: ${lesson.title}`}
              >
                <span>Slides</span>
                <span>📊</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
