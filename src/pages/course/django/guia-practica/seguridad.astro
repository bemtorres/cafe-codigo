        href="/course/django/guia-practica/proyecto/"
        class="p-3.5 rounded-2xl bg-white text-slate-800 border-2 border-slate-300 hover:border-[#a7091b] font-black text-sm no-underline transition-colors flex items-center justify-between shadow-sm"
      >
        <span>7.3 Parte 3 · Desafío Final</span>
        <span class="text-[#a7091b]">→</span>
      </a>
