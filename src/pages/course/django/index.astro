---
import Layout from '../../../layouts/Layout.astro';
import { courses } from '../../../data/courses';

const djangoCourse = courses.find((c) => c.slug === 'django');
if (!djangoCourse) {
  throw new Error("No se encontró el curso 'django' en el archivo de datos.");
}
---

<Layout title="Curso de Django: Backend Web con Python" description="Aprende a construir APIs, CRUD y aplicaciones seguras con Django y Django REST Framework." courseSlug="django">
  <div class="max-w-[1050px] mx-auto px-5 py-10">
    <header class="text-center mb-12">
      <h1 class="text-4xl sm:text-5xl font-black text-[#0c4a3f] mb-4 font-nunito drop-shadow-[3px_3px_0px_rgba(15,23,42,0.1)]">
        <span class="inline-block mr-2">🌿</span>
        {djangoCourse.name}
      </h1>
      <p class="text-base sm:text-lg text-slate-600 max-w-[700px] mx-auto font-bold leading-relaxed">
        {djangoCourse.description}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {djangoCourse.lessons?.map((lesson, index) => (
        <article class="rounded-3xl border-[3px] border-slate-900 bg-white p-6 shadow-[8px_8px_0px_#0f172a] transition-transform duration-200 hover:-translate-y-1">
          <div class="text-[2rem] font-black text-slate-300 leading-none opacity-40 select-none mb-4">
            {(index + 1).toString().padStart(2, '0')}
          </div>
          <h2 class="text-xl font-black text-slate-900 mb-3">{lesson.title}</h2>
          <a href={lesson.href} class="inline-flex items-center text-sm font-black text-[#0c4a3f] hover:underline font-mono">
            Leer lección →
          </a>
        </article>
      ))}
    </div>
  </div>
</Layout>
