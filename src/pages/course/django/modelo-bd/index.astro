      <h3>Paso 3: Análisis del SQL Real Emitido por Django</h3>
      <CodeBlock
        lang="sql"
        code={`-- 1. Tabla de Categorías
CREATE TABLE "blog_categoria" (
    "id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,
    "nombre" varchar(50) NOT NULL UNIQUE
);

-- 2. Tabla de Artículos
CREATE TABLE "blog_articulo" (
    "id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,
    "titulo" varchar(200) NOT NULL,
    "slug" varchar(220) NOT NULL UNIQUE,
    "contenido" text NOT NULL,
    "visitas" integer NOT NULL CHECK ("visitas" >= 0),
    "destacado" boolean NOT NULL,
    "estado" varchar(15) NOT NULL,
    "created_at" timestamp with time zone NOT NULL,
    "updated_at" timestamp with time zone NOT NULL,
    "categoria_id" bigint NOT NULL REFERENCES "blog_categoria" ("id") DEFERRABLE INITIALLY DEFERRED
);

-- 3. Índices B-Tree automáticos para acelerar búsquedas
CREATE INDEX "blog_articulo_titulo_idx" ON "blog_articulo" ("titulo");
CREATE INDEX "blog_articulo_categoria_id_idx" ON "blog_articulo" ("categoria_id");`}
        title="SQL Generado por PostgreSQL / SQLite"
