    <section class="mb-10">
      <h2>4. Seeder con Faker: Generación Masiva de Datos</h2>
      <p>
        Probar consultas avanzadas de ORM con solo 2 o 3 registros es imposible. La mejor práctica en Django es crear un <strong>Management Command</strong> que utilice la librería <code>faker</code>:
      </p>

      <CodeBlock
        lang="python"
        code={`# biblioteca/management/commands/seed_biblioteca.py
import random
from datetime import timedelta
from django.core.management.base import BaseCommand
from django.contrib.auth.models import User
from django.db import transaction
from django.utils import timezone
from faker import Faker

from biblioteca.models import (
    PerfilLector, Autor, Categoria, Tag, Libro, SolicitudPrestamo
)

class Command(BaseCommand):
    help = "Puebla la biblioteca con datos realistas usando Faker"

    @transaction.atomic
    def handle(self, *args, **options):
        fake = Faker(['es_ES'])
        self.stdout.write("Generando datos de prueba...")

        # 1. Categorías con jerarquía
        padre_tec, _ = Categoria.objects.get_or_create(nombre="Tecnología")
        cat_python, _ = Categoria.objects.get_or_create(nombre="Python", parent=padre_tec)
        cat_db, _ = Categoria.objects.get_or_create(nombre="Bases de Datos", parent=padre_tec)
        
        # 2. Tags
        tags = [Tag.objects.get_or_create(nombre=n)[0] for n in ["Backend", "Principiantes", "Avanzado", "Destacado"]]

        # 3. Autores
        autores = []
        for _ in range(8):
            autores.append(Autor.objects.create(
                nombre=fake.first_name(),
                apellidos=fake.last_name(),
                biografia=fake.paragraph(),
                email=fake.unique.email()
            ))

        # 4. Socios y usuarios
        for i in range(10):
            user = User.objects.create_user(username=f"lector_{i}", password="password123")
            PerfilLector.objects.create(
                user=user,
                telefono=fake.phone_number(),
                limite_prestamos_simultaneos=3
            )

        # 5. Libros
        for _ in range(40):
            stock = random.randint(2, 8)
            libro = Libro.objects.create(
                titulo=fake.catch_phrase().title(),
                isbn=fake.unique.isbn13(),
                sinopsis=fake.text(max_nb_chars=300),
                paginas=random.randint(120, 800),
                stock_total=stock,
                stock_disponible=random.randint(0, stock),
                precio_reposicion=round(random.uniform(20.0, 75.0), 2),
                fecha_publicacion=fake.date_between(start_date='-5y', end_date='today'),
                autor=random.choice(autores),
                categoria=random.choice([cat_python, cat_db]),
                metadatos={"editorial": fake.company(), "edicion": random.randint(1, 3)}
            )
            libro.tags.set(random.sample(tags, k=random.randint(1, 2)))

        self.stdout.write(self.style.SUCCESS("✔ 40 libros, autores y lectores creados con éxito!"))`}
        title="seed_biblioteca.py"
      />

