        <article class="p-5 rounded-2xl border-2 border-slate-800 bg-slate-50">
          <h3 class="text-base font-black text-slate-900 mb-2">
            Ejercicio 3.2: Acción Personalizada en Django Admin con Mensajes
          </h3>
          <p class="text-sm text-slate-600 mb-3">
            Escribe una acción en <code>SolicitudPrestamoAdmin</code> que permita seleccionar múltiples solicitudes atrasadas y condonar sus multas acumuladas poniéndolas en $0.00.
          </p>
          <details class="cursor-pointer bg-white p-3 rounded-xl border border-slate-300">
            <summary class="font-bold text-xs text-[#0c4a3f] font-mono">Ver Solución Explicada</summary>
            <div class="mt-3 text-xs">
              <CodeBlock
                lang="python"
                code={`@admin.action(description="Condonar multas acumuladas a los préstamos seleccionados")
def condonar_multas(modeladmin, request, queryset):
    afectados = queryset.filter(multa_acumulada__gt=0).update(multa_acumulada=0.00)
    modeladmin.message_user(
        request,
        f"Se han condonado las multas de {afectados} préstamo(s) con éxito.",
        messages.SUCCESS
    )

@admin.register(SolicitudPrestamo)
class SolicitudPrestamoAdmin(admin.ModelAdmin):
    list_display = ['id', 'usuario', 'libro', 'estado', 'multa_acumulada']
    actions = [condonar_multas]`}
