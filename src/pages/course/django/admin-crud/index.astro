            <div class="mt-3 text-xs">
              <CodeBlock
                lang="python"
                code={`# catalogo/views.py
from django.shortcuts import get_object_or_404, redirect, render
from django.contrib import messages
from .models import Producto

def desactivar_producto_view(request, pk):
    producto = get_object_or_404(Producto, pk=pk)
    
    if request.method == 'POST':
        # Soft delete: se desactiva sin borrarlo de la base de datos
        producto.disponible = False
        producto.save(update_fields=['disponible'])
        messages.warning(request, f"El producto '{producto.nombre}' ha sido desactivado del catálogo.")
        return redirect('catalogo:lista')
        
    return render(request, 'catalogo/producto_confirm_deactivate.html', {'producto': producto})`}
                title="soft_delete_view.py"
