          <h3 class="text-base font-black text-slate-900 mb-2">
            Ejercicio 3.1: Formulario con Validación de Préstamos
          </h3>
          <p class="text-sm text-slate-600 mb-3">
            Crea un <code>ModelForm</code> para <code>SolicitudPrestamo</code> que impida fijar una fecha de devolución superior a 30 días en el futuro.
          </p>
          <details class="cursor-pointer bg-white p-3 rounded-xl border border-slate-300">
            <summary class="font-bold text-xs text-[#0c4a3f] font-mono">Ver Solución Explicada</summary>
            <div class="mt-3 text-xs">
              <CodeBlock
                lang="python"
                code={`from django import forms
from django.utils import timezone
from datetime import timedelta
from .models import SolicitudPrestamo

class SolicitudPrestamoForm(forms.ModelForm):
    class Meta:
        model = SolicitudPrestamo
        fields = ['libro', 'fecha_devolucion_limite', 'observaciones']

    def clean_fecha_devolucion_limite(self):
        fecha_limite = self.cleaned_data.get('fecha_devolucion_limite')
        hoy = timezone.now().date()
        maximo_permitido = hoy + timedelta(days=30)

        if fecha_limite < hoy:
            raise forms.ValidationError("La fecha de devolución no puede ser una fecha pasada.")
        if fecha_limite > maximo_permitido:
            raise forms.ValidationError("El período máximo de préstamo de la biblioteca es de 30 días.")
        return fecha_limite`}
                title="solucion_prestamo_form.py"
              />
            </div>
          </details>
