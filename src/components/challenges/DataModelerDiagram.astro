<script>
  // Control de Zoom interactivo en el canvas de Data Modeler
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.dm-btn-zoom').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-zoom-target');
        if (!targetId) return;
        const stage = document.getElementById(targetId);
        if (!stage) return;

        let currentScale = parseFloat(stage.getAttribute('data-scale') || '1');

        if (btn.classList.contains('dm-zoom-in')) {
          currentScale = Math.min(currentScale + 0.15, 1.6);
        } else if (btn.classList.contains('dm-zoom-out')) {
          currentScale = Math.max(currentScale - 0.15, 0.65);
        } else if (btn.classList.contains('dm-zoom-reset')) {
          currentScale = 1;
        }

        stage.setAttribute('data-scale', currentScale.toString());
        stage.style.transform = `scale(${currentScale})`;
      });
    });
  });
</script>
