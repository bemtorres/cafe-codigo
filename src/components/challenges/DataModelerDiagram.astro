---
import type { DbTable } from '../../data/databaseChallenges';

interface Props {
  tables: DbTable[];
  title?: string;
  challengeId?: string | number;
}

const { tables, title, challengeId = '1' } = Astro.props;

// Extraer relaciones automáticamente analizando los campos con fk
interface Relation {
  fromTable: string;
  fromField: string;
  toTable: string;
  toField: string;
  type: '1:1' | '1:N' | 'N:M';
}

const relations: Relation[] = [];

tables.forEach((tbl) => {
  tbl.fields.forEach((fld) => {
    if (fld.fk) {
      const parts = fld.fk.split('.');
      const targetTable = parts[0];
      const targetField = parts[1] || 'id';
      const isUnique = fld.unique;
      const isCompositePk = fld.pk && tbl.fields.filter(f => f.pk).length > 1;

      relations.push({
        fromTable: tbl.name,
        fromField: fld.name,
        toTable: targetTable,
        toField: targetField,
        type: isUnique ? '1:1' : isCompositePk ? 'N:M' : '1:N',
      });
    }
  });
});
---

<div class="datamodeler-window" id={`dm-win-${challengeId}`}>
  <!-- BARRA DE TÍTULO Y PESTAÑA ESTILO ORACLE DATA MODELER -->
  <div class="dm-topbar">
    <div class="dm-tab-bar">
      <div class="dm-tab is-active">
        <span class="dm-tab-icon">📊</span>
        <span class="dm-tab-name">Relational_1 ({title || 'Modelo Relacional'})</span>
        <span class="dm-tab-close">×</span>
      </div>
      <div class="dm-tab dm-tab-secondary">
        <span class="dm-tab-icon">📐</span>
        <span class="dm-tab-name">Logical (Entidad-Relación)</span>
      </div>
    </div>

    <div class="dm-toolbar">
      <div class="dm-tool-group">
        <span class="dm-badge-info">🎯 Modo 3FN Relacional</span>
        <span class="dm-badge-count">{tables.length} {tables.length === 1 ? 'Tabla' : 'Tablas'}</span>
        {relations.length > 0 && (
          <span class="dm-badge-rel">{relations.length} {relations.length === 1 ? 'Relación' : 'Relaciones'} (FK)</span>
        )}
      </div>
      <div class="dm-zoom-controls">
        <button type="button" class="dm-btn-zoom dm-zoom-in" title="Aumentar zoom" data-zoom-target={`dm-stage-${challengeId}`}>🔍 +</button>
        <button type="button" class="dm-btn-zoom dm-zoom-out" title="Disminuir zoom" data-zoom-target={`dm-stage-${challengeId}`}>🔍 −</button>
        <button type="button" class="dm-btn-zoom dm-zoom-reset" title="Restablecer" data-zoom-target={`dm-stage-${challengeId}`}>⟲</button>
      </div>
    </div>
  </div>

  <!-- CANVAS / ÁREA DE DIBUJO CON CUADRÍCULA -->
  <div class="dm-canvas-viewport">
    <div class="dm-canvas-stage" id={`dm-stage-${challengeId}`}>
      
      <!-- MAPA DE RELACIONES CONECTIVAS (FLECHAS Y PATAS DE GALLO) -->
      {relations.length > 0 && (
        <div class="dm-relations-legend">
          <div class="dm-legend-title">
            <span>🔗</span> <strong>Mapa de Integridad Referencial (Foreign Keys & Cardinalidad)</strong>
          </div>
          <div class="dm-relations-grid">
            {relations.map((rel) => (
              <div class="dm-rel-card">
                <div class="dm-rel-head">
                  <span class={`dm-cardinality-tag ${rel.type === '1:1' ? 'is-1-1' : rel.type === 'N:M' ? 'is-nm' : 'is-1-n'}`}>
                    {rel.type === '1:1' ? '1 a 1 (1:1)' : rel.type === 'N:M' ? 'Muchos a Muchos (N:M)' : 'Uno a Muchos (1:N)'}
                  </span>
                  <span class="dm-rel-3fn">3FN</span>
                </div>

                <div class="dm-rel-diagram">
                  <!-- Lado Origen (Tabla Hija / FK) -->
                  <div class="dm-rel-node">
                    <span class="dm-node-table">{rel.fromTable}</span>
                    <span class="dm-node-field">F* {rel.fromField}</span>
                  </div>

                  <!-- Conector Data Modeler Crow's Foot & Flecha -->
                  <div class="dm-crows-foot-arrow">
                    <div class="dm-crows-symbol">
                      {rel.type === '1:1' ? (
                        <span class="dm-arrow-one" title="Exactamente Uno (1)">||</span>
                      ) : (
                        <span class="dm-crows-foot" title="Muchos (Pata de Gallo)">&gt;|</span>
                      )}
                    </div>
                    <div class="dm-connector-line">
                      <span class="dm-connector-badge">{rel.type}</span>
                    </div>
                    <div class="dm-arrow-head" title="Apunta a Clave Primaria (1)">
                      <span class="dm-arrow-point">►|</span>
                    </div>
                  </div>

                  <!-- Lado Destino (Tabla Padre / PK) -->
                  <div class="dm-rel-node dm-node-target">
                    <span class="dm-node-table">{rel.toTable}</span>
                    <span class="dm-node-field">P* {rel.toField}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- TABLAS CON ESTILO DATA MODELER -->
      <div class={`dm-tables-grid ${tables.length === 1 ? 'is-single' : tables.length === 2 ? 'is-double' : tables.length <= 5 ? 'is-medium' : 'is-macro'}`}>
        {tables.map((tbl) => {
          const pkFields = tbl.fields.filter(f => f.pk);
          const fkFields = tbl.fields.filter(f => f.fk);
          
          return (
            <div class={`dm-table-box ${pkFields.length > 1 ? 'is-junction' : ''}`} id={`dm-tbl-${tbl.name}`}>
              
              <!-- ENCABEZADO DE LA TABLA (Azul marino / Amarillo Data Modeler) -->
              <div class="dm-table-header">
                <span class="dm-table-title">{tbl.name}</span>
              </div>

              <!-- CUERPO DE COLUMNAS (P, F, PF, *, Tipo en verde) -->
              <div class="dm-table-columns">
                {tbl.fields.map((fld) => {
                  const isPk = fld.pk;
                  const isFk = !!fld.fk;
                  const isNotNull = fld.notNull || isPk;
                  
                  let prefix = '';
                  if (isPk && isFk) prefix = 'PF';
                  else if (isPk) prefix = 'P';
                  else if (isFk) prefix = 'F';

                  return (
                    <div class={`dm-col-row ${isPk ? 'is-pk-row' : isFk ? 'is-fk-row' : ''}`}>
                      <!-- Indicador de Clave (P, F, PF) -->
                      <div class="dm-col-prefix">
                        <span class="dm-key-type">{prefix}</span>
                        <span class={`dm-req-mark ${isNotNull ? 'is-mandatory' : 'is-optional'}`}>
                          {isNotNull ? '*' : 'o'}
                        </span>
                      </div>

                      <!-- Nombre de la Columna -->
                      <div class="dm-col-name" title={fld.desc || fld.name}>
                        <span>{fld.name}</span>
                      </div>

                      <!-- Tipo de Dato en Verde Data Modeler -->
                      <div class="dm-col-type">
                        <span>{fld.type}</span>
                      </div>
                    </div>
                  );
                })}
              </div>

              <!-- PIE DE RESTRICCIONES Y CLAVES (PK / FKs) -->
              <div class="dm-table-footer">
                {pkFields.length > 0 && (
                  <div class="dm-constraint-item dm-pk-constraint">
                    <span class="dm-cons-icon" title="Clave Primaria">🗝️</span>
                    <span class="dm-cons-text">{tbl.name}_PK ({pkFields.map(f => f.name).join(', ')})</span>
                  </div>
                )}
                {fkFields.map((fkFld) => (
                  <div class="dm-constraint-item dm-fk-constraint">
                    <span class="dm-cons-icon" title={`Clave Foránea hacia ${fkFld.fk}`}>🔗</span>
                    <span class="dm-cons-text">{tbl.name}_{fkFld.fk?.split('.')[0] || 'Ref'}_FK ({fkFld.name})</span>
                  </div>
                ))}
              </div>

            </div>
          );
        })}
      </div>

    </div>
  </div>
</div>

