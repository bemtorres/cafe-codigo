# ========================================================
# 🚀 SERVIDOR
# ========================================================
PORT=3001
NODE_ENV=development

# ========================================================
# 🐘 BASE DE DATOS POSTGRESQL (DATOS POR SEPARADO)
# ========================================================
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="password"
DB_NAME="cafeycodigo"
DB_SCHEMA="public"

# URL combinada (Requerida por el CLI de Prisma para ejecutar migraciones)
# Formato: postgresql://[DB_USER]:[DB_PASSWORD]@[DB_HOST]:[DB_PORT]/[DB_NAME]?schema=[DB_SCHEMA]
DATABASE_URL="postgresql://postgres:password@localhost:5432/cafeycodigo?schema=public"

# ========================================================
# 🔐 SEGURIDAD Y JWT
# ========================================================
JWT_SECRET="cafeycodigo-secret-token-key-2026-production"
JWT_EXPIRES_IN="7d"

# ========================================================
# 🌐 GOOGLE OAUTH 2.0
# ========================================================
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# ========================================================
# 💻 URL DEL FRONTEND (ASTRO)
# ========================================================
FRONTEND_URL="http://localhost:4321"

# ========================================================
# 📬 SERVIDOR DE CORREOS (SMTP)
# ========================================================
SMTP_HOST="smtp.tuservidor.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="tu-usuario-smtp@tudominio.com"
SMTP_PASS="tu-contraseña-smtp"
SMTP_FROM="\"Café y Código\" <no-reply@cafeycodigo.org>"
